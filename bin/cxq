#!/usr/bin/env bash
set -euo pipefail

CXQ_VERSION="0.2.2"
CXQ_REPO_SCHEMA_VERSION="2"
CXQ_DEFAULT_REMOTE_URL="https://github.com/daniel-aranda/Agents-todo.git"

die() {
  printf 'cxq: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
cxq - local Codex task queue

Usage:
  cxq -v | --version
  cxq version [--plain]
  cxq version bump patch|minor|major
  cxq version set X.Y.Z
  cxq help
  cxq doctor
  cxq install
  cxq update [--yes]
  cxq update --status|--check|--self|--repo|--all [--yes]
  cxq release prepare|tag|publish X.Y.Z
  cxq release X.Y.Z [--yes|--dry-run]
  cxq add <title> [options]
  cxq list [--all] [--status <status>]
  cxq next [--format text|id|md]
  cxq show <id>
  cxq claim <id> [--agent <name>] [--lease <duration>]
  cxq claim-next [--agent <name>] [--lease <duration>] [--format id|md|prompt]
  cxq block <id> --by <blocker-id>
  cxq deps <id>
  cxq unblock <id> --by <blocker-id>
  cxq note <id> <note>
  cxq prompt <id>
  cxq review <id> --summary <summary>
  cxq done <id> [--summary <summary>]
  cxq repo <id>
  cxq stale
  cxq release <id>

Add options:
  --priority <n>        Priority, default 50
  --status <status>    inbox, ready, claimed, blocked, review, done, wontfix
  --body <text>        Extra task body
  --files <paths>      Comma-separated allowed paths
  --tag <tag>          Add a tag. Can be repeated.
  --acceptance <text>  Acceptance criteria
  --verify <command>   Verification command

Examples:
  cxq install
  cxq update --status
  cxq add "Fix flaky auth refresh test" --priority 80 --files "src/auth,tests/auth"
  cxq block 42 --by 17
  cxq deps 42
  cxq next --format md
  cxq claim-next --agent codex --lease 2h --format prompt
EOF
}

version() {
  printf 'cxq %s\n' "$CXQ_VERSION"
}

cmd_version() {
  case "${1:-}" in
    "" )
      version
      ;;
    --plain)
      printf '%s\n' "$CXQ_VERSION"
      ;;
    bump)
      shift
      cmd_version_bump "$@"
      ;;
    set)
      shift
      cmd_version_set "$@"
      ;;
    *)
      die "unknown version option: $1"
      ;;
  esac
}

require_macos() {
  if [ "$(uname -s)" != "Darwin" ]; then
    die "cxq currently supports macOS only."
  fi
}

require_sqlite3() {
  command -v sqlite3 >/dev/null 2>&1 || die "sqlite3 is required but was not found."
}

trim() {
  local value=${1-}
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

sql_quote() {
  local value=${1-}
  value=${value//\'/\'\'}
  printf "'%s'" "$value"
}

json_escape() {
  local value=${1-}
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}
  value=${value//$'\r'/\\r}
  value=${value//$'\t'/\\t}
  printf '%s' "$value"
}

csv_to_json_array() {
  local input=${1-}
  local out="["
  local first=1
  local part value escaped
  local parts=()

  if [ -n "$input" ]; then
    IFS=',' read -r -a parts <<<"$input"
    for part in "${parts[@]}"; do
      value=$(trim "$part")
      if [ -n "$value" ]; then
        escaped=$(json_escape "$value")
        if [ "$first" -eq 0 ]; then
          out="${out},"
        fi
        out="${out}\"${escaped}\""
        first=0
      fi
    done
  fi

  out="${out}]"
  printf '%s' "$out"
}

status_is_valid() {
  case "${1-}" in
    inbox|ready|claimed|blocked|review|done|wontfix) return 0 ;;
    *) return 1 ;;
  esac
}

git_root() {
  git rev-parse --show-toplevel 2>/dev/null
}

physical_path() {
  (cd "$1" >/dev/null 2>&1 && pwd -P)
}

project_root_or_die() {
  local root
  root=$(git_root) || die "cxq only runs inside Git projects."
  physical_path "$root"
}

install_root_or_die() {
  local root current
  root=$(git_root) || {
    printf 'cxq install only runs at the root of a Git project.\n' >&2
    exit 1
  }
  root=$(physical_path "$root")
  current=$(pwd -P)
  if [ "$root" != "$current" ]; then
    printf 'cxq install only runs at the root of a Git project.\n' >&2
    exit 1
  fi
  printf '%s' "$root"
}

db_path_or_die() {
  local root db
  root=$(project_root_or_die)
  db="$root/.codex/tasks.db"
  [ -f "$db" ] || die "cxq is not installed in this project. Run 'cxq install' at the Git root."
  printf '%s' "$db"
}

schema_sql() {
  cat <<'EOF'
PRAGMA journal_mode = WAL;
PRAGMA foreign_keys = ON;

CREATE TABLE IF NOT EXISTS tasks (
  id INTEGER PRIMARY KEY AUTOINCREMENT,

  title TEXT NOT NULL,
  body TEXT NOT NULL DEFAULT '',

  status TEXT NOT NULL DEFAULT 'inbox'
    CHECK (status IN (
      'inbox',
      'ready',
      'claimed',
      'blocked',
      'review',
      'done',
      'wontfix'
    )),

  priority INTEGER NOT NULL DEFAULT 50,

  repo_path TEXT NOT NULL,
  branch TEXT,

  allowed_paths_json TEXT NOT NULL DEFAULT '[]',
  tags_json TEXT NOT NULL DEFAULT '[]',
  deps_json TEXT NOT NULL DEFAULT '[]',

  acceptance TEXT NOT NULL DEFAULT '',
  verify_command TEXT NOT NULL DEFAULT '',

  claimed_by TEXT,
  claimed_at TEXT,
  lease_until TEXT,

  result_summary TEXT NOT NULL DEFAULT '',
  transcript_path TEXT,

  created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
  updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
);

CREATE INDEX IF NOT EXISTS idx_tasks_status_priority
ON tasks(status, priority DESC, created_at ASC);

CREATE INDEX IF NOT EXISTS idx_tasks_repo_status
ON tasks(repo_path, status);

CREATE TABLE IF NOT EXISTS task_events (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  task_id INTEGER NOT NULL REFERENCES tasks(id) ON DELETE CASCADE,

  event_type TEXT NOT NULL,
  actor TEXT NOT NULL,
  note TEXT NOT NULL DEFAULT '',
  data_json TEXT NOT NULL DEFAULT '{}',

  created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
);

CREATE INDEX IF NOT EXISTS idx_task_events_task_created
ON task_events(task_id, created_at);

CREATE TABLE IF NOT EXISTS task_dependencies (
  task_id INTEGER NOT NULL REFERENCES tasks(id) ON DELETE CASCADE,
  blocker_task_id INTEGER NOT NULL REFERENCES tasks(id) ON DELETE CASCADE,
  created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
  PRIMARY KEY (task_id, blocker_task_id),
  CHECK (task_id <> blocker_task_id)
);

CREATE INDEX IF NOT EXISTS idx_task_dependencies_blocker
ON task_dependencies(blocker_task_id);

CREATE TABLE IF NOT EXISTS cxq_meta (
  key TEXT PRIMARY KEY,
  value TEXT NOT NULL
);

INSERT OR IGNORE INTO cxq_meta (key, value)
VALUES ('schema_version', '2');

UPDATE cxq_meta
SET value = '2'
WHERE key = 'schema_version'
  AND CAST(value AS INTEGER) < 2;

CREATE TRIGGER IF NOT EXISTS trg_tasks_updated_at
AFTER UPDATE ON tasks
FOR EACH ROW
BEGIN
  UPDATE tasks
  SET updated_at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now')
  WHERE id = OLD.id;
END;
EOF
}

prompt_template() {
  cat <<'EOF'
You are working on a local cxq task.

Use `cxq prompt <id>` to render the full current task prompt.
Use `cxq note <id> "..."` for important discoveries.
Move completed implementation work to `review`, not `done`, unless a human
explicitly asks you to mark it done.
EOF
}

agents_contract() {
  cat <<'EOF'

## Local task queue

This repo uses a local Codex task queue.

Use `cxq` to read and update tasks. Do not edit `.codex/tasks.db` directly.

Before starting queued work:

1. Claim exactly one task with `cxq claim-next --agent codex --lease 2h --format prompt`.
2. Work only on the claimed task.
3. Respect `allowed_paths` unless the task clearly requires more scope.
4. Run the task's `verify_command` when present.
5. Add notes with `cxq note <id> "..."`.
6. End by moving the task to `review`, with:
   - files changed
   - tests run
   - remaining risks
   - suggested next step

If `cxq` exits with update-required, run:
`cxq update --yes`
then retry the original command.

Tasks may depend on other tasks. Use `cxq deps <id>` to inspect blockers and
do not claim tasks whose blockers are not done.

Never mark a task `done` unless explicitly instructed.
EOF
}

sqlite_exec() {
  local db=$1
  local sql=$2
  sqlite3 -batch "$db" "$sql"
}

sqlite_value() {
  local db=$1
  local sql=$2
  sqlite3 -batch -noheader "$db" "$sql"
}

now_epoch() {
  if [ -n "${CXQ_NOW_EPOCH:-}" ]; then
    printf '%s' "$CXQ_NOW_EPOCH"
  else
    date +%s
  fi
}

format_epoch() {
  local epoch=${1-}
  if [[ "$epoch" =~ ^[0-9]+$ ]]; then
    if date -u -r "$epoch" '+%Y-%m-%dT%H:%M:%SZ' >/dev/null 2>&1; then
      date -u -r "$epoch" '+%Y-%m-%dT%H:%M:%SZ'
    else
      date -u -d "@$epoch" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || printf '%s' "$epoch"
    fi
  else
    printf '%s' "$epoch"
  fi
}

state_db_path() {
  printf '%s/.cxq/state.db' "$HOME"
}

init_state_db() {
  require_sqlite3
  local db
  db=$(state_db_path)
  mkdir -p "$(dirname "$db")"
  sqlite3 -batch "$db" "CREATE TABLE IF NOT EXISTS cxq_state (key TEXT PRIMARY KEY, value TEXT NOT NULL);"
}

state_get() {
  local key=$1
  local db
  init_state_db
  db=$(state_db_path)
  sqlite3 -batch -noheader "$db" "SELECT value FROM cxq_state WHERE key = $(sql_quote "$key");"
}

state_set() {
  local key=$1
  local value=${2-}
  local db
  init_state_db
  db=$(state_db_path)
  sqlite3 -batch "$db" "INSERT OR REPLACE INTO cxq_state (key, value) VALUES ($(sql_quote "$key"), $(sql_quote "$value"));"
}

mark_update_required() {
  local kind=$1
  local reason=$2
  local latest=${3-}
  state_set "update_required" "1"
  state_set "update_required_kind" "$kind"
  state_set "update_required_reason" "$reason"
  state_set "update_required_since" "$(now_epoch)"
  if [ -n "$latest" ]; then
    state_set "latest_version" "$latest"
  fi
}

clear_update_required() {
  state_set "update_required" "0"
  state_set "update_required_kind" ""
  state_set "update_required_reason" ""
  state_set "update_required_since" ""
}

clear_update_required_if_kind() {
  local kind=$1
  local current
  current=$(state_get "update_required_kind")
  if [ "$(state_get "update_required")" = "1" ] && [ "$current" = "$kind" ]; then
    clear_update_required
  fi
}

stable_semver() {
  local version=${1#v}
  if [[ "$version" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
    printf '%s' "$version"
    return 0
  fi
  return 1
}

semver_gt() {
  local left right
  left=$(stable_semver "$1") || return 1
  right=$(stable_semver "$2") || return 1

  local l_major l_minor l_patch r_major r_minor r_patch
  IFS=. read -r l_major l_minor l_patch <<<"$left"
  IFS=. read -r r_major r_minor r_patch <<<"$right"

  if [ "$((10#$l_major))" -gt "$((10#$r_major))" ]; then return 0; fi
  if [ "$((10#$l_major))" -lt "$((10#$r_major))" ]; then return 1; fi
  if [ "$((10#$l_minor))" -gt "$((10#$r_minor))" ]; then return 0; fi
  if [ "$((10#$l_minor))" -lt "$((10#$r_minor))" ]; then return 1; fi
  [ "$((10#$l_patch))" -gt "$((10#$r_patch))" ]
}

valid_project_version() {
  [[ "${1:-}" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-dev)?$ ]]
}

valid_stable_version() {
  [[ "${1:-}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]
}

source_repo_root_or_die() {
  local root
  root=$(git_root) || die "version and release commands must run inside the cxq source repo."
  root=$(physical_path "$root")
  [ -f "$root/bin/cxq" ] &&
    [ -f "$root/install.sh" ] &&
    [ -f "$root/tests/run_tests.sh" ] &&
    [ -f "$root/README.md" ] ||
    die "this command must run inside the cxq source repo."
  printf '%s' "$root"
}

repo_cxq_version() {
  local root=$1
  local line
  line=$(grep -E '^CXQ_VERSION="' "$root/bin/cxq" | head -n 1)
  line=${line#CXQ_VERSION=\"}
  line=${line%\"}
  printf '%s' "$line"
}

write_cxq_version() {
  local root=$1
  local new_version=$2
  local src="$root/bin/cxq"
  local tmp="$root/bin/cxq.tmp.$$"
  local changed=0 line

  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      CXQ_VERSION=\"*\")
        printf 'CXQ_VERSION="%s"\n' "$new_version" >>"$tmp"
        changed=1
        ;;
      *)
        printf '%s\n' "$line" >>"$tmp"
        ;;
    esac
  done <"$src"

  [ "$changed" -eq 1 ] || {
    rm -f "$tmp"
    die "CXQ_VERSION not found in bin/cxq."
  }
  chmod 0755 "$tmp"
  mv "$tmp" "$src"
}

bump_version_value() {
  local version=$1
  local part=$2
  local base major minor patch
  base=${version%-dev}
  IFS=. read -r major minor patch <<<"$base"
  case "$part" in
    patch) patch=$((10#$patch + 1)) ;;
    minor) minor=$((10#$minor + 1)); patch=0 ;;
    major) major=$((10#$major + 1)); minor=0; patch=0 ;;
    *) die "version bump must be patch, minor, or major." ;;
  esac
  printf '%s.%s.%s\n' "$major" "$minor" "$patch"
}

highest_stable_version_from_lsremote() {
  local lines=$1
  local line ref version highest=""

  while IFS= read -r line; do
    ref=${line##*refs/tags/}
    version=$(stable_semver "$ref" 2>/dev/null || true)
    if [ -z "$version" ]; then
      continue
    fi
    if [ -z "$highest" ] || semver_gt "$version" "$highest"; then
      highest=$version
    fi
  done <<<"$lines"

  if [ -n "$highest" ]; then
    printf 'v%s' "$highest"
  fi
}

update_remote_url() {
  local remote
  remote=$(state_get "install_remote_url")
  if [ -n "$remote" ]; then
    printf '%s' "$remote"
  else
    printf '%s' "$CXQ_DEFAULT_REMOTE_URL"
  fi
}

record_update_check_result() {
  local result=$1
  state_set "last_update_check_at" "$(now_epoch)"
  state_set "last_update_check_result" "$result"
}

run_remote_update_check() {
  local remote output status latest latest_stable reason
  remote=$(update_remote_url)

  if [ -n "${CXQ_TEST_LATEST_VERSION:-}" ]; then
    if [ "$CXQ_TEST_LATEST_VERSION" = "fail" ]; then
      record_update_check_result "failed: test remote failure"
      return 1
    fi
    latest_stable=$(stable_semver "$CXQ_TEST_LATEST_VERSION" 2>/dev/null || true)
    if [ -n "$latest_stable" ]; then
      latest="v$latest_stable"
    else
      latest=""
    fi
  else
    set +e
    output=$(GIT_TERMINAL_PROMPT=0 git ls-remote --tags --refs "$remote" "v*" 2>&1)
    status=$?
    set -e
    if [ "$status" -ne 0 ]; then
      record_update_check_result "failed: $output"
      return 1
    fi
    latest=$(highest_stable_version_from_lsremote "$output")
  fi

  if [ -z "$latest" ]; then
    state_set "latest_version" ""
    record_update_check_result "ok: no stable tags found"
    clear_update_required_if_kind "self"
    return 0
  fi

  state_set "latest_version" "$latest"
  if semver_gt "$latest" "$CXQ_VERSION"; then
    reason="cxq $latest is available; installed version is $CXQ_VERSION."
    mark_update_required "self" "$reason" "$latest"
    record_update_check_result "update-available: $latest"
    return 0
  fi

  record_update_check_result "up-to-date: $latest"
  clear_update_required_if_kind "self"
  return 0
}

remote_check_due() {
  local last now
  last=$(state_get "last_update_check_at")
  now=$(now_epoch)
  if ! [[ "$last" =~ ^[0-9]+$ ]]; then
    return 0
  fi
  [ "$((now - last))" -gt 86400 ]
}

log_event() {
  local db=$1
  local task_id=$2
  local event_type=$3
  local actor=$4
  local note=${5-}
  local data_json=${6:-{}}
  sqlite_exec "$db" "INSERT INTO task_events (task_id, event_type, actor, note, data_json) VALUES ($task_id, $(sql_quote "$event_type"), $(sql_quote "$actor"), $(sql_quote "$note"), $(sql_quote "$data_json"));"
}

append_gitignore() {
  local file=$1
  touch "$file"
  if ! grep -qxF ".codex/tasks.db" "$file"; then
    {
      printf '\n# cxq local queue\n'
      printf '.codex/tasks.db\n'
      printf '.codex/tasks.db-*\n'
    } >>"$file"
  elif ! grep -qxF ".codex/tasks.db-*" "$file"; then
    printf '.codex/tasks.db-*\n' >>"$file"
  fi
}

append_agents_contract() {
  local file=$1
  touch "$file"
  if ! grep -qxF "## Local task queue" "$file"; then
    agents_contract >>"$file"
  fi
}

write_file_if_missing() {
  local file=$1
  local label=$2
  local writer=$3

  if [ -f "$file" ]; then
    printf 'Left unchanged: %s\n' "$label"
    return
  fi

  "$writer" >"$file"
  printf 'Created: %s\n' "$label"
}

setup_project_queue() {
  local root=$1
  local codex_dir schema_file prompt_dir prompt_file db
  codex_dir="$root/.codex"
  schema_file="$codex_dir/tasks.schema.sql"
  prompt_dir="$codex_dir/prompts"
  prompt_file="$prompt_dir/task.md"
  db="$codex_dir/tasks.db"

  mkdir -p "$prompt_dir"
  write_file_if_missing "$schema_file" ".codex/tasks.schema.sql" schema_sql
  write_file_if_missing "$prompt_file" ".codex/prompts/task.md" prompt_template
  schema_sql | sqlite3 -batch "$db" >/dev/null
  append_gitignore "$root/.gitignore"
  append_agents_contract "$root/AGENTS.md"

  printf 'cxq installed for project: %s\n' "$root"
  printf 'Database: %s\n' "$db"
}

cmd_install() {
  require_macos
  require_sqlite3

  local root
  root=$(install_root_or_die)
  setup_project_queue "$root"
}

repo_update_reason() {
  local root=${1-}
  local db version reasons=""

  if [ -z "$root" ]; then
    root=$(git_root 2>/dev/null || true)
    [ -n "$root" ] || return 1
    root=$(physical_path "$root")
  fi

  db="$root/.codex/tasks.db"

  [ -f "$db" ] || reasons="${reasons}${reasons:+; }missing .codex/tasks.db"
  [ -f "$root/.codex/tasks.schema.sql" ] || reasons="${reasons}${reasons:+; }missing .codex/tasks.schema.sql"
  [ -f "$root/.codex/prompts/task.md" ] || reasons="${reasons}${reasons:+; }missing .codex/prompts/task.md"
  if [ ! -f "$root/AGENTS.md" ] || ! grep -qxF "## Local task queue" "$root/AGENTS.md"; then
    reasons="${reasons}${reasons:+; }missing AGENTS.md cxq block"
  fi

  if [ -f "$db" ]; then
    version=$(sqlite3 -batch -noheader "$db" "SELECT value FROM cxq_meta WHERE key = 'schema_version';" 2>/dev/null || true)
    if ! [[ "$version" =~ ^[0-9]+$ ]]; then
      version=0
    fi
    if [ "$version" -lt "$CXQ_REPO_SCHEMA_VERSION" ]; then
      reasons="${reasons}${reasons:+; }repo schema version $version is lower than $CXQ_REPO_SCHEMA_VERSION"
    fi
  fi

  if [ -n "$reasons" ]; then
    printf '%s' "$reasons"
    return 0
  fi
  return 1
}

detect_repo_update_required() {
  local root reason
  root=$(git_root 2>/dev/null || true)
  [ -n "$root" ] || return 0
  root=$(physical_path "$root")

  reason=$(repo_update_reason "$root" || true)
  if [ -n "$reason" ]; then
    if [ "$(state_get "update_required")" != "1" ]; then
      mark_update_required "repo" "Project queue update required: $reason"
    fi
  fi
}

current_actor() {
  printf '%s' "${USER:-unknown}"
}

current_branch() {
  local root=$1
  git -C "$root" rev-parse --abbrev-ref HEAD 2>/dev/null || true
}

cmd_add() {
  require_sqlite3

  local title="" body="" priority=50 status="ready" files="" tags="" acceptance="" verify=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --priority)
        [ "$#" -ge 2 ] || die "--priority requires a value."
        priority=$2
        shift 2
        ;;
      --status)
        [ "$#" -ge 2 ] || die "--status requires a value."
        status=$2
        shift 2
        ;;
      --body)
        [ "$#" -ge 2 ] || die "--body requires a value."
        body=$2
        shift 2
        ;;
      --files|--allowed-paths)
        [ "$#" -ge 2 ] || die "$1 requires a value."
        files=$2
        shift 2
        ;;
      --tag)
        [ "$#" -ge 2 ] || die "--tag requires a value."
        tags="${tags}${tags:+,}$2"
        shift 2
        ;;
      --acceptance)
        [ "$#" -ge 2 ] || die "--acceptance requires a value."
        acceptance=$2
        shift 2
        ;;
      --verify|--verify-command)
        [ "$#" -ge 2 ] || die "$1 requires a value."
        verify=$2
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      --*)
        die "unknown add option: $1"
        ;;
      *)
        if [ -z "$title" ]; then
          title=$1
        else
          body="${body}${body:+ }$1"
        fi
        shift
        ;;
    esac
  done

  [ -n "$title" ] || die "task title is required."
  [[ "$priority" =~ ^[0-9]+$ ]] || die "priority must be an integer."
  status_is_valid "$status" || die "invalid status: $status"

  local root db branch files_json tags_json id actor
  root=$(project_root_or_die)
  db=$(db_path_or_die)
  branch=$(current_branch "$root")
  files_json=$(csv_to_json_array "$files")
  tags_json=$(csv_to_json_array "$tags")
  actor=$(current_actor)

  id=$(sqlite_value "$db" "INSERT INTO tasks (title, body, status, priority, repo_path, branch, allowed_paths_json, tags_json, acceptance, verify_command) VALUES ($(sql_quote "$title"), $(sql_quote "$body"), $(sql_quote "$status"), $priority, $(sql_quote "$root"), $(sql_quote "$branch"), $(sql_quote "$files_json"), $(sql_quote "$tags_json"), $(sql_quote "$acceptance"), $(sql_quote "$verify")); SELECT last_insert_rowid();")
  log_event "$db" "$id" "created" "$actor" "$title"
  printf 'Created task #%s\n' "$id"
}

format_task_text() {
  local db=$1
  local id=$2
  sqlite3 -batch -header -column "$db" "SELECT id, status, priority, title, claimed_by, lease_until FROM tasks WHERE id = $id;"
}

print_json_array_md() {
  local db=$1
  local id=$2
  local column=$3
  local values
  values=$(sqlite3 -batch -noheader "$db" "SELECT '- ' || value FROM json_each((SELECT $column FROM tasks WHERE id = $id));" 2>/dev/null || true)
  if [ -n "$values" ]; then
    printf '%s\n' "$values"
  else
    printf 'None\n'
  fi
}

render_task_dependencies() {
  local db=$1
  local id=$2
  local blockers blocks

  blockers=$(sqlite3 -batch -noheader "$db" "SELECT '- #' || t.id || ' [' || t.status || '] ' || t.title FROM task_dependencies td JOIN tasks t ON t.id = td.blocker_task_id WHERE td.task_id = $id ORDER BY t.status <> 'done' DESC, t.priority DESC, t.id ASC;")
  blocks=$(sqlite3 -batch -noheader "$db" "SELECT '- #' || t.id || ' [' || t.status || '] ' || t.title FROM task_dependencies td JOIN tasks t ON t.id = td.task_id WHERE td.blocker_task_id = $id ORDER BY t.status <> 'done' DESC, t.priority DESC, t.id ASC;")

  printf '## Dependencies\n'
  printf 'Blocked by:\n'
  if [ -n "$blockers" ]; then
    printf '%s\n' "$blockers"
  else
    printf 'None\n'
  fi
  printf '\n'

  printf 'Blocks:\n'
  if [ -n "$blocks" ]; then
    printf '%s\n' "$blocks"
  else
    printf 'None\n'
  fi
  printf '\n'
}

render_task_core() {
  local db=$1
  local id=$2
  local title status priority body acceptance verify claimed_by claimed_at lease_until result_summary

  title=$(sqlite_value "$db" "SELECT title FROM tasks WHERE id = $id;")
  [ -n "$title" ] || die "task not found: $id"
  status=$(sqlite_value "$db" "SELECT status FROM tasks WHERE id = $id;")
  priority=$(sqlite_value "$db" "SELECT priority FROM tasks WHERE id = $id;")
  body=$(sqlite_value "$db" "SELECT body FROM tasks WHERE id = $id;")
  acceptance=$(sqlite_value "$db" "SELECT acceptance FROM tasks WHERE id = $id;")
  verify=$(sqlite_value "$db" "SELECT verify_command FROM tasks WHERE id = $id;")
  claimed_by=$(sqlite_value "$db" "SELECT COALESCE(claimed_by, '') FROM tasks WHERE id = $id;")
  claimed_at=$(sqlite_value "$db" "SELECT COALESCE(claimed_at, '') FROM tasks WHERE id = $id;")
  lease_until=$(sqlite_value "$db" "SELECT COALESCE(lease_until, '') FROM tasks WHERE id = $id;")
  result_summary=$(sqlite_value "$db" "SELECT result_summary FROM tasks WHERE id = $id;")

  printf '# Task #%s\n\n' "$id"
  printf '## Title\n%s\n\n' "$title"
  printf '## Status\n%s\n\n' "$status"
  printf '## Priority\n%s\n\n' "$priority"

  printf '## Body\n'
  if [ -n "$body" ]; then
    printf '%s\n' "$body"
  else
    printf 'None\n'
  fi
  printf '\n'

  printf '## Allowed paths\n'
  print_json_array_md "$db" "$id" "allowed_paths_json"
  printf '\n'

  printf '## Tags\n'
  print_json_array_md "$db" "$id" "tags_json"
  printf '\n'

  render_task_dependencies "$db" "$id"

  printf '## Acceptance criteria\n'
  if [ -n "$acceptance" ]; then
    printf '%s\n' "$acceptance"
  else
    printf 'None\n'
  fi
  printf '\n'

  printf '## Verification command\n'
  if [ -n "$verify" ]; then
    printf '%s\n' "$verify"
  else
    printf 'None\n'
  fi
  printf '\n'

  if [ -n "$claimed_by" ] || [ -n "$lease_until" ]; then
    printf '## Claim\n'
    [ -n "$claimed_by" ] && printf 'Claimed by: %s\n' "$claimed_by"
    [ -n "$claimed_at" ] && printf 'Claimed at: %s\n' "$claimed_at"
    [ -n "$lease_until" ] && printf 'Lease until: %s\n' "$lease_until"
    printf '\n'
  fi

  if [ -n "$result_summary" ]; then
    printf '## Result summary\n%s\n\n' "$result_summary"
  fi
}

render_task_events() {
  local db=$1
  local id=$2
  local events

  events=$(sqlite3 -batch -noheader "$db" "SELECT '- ' || created_at || ' \`' || event_type || '\` by ' || actor || CASE WHEN note <> '' THEN ': ' || replace(note, char(10), ' ') ELSE '' END FROM (SELECT id, created_at, event_type, actor, note FROM task_events WHERE task_id = $id ORDER BY created_at DESC, id DESC LIMIT 10) ORDER BY created_at ASC, id ASC;")

  printf '## Recent events\n'
  if [ -n "$events" ]; then
    printf '%s\n' "$events"
  else
    printf 'None\n'
  fi
  printf '\n'
}

render_agent_instructions() {
  local id=$1

  cat <<EOF
## Agent instructions
- Work only on this task.
- Respect allowed paths unless the implementation clearly requires more scope.
- Run the verification command when present.
- Use \`cxq note $id "..."\` for important discoveries.
- Move implementation work to \`review\`, not \`done\`:
  \`cxq review $id --summary "..."\`
EOF
}

render_task_md() {
  local db=$1
  local id=$2
  render_task_core "$db" "$id"
}

render_task_show() {
  local db=$1
  local id=$2
  render_task_core "$db" "$id"
  render_task_events "$db" "$id"
}

render_task_prompt() {
  local db=$1
  local id=$2

  printf 'You are working on local task #%s.\n\n' "$id"
  render_task_core "$db" "$id"
  render_task_events "$db" "$id"
  render_agent_instructions "$id"
}

task_exists() {
  local db=$1
  local id=$2
  local count
  count=$(sqlite_value "$db" "SELECT COUNT(*) FROM tasks WHERE id = $id;")
  [ "$count" = "1" ]
}

task_has_open_blockers() {
  local db=$1
  local id=$2
  local count
  count=$(sqlite_value "$db" "SELECT COUNT(*) FROM task_dependencies td JOIN tasks blocker ON blocker.id = td.blocker_task_id WHERE td.task_id = $id AND blocker.status <> 'done';")
  [ "$count" != "0" ]
}

dependency_would_cycle() {
  local db=$1
  local task_id=$2
  local blocker_id=$3
  local count
  count=$(sqlite_value "$db" "WITH RECURSIVE dependency_chain(id) AS (SELECT blocker_task_id FROM task_dependencies WHERE task_id = $blocker_id UNION SELECT td.blocker_task_id FROM task_dependencies td JOIN dependency_chain dc ON td.task_id = dc.id) SELECT COUNT(*) FROM dependency_chain WHERE id = $task_id;")
  [ "$count" != "0" ]
}

require_task_id() {
  local id=${1-}
  [[ "$id" =~ ^[0-9]+$ ]] || die "task id must be an integer."
}

cmd_list() {
  require_sqlite3

  local include_all=0 status=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --all)
        include_all=1
        shift
        ;;
      --status)
        [ "$#" -ge 2 ] || die "--status requires a value."
        status=$2
        status_is_valid "$status" || die "invalid status: $status"
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        die "unknown list option: $1"
        ;;
    esac
  done

  local db where
  db=$(db_path_or_die)
  if [ -n "$status" ]; then
    where="status = $(sql_quote "$status")"
  elif [ "$include_all" -eq 1 ]; then
    where="1 = 1"
  else
    where="status NOT IN ('done', 'wontfix')"
  fi

  sqlite3 -batch -header -column "$db" "SELECT id, status, priority, title, COALESCE(claimed_by, '') AS claimed_by, COALESCE(lease_until, '') AS lease_until FROM tasks WHERE $where ORDER BY CASE status WHEN 'ready' THEN 0 WHEN 'claimed' THEN 1 WHEN 'review' THEN 2 WHEN 'blocked' THEN 3 WHEN 'inbox' THEN 4 ELSE 5 END, priority DESC, created_at ASC;"
}

cmd_next() {
  require_sqlite3

  local format="text"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --format)
        [ "$#" -ge 2 ] || die "--format requires a value."
        format=$2
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        die "unknown next option: $1"
        ;;
    esac
  done

  case "$format" in
    text|id|md) ;;
    *) die "invalid format: $format" ;;
  esac

  local db id
  db=$(db_path_or_die)
  id=$(sqlite_value "$db" "SELECT id FROM tasks candidate WHERE status = 'ready' AND NOT EXISTS (SELECT 1 FROM task_dependencies td JOIN tasks blocker ON blocker.id = td.blocker_task_id WHERE td.task_id = candidate.id AND blocker.status <> 'done') ORDER BY priority DESC, created_at ASC LIMIT 1;")
  if [ -z "$id" ]; then
    printf 'No ready tasks.\n' >&2
    exit 1
  fi

  case "$format" in
    id) printf '%s\n' "$id" ;;
    md) render_task_md "$db" "$id" ;;
    text) format_task_text "$db" "$id" ;;
  esac
}

cmd_show() {
  require_sqlite3
  [ "$#" -eq 1 ] || die "usage: cxq show <id>"

  local id=$1 db
  require_task_id "$id"
  db=$(db_path_or_die)
  task_exists "$db" "$id" || die "task not found: $id"
  render_task_show "$db" "$id"
}

cmd_block() {
  require_sqlite3
  [ "$#" -ge 1 ] || die "usage: cxq block <id> --by <blocker-id>"

  local id=$1 blocker_id="" db actor changed
  require_task_id "$id"
  shift

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --by)
        [ "$#" -ge 2 ] || die "--by requires a task id."
        blocker_id=$2
        require_task_id "$blocker_id"
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        die "unknown block option: $1"
        ;;
    esac
  done

  [ -n "$blocker_id" ] || die "blocker task id is required."
  [ "$id" != "$blocker_id" ] || die "task cannot block itself."

  db=$(db_path_or_die)
  task_exists "$db" "$id" || die "task not found: $id"
  task_exists "$db" "$blocker_id" || die "blocker task not found: $blocker_id"
  if dependency_would_cycle "$db" "$id" "$blocker_id"; then
    die "dependency would create a cycle."
  fi

  changed=$(sqlite_value "$db" "INSERT OR IGNORE INTO task_dependencies (task_id, blocker_task_id) VALUES ($id, $blocker_id); SELECT changes();")
  actor=$(current_actor)
  if [ "$changed" = "1" ]; then
    log_event "$db" "$id" "blocked_by" "$actor" "blocked by #$blocker_id"
  fi
  printf 'Task #%s is blocked by #%s\n' "$id" "$blocker_id"
}

cmd_deps() {
  require_sqlite3
  [ "$#" -eq 1 ] || die "usage: cxq deps <id>"

  local id=$1 db
  require_task_id "$id"
  db=$(db_path_or_die)
  task_exists "$db" "$id" || die "task not found: $id"
  printf '# Dependencies for task #%s\n\n' "$id"
  render_task_dependencies "$db" "$id"
}

cmd_unblock() {
  require_sqlite3
  [ "$#" -ge 1 ] || die "usage: cxq unblock <id> --by <blocker-id>"

  local id=$1 blocker_id="" db actor changed
  require_task_id "$id"
  shift

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --by)
        [ "$#" -ge 2 ] || die "--by requires a task id."
        blocker_id=$2
        require_task_id "$blocker_id"
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        die "unknown unblock option: $1"
        ;;
    esac
  done

  [ -n "$blocker_id" ] || die "blocker task id is required."

  db=$(db_path_or_die)
  task_exists "$db" "$id" || die "task not found: $id"
  task_exists "$db" "$blocker_id" || die "blocker task not found: $blocker_id"
  changed=$(sqlite_value "$db" "DELETE FROM task_dependencies WHERE task_id = $id AND blocker_task_id = $blocker_id; SELECT changes();")
  if [ "$changed" = "0" ]; then
    die "task $id is not blocked by $blocker_id."
  fi
  actor=$(current_actor)
  log_event "$db" "$id" "unblocked_by" "$actor" "removed blocker #$blocker_id"
  printf 'Task #%s is no longer blocked by #%s\n' "$id" "$blocker_id"
}

lease_modifier() {
  local lease=${1:-2h}
  if [[ "$lease" =~ ^([0-9]+)m$ ]]; then
    printf '+%s minutes' "${BASH_REMATCH[1]}"
  elif [[ "$lease" =~ ^([0-9]+)h$ ]]; then
    printf '+%s hours' "${BASH_REMATCH[1]}"
  elif [[ "$lease" =~ ^([0-9]+)d$ ]]; then
    printf '+%s days' "${BASH_REMATCH[1]}"
  else
    die "lease must look like 30m, 2h, or 1d."
  fi
}

cmd_claim() {
  require_sqlite3
  [ "$#" -ge 1 ] || die "task id is required."

  local id=$1 agent="codex" lease="2h"
  require_task_id "$id"
  shift

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --agent)
        [ "$#" -ge 2 ] || die "--agent requires a value."
        agent=$2
        shift 2
        ;;
      --lease)
        [ "$#" -ge 2 ] || die "--lease requires a value."
        lease=$2
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        die "unknown claim option: $1"
        ;;
    esac
  done

  local db modifier changed
  db=$(db_path_or_die)
  task_exists "$db" "$id" || die "task not found: $id"
  modifier=$(lease_modifier "$lease")

  changed=$(sqlite_value "$db" "UPDATE tasks SET status = 'claimed', claimed_by = $(sql_quote "$agent"), claimed_at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now'), lease_until = strftime('%Y-%m-%dT%H:%M:%fZ', 'now', $(sql_quote "$modifier")) WHERE id = $id AND (status IN ('ready', 'inbox') OR (status = 'claimed' AND lease_until IS NOT NULL AND lease_until < strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))) AND NOT EXISTS (SELECT 1 FROM task_dependencies td JOIN tasks blocker ON blocker.id = td.blocker_task_id WHERE td.task_id = tasks.id AND blocker.status <> 'done'); SELECT changes();")
  if [ "$changed" = "0" ]; then
    die "task $id is not available to claim."
  fi

  log_event "$db" "$id" "claimed" "$agent" "lease $lease"
  printf 'Claimed task #%s as %s\n' "$id" "$agent"
}

cmd_claim_next() {
  require_sqlite3

  local agent="codex" lease="2h" format="id"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --agent)
        [ "$#" -ge 2 ] || die "--agent requires a value."
        agent=$2
        shift 2
        ;;
      --lease)
        [ "$#" -ge 2 ] || die "--lease requires a value."
        lease=$2
        shift 2
        ;;
      --format)
        [ "$#" -ge 2 ] || die "--format requires a value."
        format=$2
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        die "unknown claim-next option: $1"
        ;;
    esac
  done

  case "$format" in
    id|md|prompt) ;;
    *) die "invalid format: $format" ;;
  esac

  local db modifier id sql
  db=$(db_path_or_die)
  modifier=$(lease_modifier "$lease")
  sql="
BEGIN IMMEDIATE;
CREATE TEMP TABLE cxq_claim_next_selection (id INTEGER PRIMARY KEY);
INSERT INTO cxq_claim_next_selection (id)
SELECT id
FROM tasks candidate
WHERE (
    status = 'ready'
    OR (
    status = 'claimed'
    AND lease_until IS NOT NULL
    AND lease_until < strftime('%Y-%m-%dT%H:%M:%fZ', 'now')
   ))
  AND NOT EXISTS (
    SELECT 1
    FROM task_dependencies td
    JOIN tasks blocker ON blocker.id = td.blocker_task_id
    WHERE td.task_id = candidate.id
      AND blocker.status <> 'done'
  )
ORDER BY priority DESC, created_at ASC
LIMIT 1;
UPDATE tasks
SET status = 'claimed',
    claimed_by = $(sql_quote "$agent"),
    claimed_at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now'),
    lease_until = strftime('%Y-%m-%dT%H:%M:%fZ', 'now', $(sql_quote "$modifier"))
WHERE id IN (SELECT id FROM cxq_claim_next_selection);
INSERT INTO task_events (task_id, event_type, actor, note, data_json)
SELECT id, 'claimed', $(sql_quote "$agent"), $(sql_quote "lease $lease"), '{\"source\":\"claim-next\"}'
FROM cxq_claim_next_selection;
SELECT id FROM cxq_claim_next_selection;
COMMIT;
"
  id=$(sqlite3 -batch -noheader "$db" "$sql")
  if [ -z "$id" ]; then
    printf 'No available tasks.\n' >&2
    exit 1
  fi

  case "$format" in
    id) printf '%s\n' "$id" ;;
    md) render_task_show "$db" "$id" ;;
    prompt) render_task_prompt "$db" "$id" ;;
  esac
}

cmd_note() {
  require_sqlite3
  [ "$#" -ge 2 ] || die "usage: cxq note <id> <note>"

  local id=$1
  require_task_id "$id"
  shift

  local note="$*"
  local db actor
  db=$(db_path_or_die)
  task_exists "$db" "$id" || die "task not found: $id"
  actor=$(current_actor)
  log_event "$db" "$id" "note" "$actor" "$note"
  printf 'Noted task #%s\n' "$id"
}

cmd_prompt() {
  require_sqlite3
  [ "$#" -eq 1 ] || die "usage: cxq prompt <id>"

  local id=$1
  require_task_id "$id"

  local db
  db=$(db_path_or_die)
  task_exists "$db" "$id" || die "task not found: $id"
  render_task_prompt "$db" "$id"
}

cmd_review() {
  require_sqlite3
  [ "$#" -ge 1 ] || die "task id is required."

  local id=$1 summary=""
  require_task_id "$id"
  shift

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --summary)
        [ "$#" -ge 2 ] || die "--summary requires a value."
        summary=$2
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        summary="${summary}${summary:+ }$1"
        shift
        ;;
    esac
  done

  [ -n "$summary" ] || die "review summary is required."

  local db actor
  db=$(db_path_or_die)
  task_exists "$db" "$id" || die "task not found: $id"
  actor=$(current_actor)
  sqlite_exec "$db" "UPDATE tasks SET status = 'review', result_summary = $(sql_quote "$summary"), claimed_by = NULL, claimed_at = NULL, lease_until = NULL WHERE id = $id;"
  log_event "$db" "$id" "review" "$actor" "$summary"
  printf 'Moved task #%s to review\n' "$id"
}

cmd_done() {
  require_sqlite3
  [ "$#" -ge 1 ] || die "task id is required."

  local id=$1 summary=""
  require_task_id "$id"
  shift

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --summary)
        [ "$#" -ge 2 ] || die "--summary requires a value."
        summary=$2
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        summary="${summary}${summary:+ }$1"
        shift
        ;;
    esac
  done

  local db actor
  db=$(db_path_or_die)
  task_exists "$db" "$id" || die "task not found: $id"
  actor=$(current_actor)
  sqlite_exec "$db" "UPDATE tasks SET status = 'done', result_summary = CASE WHEN $(sql_quote "$summary") = '' THEN result_summary ELSE $(sql_quote "$summary") END, claimed_by = NULL, claimed_at = NULL, lease_until = NULL WHERE id = $id;"
  log_event "$db" "$id" "done" "$actor" "$summary"
  printf 'Marked task #%s done\n' "$id"
}

cmd_repo() {
  require_sqlite3
  [ "$#" -eq 1 ] || die "usage: cxq repo <id>"

  local id=$1 db repo
  require_task_id "$id"
  db=$(db_path_or_die)
  task_exists "$db" "$id" || die "task not found: $id"
  repo=$(sqlite_value "$db" "SELECT repo_path FROM tasks WHERE id = $id;")
  printf '%s\n' "$repo"
}

cmd_stale() {
  require_sqlite3
  local db
  db=$(db_path_or_die)
  sqlite3 -batch -header -column "$db" "SELECT id, status, priority, title, claimed_by, lease_until FROM tasks WHERE status = 'claimed' AND lease_until IS NOT NULL AND lease_until < strftime('%Y-%m-%dT%H:%M:%fZ', 'now') ORDER BY lease_until ASC;"
}

cmd_task_release() {
  require_sqlite3
  [ "$#" -eq 1 ] || die "usage: cxq release <id>"

  local id=$1 db actor changed
  require_task_id "$id"
  db=$(db_path_or_die)
  task_exists "$db" "$id" || die "task not found: $id"
  changed=$(sqlite_value "$db" "UPDATE tasks SET status = 'ready', claimed_by = NULL, claimed_at = NULL, lease_until = NULL WHERE id = $id AND status = 'claimed'; SELECT changes();")
  if [ "$changed" = "0" ]; then
    die "task $id is not claimed."
  fi
  actor=$(current_actor)
  log_event "$db" "$id" "released" "$actor" ""
  printf 'Released task #%s\n' "$id"
}

cmd_version_set() {
  [ "$#" -eq 1 ] || die "usage: cxq version set X.Y.Z"
  local new_version=$1
  valid_project_version "$new_version" || die "version must be stable SemVer X.Y.Z or X.Y.Z-dev."

  local root old_version
  root=$(source_repo_root_or_die)
  old_version=$(repo_cxq_version "$root")
  write_cxq_version "$root" "$new_version"

  printf 'Updated cxq version: %s -> %s\n' "$old_version" "$new_version"
  printf 'Changed:\n'
  printf '%s\n\n' '- bin/cxq'
  printf 'Next:\n'
  printf '  git add bin/cxq README.md tests/run_tests.sh\n'
  printf '  git commit -m "chore: bump cxq to %s"\n' "$new_version"
}

cmd_version_bump() {
  [ "$#" -eq 1 ] || die "usage: cxq version bump patch|minor|major"
  local part=$1
  local root old_version new_version
  root=$(source_repo_root_or_die)
  old_version=$(repo_cxq_version "$root")
  valid_project_version "$old_version" || die "current CXQ_VERSION is not a supported project version: $old_version"
  new_version=$(bump_version_value "$old_version" "$part")
  cmd_version_set "$new_version"
}

release_notes_path() {
  local version=$1
  printf '/tmp/cxq-release-v%s.md' "$version"
}

tag_exists_local() {
  git rev-parse -q --verify "refs/tags/v$1" >/dev/null
}

tag_exists_remote() {
  local version=$1
  local output
  output=$(GIT_TERMINAL_PROMPT=0 git ls-remote --tags --refs origin "v$version" 2>/dev/null || true)
  [ -n "$output" ]
}

release_verify_version() {
  local root=$1
  local version=$2
  valid_stable_version "$version" || die "release version must be stable SemVer X.Y.Z."
  [ "$(repo_cxq_version "$root")" = "$version" ] || die "CXQ_VERSION does not match requested release version $version."
}

release_warn_dirty() {
  if [ -n "$(git status --porcelain)" ]; then
    printf 'Warning: working tree has uncommitted changes.\n' >&2
  fi
}

release_check_tag_available() {
  local version=$1
  if tag_exists_local "$version"; then
    die "tag v$version already exists locally."
  fi
  if tag_exists_remote "$version"; then
    die "tag v$version already exists on origin."
  fi
}

release_verify_main_ready() {
  local branch upstream counts ahead behind

  branch=$(git branch --show-current)
  [ "$branch" = "main" ] || die "release tags must be created from main."

  upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)
  [ -n "$upstream" ] || die "main must track an upstream before release tagging."
  git rev-parse -q --verify "$upstream" >/dev/null || die "upstream $upstream is not available; fetch before releasing."

  counts=$(git rev-list --left-right --count HEAD..."$upstream")
  set -- $counts
  ahead=${1:-0}
  behind=${2:-0}

  if [ "$ahead" -gt 0 ] && [ "$behind" -gt 0 ]; then
    die "local main has diverged from $upstream; sync before releasing."
  fi
  if [ "$behind" -gt 0 ]; then
    die "local main is behind $upstream; pull before releasing."
  fi
  if [ "$ahead" -gt 0 ]; then
    die "local main has unpushed commits relative to $upstream; push before releasing."
  fi
}

release_run_tests() {
  local skip_tests=$1
  if [ "$skip_tests" -eq 1 ]; then
    printf 'Skipping tests.\n'
    return
  fi
  bash -n bin/cxq install.sh tests/run_tests.sh
  make test
}

release_prepare_notes() {
  local version=$1
  local notes
  notes=$(release_notes_path "$version")
  cat >"$notes" <<EOF
## cxq v$version

Release summary.

### Update

~~~sh
git pull --ff-only origin main
./install.sh
cxq version
cxq update --status
~~~

### Notes

- Add notes here before publishing.
EOF
  printf '%s' "$notes"
}

cmd_release_prepare() {
  local version=$1
  local skip_tests=${2:-0}
  local root notes
  root=$(source_repo_root_or_die)
  release_verify_version "$root" "$version"
  release_warn_dirty
  release_check_tag_available "$version"
  release_run_tests "$skip_tests"
  notes=$(release_prepare_notes "$version")
  printf 'Prepared release notes:\n'
  printf '  %s\n\n' "$notes"
  printf 'Next:\n'
  printf '  cxq release tag %s\n' "$version"
  printf '  cxq release publish %s\n' "$version"
}

cmd_release_tag() {
  local version=$1
  local skip_tests=${2:-0}
  local dry_run=${3:-0}
  local root
  root=$(source_repo_root_or_die)
  release_verify_version "$root" "$version"
  release_verify_main_ready
  release_check_tag_available "$version"
  release_run_tests "$skip_tests"

  if [ "$dry_run" -eq 1 ]; then
    printf 'Dry run: would create and push tag v%s.\n' "$version"
    return
  fi

  git tag -a "v$version" -m "cxq v$version"
  git push origin "v$version"
  printf 'Tagged and pushed v%s.\n' "$version"
  printf 'Next:\n'
  printf '  cxq release publish %s\n' "$version"
}

cmd_release_publish() {
  local version=$1
  local yes=${2:-0}
  local dry_run=${3:-0}
  local root notes
  root=$(source_repo_root_or_die)
  release_verify_version "$root" "$version"
  notes=$(release_notes_path "$version")

  if [ "$dry_run" -eq 1 ]; then
    printf 'Dry run: would publish GitHub release v%s.\n' "$version"
    return
  fi

  if [ "$yes" -ne 1 ] && ! gate_is_interactive; then
    die "non-interactive release publish requires --yes."
  fi
  command -v gh >/dev/null 2>&1 || die "gh is required to publish releases."
  git rev-parse -q --verify "refs/tags/v$version" >/dev/null || die "tag v$version does not exist locally."
  if [ ! -f "$notes" ]; then
    notes=$(release_prepare_notes "$version")
  fi
  gh release create "v$version" \
    --repo daniel-aranda/Agents-todo \
    --title "cxq v$version" \
    --notes-file "$notes" \
    --verify-tag \
    --latest
}

cmd_release_workflow() {
  local version=$1
  local yes=${2:-0}
  local skip_tests=${3:-0}
  local dry_run=${4:-0}

  if [ "$dry_run" -eq 1 ]; then
    source_repo_root_or_die >/dev/null
    release_verify_version "$(source_repo_root_or_die)" "$version"
    release_verify_main_ready
    release_check_tag_available "$version"
    printf 'Dry run: would prepare, tag, and publish cxq v%s.\n' "$version"
    return
  fi

  cmd_release_prepare "$version" "$skip_tests"
  cmd_release_tag "$version" 1 0
  if [ "$yes" -ne 1 ] && gate_is_interactive; then
    local answer
    printf 'Publish GitHub release now? [y/N] ' >&2
    answer=$(gate_read_answer)
    printf '\n' >&2
    case "$answer" in
      y|Y|yes|YES|Yes) ;;
      *) printf 'Release tag created. Publish later with: cxq release publish %s\n' "$version"; return 0 ;;
    esac
  elif [ "$yes" -ne 1 ]; then
    die "non-interactive full release requires --yes before publishing."
  fi
  cmd_release_publish "$version" 1 0
}

cmd_release() {
  if [ "$#" -eq 1 ] && [[ "$1" =~ ^[0-9]+$ ]]; then
    cmd_task_release "$@"
    return
  fi

  local action=${1:-}
  local version="" yes=0 skip_tests=0 dry_run=0
  case "$action" in
    prepare|tag|publish)
      shift
      version=${1:-}
      [ -n "$version" ] || die "release version is required."
      shift
      ;;
    "")
      die "usage: cxq release <id>|prepare|tag|publish X.Y.Z"
      ;;
    *)
      version=$action
      shift
      action="all"
      ;;
  esac

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --yes) yes=1; shift ;;
      --skip-tests) skip_tests=1; shift ;;
      --dry-run) dry_run=1; shift ;;
      *) die "unknown release option: $1" ;;
    esac
  done

  valid_stable_version "$version" || die "release version must be stable SemVer X.Y.Z."
  case "$action" in
    prepare) cmd_release_prepare "$version" "$skip_tests" ;;
    tag) cmd_release_tag "$version" "$skip_tests" "$dry_run" ;;
    publish) cmd_release_publish "$version" "$yes" "$dry_run" ;;
    all) cmd_release_workflow "$version" "$yes" "$skip_tests" "$dry_run" ;;
    *) die "unknown release action: $action" ;;
  esac
}

print_update_status() {
  init_state_db
  local latest last required kind reason result since
  latest=$(state_get "latest_version")
  last=$(state_get "last_update_check_at")
  required=$(state_get "update_required")
  kind=$(state_get "update_required_kind")
  reason=$(state_get "update_required_reason")
  result=$(state_get "last_update_check_result")
  since=$(state_get "update_required_since")

  printf 'current_version: %s\n' "$CXQ_VERSION"
  printf 'latest_known_version: %s\n' "${latest:-unknown}"
  if [ -n "$last" ]; then
    printf 'last_update_check_at: %s (%s)\n' "$last" "$(format_epoch "$last")"
  else
    printf 'last_update_check_at: never\n'
  fi
  printf 'update_required: %s\n' "${required:-0}"
  printf 'update_required_kind: %s\n' "${kind:-none}"
  printf 'update_required_reason: %s\n' "${reason:-none}"
  if [ -n "$since" ]; then
    printf 'update_required_since: %s (%s)\n' "$since" "$(format_epoch "$since")"
  fi
  printf 'last_update_check_result: %s\n' "${result:-none}"
}

current_executable_path() {
  local dir base found

  case "$0" in
    */*)
      dir=$(dirname "$0")
      base=$(basename "$0")
      dir=$(physical_path "$dir" 2>/dev/null || printf '%s' "$dir")
      printf '%s/%s' "$dir" "$base"
      ;;
    *)
      found=$(command -v "$0" 2>/dev/null || true)
      printf '%s' "${found:-$0}"
      ;;
  esac
}

cmd_doctor() {
  local selected running git_status sqlite_status
  local install_source install_bin install_remote required kind reason
  local root repo_reason queue_installed

  selected=$(command -v cxq 2>/dev/null || true)
  running=$(current_executable_path)

  if command -v git >/dev/null 2>&1; then
    git_status="ok ($(command -v git))"
  else
    git_status="missing"
  fi

  if command -v sqlite3 >/dev/null 2>&1; then
    sqlite_status="ok ($(command -v sqlite3))"
    init_state_db
    install_source=$(state_get "install_source_dir")
    install_bin=$(state_get "install_bin_path")
    install_remote=$(state_get "install_remote_url")
    required=$(state_get "update_required")
    kind=$(state_get "update_required_kind")
    reason=$(state_get "update_required_reason")
  else
    sqlite_status="missing"
    install_source=""
    install_bin=""
    install_remote=""
    required=""
    kind=""
    reason=""
  fi

  printf '# cxq doctor\n\n'
  printf 'current_version: %s\n' "$CXQ_VERSION"
  printf 'running_script: %s\n' "${running:-unknown}"
  printf 'selected_binary: %s\n' "${selected:-not found on PATH}"
  printf 'git: %s\n' "$git_status"
  printf 'sqlite3: %s\n' "$sqlite_status"
  printf 'install_source_dir: %s\n' "${install_source:-unknown}"
  printf 'install_bin_path: %s\n' "${install_bin:-unknown}"
  printf 'install_remote_url: %s\n' "${install_remote:-unknown}"
  printf 'update_required: %s\n' "${required:-0}"
  printf 'update_required_kind: %s\n' "${kind:-none}"
  printf 'update_required_reason: %s\n' "${reason:-none}"

  root=$(git_root 2>/dev/null || true)
  if [ -z "$root" ]; then
    printf 'git_repo: no\n'
    return 0
  fi

  root=$(physical_path "$root")
  printf 'git_repo: %s\n' "$root"

  if [ -f "$root/.codex/tasks.db" ]; then
    queue_installed="yes"
  else
    queue_installed="no"
  fi
  printf 'repo_queue_installed: %s\n' "$queue_installed"

  if command -v sqlite3 >/dev/null 2>&1; then
    repo_reason=$(repo_update_reason "$root" || true)
    if [ -n "$repo_reason" ]; then
      printf 'repo_update_required: yes\n'
      printf 'repo_update_reason: %s\n' "$repo_reason"
    else
      printf 'repo_update_required: no\n'
    fi
  else
    printf 'repo_update_required: unknown\n'
    printf 'repo_update_reason: sqlite3 missing\n'
  fi
}

cmd_update_check() {
  run_remote_update_check || true
  printf '%s\n' "$(state_get "last_update_check_result")"
  if [ "$(state_get "update_required")" = "1" ]; then
    printf 'Update required: %s\n' "$(state_get "update_required_reason")"
  else
    printf 'No update required.\n'
  fi
}

update_confirm_modify() {
  local what=$1
  local yes=$2

  if [ "$yes" -eq 1 ]; then
    return 0
  fi
  if gate_is_interactive; then
    local answer
    printf '%s [Y/n] ' "$what" >&2
    answer=$(gate_read_answer)
    printf '\n' >&2
    case "$answer" in
      ""|y|Y|yes|YES|Yes) return 0 ;;
      *) printf 'Update cancelled.\n' >&2; return 1 ;;
    esac
  fi
  printf '%s\n' "$what" >&2
  printf 'Run: cxq update --yes\n' >&2
  return 1
}

cmd_update_self() {
  local yes=${1:-0}
  local source_dir bin_path prefix latest
  source_dir=$(state_get "install_source_dir")
  bin_path=$(state_get "install_bin_path")
  latest=$(state_get "latest_version")

  if [ -z "$source_dir" ] || [ ! -d "$source_dir/.git" ] || [ ! -f "$source_dir/install.sh" ]; then
    printf 'cxq self-update cannot run automatically from this install.\n' >&2
    printf 'Clone or pull the cxq repository manually, then run ./install.sh.\n' >&2
    return 1
  fi

  update_confirm_modify "Update cxq now?" "$yes" || return 1
  printf 'Updating cxq...\n'
  if [ "${CXQ_TEST_SKIP_SELF_UPDATE_GIT:-}" != "1" ]; then
    GIT_TERMINAL_PROMPT=0 git -C "$source_dir" fetch --tags --quiet
    GIT_TERMINAL_PROMPT=0 git -C "$source_dir" pull --ff-only
  fi

  if [ -n "$bin_path" ]; then
    prefix=$(dirname "$(dirname "$bin_path")")
    PREFIX="$prefix" "$source_dir/install.sh"
  else
    "$source_dir/install.sh"
  fi

  state_set "update_required" "0"
  state_set "update_required_kind" ""
  state_set "update_required_reason" ""
  state_set "update_required_since" ""
  printf 'cxq is now up to date: %s\n' "${latest:-${CXQ_VERSION}}"
}

cmd_update_repo() {
  local yes=${1:-0}
  local root reason
  root=$(project_root_or_die)
  reason=$(repo_update_reason "$root" || true)
  if [ -z "$reason" ]; then
    printf 'Repo setup is up to date.\n'
    clear_update_required_if_kind "repo"
    return 0
  fi
  update_confirm_modify "Update repo setup now?" "$yes" || return 1
  setup_project_queue "$root"
  reason=$(repo_update_reason "$root" || true)
  if [ -n "$reason" ]; then
    mark_update_required "repo" "Project queue update required: $reason"
    printf 'Repo update is still required: %s\n' "$reason" >&2
    return 1
  fi
  clear_update_required_if_kind "repo"
  printf 'Repo setup is up to date.\n'
}

cmd_update_all() {
  local yes=${1:-0}
  local force_check=${2:-1}
  local kind repo_reason ran=0 latest
  detect_repo_update_required
  if [ "$(state_get "update_required_kind")" != "self" ] && { [ "$force_check" -eq 1 ] || remote_check_due; }; then
    run_remote_update_check || true
  fi
  kind=$(state_get "update_required_kind")
  latest=$(state_get "latest_version")
  repo_reason=$(repo_update_reason "$(git_root 2>/dev/null || true)" 2>/dev/null || true)

  if [ "$(state_get "update_required")" = "1" ] && [ "$kind" = "self" ]; then
    printf 'Update available: %s\n' "${latest:-unknown}"
    cmd_update_self "$yes"
    ran=1
  fi

  if [ -n "$repo_reason" ] || { [ "$(state_get "update_required")" = "1" ] && [ "$(state_get "update_required_kind")" = "repo" ]; }; then
    cmd_update_repo "$yes"
    ran=1
  fi

  if [ "$ran" -eq 0 ]; then
    printf 'cxq is up to date: %s\n' "$CXQ_VERSION"
  fi

  if [ "$(state_get "update_required")" = "1" ]; then
    printf 'Update is still required: %s\n' "$(state_get "update_required_reason")" >&2
    return 1
  fi
}

cmd_update() {
  require_sqlite3

  local action="" yes=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --status|--check|--self|--repo|--all)
        [ -z "$action" ] || die "choose only one update action."
        action=$1
        shift
        ;;
      --yes)
        yes=1
        shift
        ;;
      --help|-h)
        cat <<'EOF'
Usage:
  cxq update [--yes]
  cxq update --status
  cxq update --check
  cxq update --self [--yes]
  cxq update --repo [--yes]
  cxq update --all [--yes]
EOF
        exit 0
        ;;
      *)
        die "unknown update option: $1"
        ;;
    esac
  done

  case "${action:-}" in
    --status) print_update_status ;;
    --check) cmd_update_check ;;
    --self) cmd_update_self "$yes" ;;
    --repo) cmd_update_repo "$yes" ;;
    ""|--all) cmd_update_all "$yes" 1 ;;
    *) die "unknown update action: $action" ;;
  esac
}

command_uses_update_gate() {
  case "${1:-}" in
    add|list|ls|next|show|claim|claim-next|block|deps|unblock|note|prompt|review|done|repo|stale) return 0 ;;
    *) return 1 ;;
  esac
}

gate_is_interactive() {
  if [ -n "${CXQ_TEST_TTY_ANSWER:-}" ]; then
    return 0
  fi
  [ -t 0 ] && [ -t 2 ]
}

gate_read_answer() {
  if [ -n "${CXQ_TEST_TTY_ANSWER:-}" ]; then
    printf '%s' "$CXQ_TEST_TTY_ANSWER"
    return 0
  fi
  local answer
  IFS= read -r answer </dev/tty || answer=""
  printf '%s' "$answer"
}

run_update_and_rerun() {
  if ! CXQ_UPDATE_GATE_RERUN=1 "$0" update --yes; then
    printf 'Update failed. Command not run.\n' >&2
    return 1
  fi

  if [ "$(state_get "update_required")" = "1" ]; then
    printf '[update-required] cxq still needs an update before continuing.\n' >&2
    printf 'Run: cxq update --yes\n' >&2
    return 90
  fi

  CXQ_UPDATE_GATE_RERUN=1 exec "$0" "$@"
}

handle_update_required_gate() {
  local original_command="$*"
  local latest reason
  latest=$(state_get "latest_version")
  reason=$(state_get "update_required_reason")

  if [ "${CXQ_UPDATE_GATE_RERUN:-}" = "1" ]; then
    printf '[update-required] cxq needs an update before continuing.\n' >&2
    printf 'Run: cxq update --yes\n' >&2
    printf 'Then retry the original command.\n' >&2
    return 90
  fi

  if [ "${CXQ_ASSUME_YES:-}" = "1" ]; then
    run_update_and_rerun "$@"
    return $?
  fi

  if gate_is_interactive; then
    local answer
    {
      printf 'cxq update required.\n'
      printf 'Installed version: %s\n' "$CXQ_VERSION"
      [ -n "$latest" ] && printf 'Latest version: %s\n' "$latest"
      printf 'Reason: %s\n' "${reason:-update required}"
      printf 'Command: cxq %s\n' "$original_command"
      printf 'Run update now? [Y/n] '
    } >&2
    answer=$(gate_read_answer)
    printf '\n' >&2
    case "$answer" in
      ""|y|Y|yes|YES|Yes)
        run_update_and_rerun "$@"
        return $?
        ;;
      *)
        printf 'Command not run.\n' >&2
        printf 'Run: cxq update --yes\n' >&2
        return 1
        ;;
    esac
  fi

  printf '[update-required] cxq needs an update before continuing.\n' >&2
  printf 'Run: cxq update --yes\n' >&2
  printf 'Then retry the original command.\n' >&2
  return 90
}

run_update_gate() {
  [ "${CXQ_NO_UPDATE_CHECK:-}" = "1" ] && return 0

  init_state_db
  detect_repo_update_required

  if [ "$(state_get "update_required")" != "1" ]; then
    if remote_check_due; then
      run_remote_update_check || true
    fi
  fi

  if [ "$(state_get "update_required")" = "1" ]; then
    handle_update_required_gate "$@"
    return $?
  fi
}

main() {
  local command=${1:-help}
  if command_uses_update_gate "$command"; then
    run_update_gate "$@"
  fi

  case "$command" in
    -v|--version)
      version
      ;;
    version)
      shift
      cmd_version "$@"
      ;;
    --check)
      shift
      [ "$#" -eq 0 ] || die "--check does not accept arguments."
      cmd_update --check
      ;;
    --status)
      shift
      [ "$#" -eq 0 ] || die "--status does not accept arguments."
      cmd_update --status
      ;;
    help|-h|--help)
      usage
      ;;
    install)
      shift
      [ "$#" -eq 0 ] || die "install does not accept arguments."
      cmd_install
      ;;
    update)
      shift
      cmd_update "$@"
      ;;
    doctor)
      shift
      [ "$#" -eq 0 ] || die "doctor does not accept arguments."
      cmd_doctor
      ;;
    add)
      shift
      cmd_add "$@"
      ;;
    list|ls)
      shift
      cmd_list "$@"
      ;;
    next)
      shift
      cmd_next "$@"
      ;;
    show)
      shift
      cmd_show "$@"
      ;;
    claim)
      shift
      cmd_claim "$@"
      ;;
    claim-next)
      shift
      cmd_claim_next "$@"
      ;;
    block)
      shift
      cmd_block "$@"
      ;;
    deps)
      shift
      cmd_deps "$@"
      ;;
    unblock)
      shift
      cmd_unblock "$@"
      ;;
    note)
      shift
      cmd_note "$@"
      ;;
    prompt)
      shift
      cmd_prompt "$@"
      ;;
    review)
      shift
      cmd_review "$@"
      ;;
    done)
      shift
      cmd_done "$@"
      ;;
    repo)
      shift
      cmd_repo "$@"
      ;;
    stale)
      shift
      [ "$#" -eq 0 ] || die "stale does not accept arguments."
      cmd_stale
      ;;
    release)
      shift
      cmd_release "$@"
      ;;
    *)
      die "unknown command: $command"
      ;;
  esac
}

main "$@"
