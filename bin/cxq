#!/usr/bin/env bash
set -euo pipefail

CXQ_VERSION="0.5.0-dev"
CXQ_REPO_SCHEMA_VERSION="6"
CXQ_DEFAULT_REMOTE_URL="https://github.com/daniel-aranda/Agents-todo.git"
CXQ_SQLITE_BUSY_TIMEOUT_MS="${CXQ_SQLITE_BUSY_TIMEOUT_MS:-5000}"
CXQ_SQLITE_MAX_ATTEMPTS="${CXQ_SQLITE_MAX_ATTEMPTS:-5}"

die() {
  printf 'cxq: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
cxq - agent task queue

Usage:
  cxq -v | --version
  cxq version [--plain]
  cxq version bump patch|minor|major
  cxq version set X.Y.Z
  cxq help
  cxq doctor
  cxq install
  cxq update [--yes]
  cxq update --status|--check|--self|--repo|--all [--yes]
  cxq release prepare|tag|publish X.Y.Z
  cxq release X.Y.Z [--yes|--dry-run]
  cxq add <title> [options]
  cxq list [--all] [--status <status>] [--needs-action] [--questions]
  cxq due [--format json|table|md]
  cxq digest [--format json|table|md]
  cxq next [--format text|id|md]
  cxq show <id>
  cxq claim <id> [--agent <name>] [--lease <duration>]
  cxq claim-next [--agent <name>] [--lease <duration>] [--format id|md|prompt]
  cxq block <id> --by <blocker-id>
  cxq deps <id>
  cxq unblock <id> --by <blocker-id>
  cxq note <id> <note>
  cxq prompt <id>
  cxq review <id> --summary <summary>
  cxq reopen <id> [--to ready|inbox|blocked] --reason <reason>
  cxq followup <id> <title> [--close] [add options]
  cxq finding add <id> --severity <level> --note <note> [--followup <id>]
  cxq finding list <id>
  cxq finding resolve <finding-id> [--status accepted|resolved]
  cxq review-stale [--older-than 24h]
  cxq status-transitions
  cxq done <id> [--summary <summary>] [--force]
  cxq repo <id>
  cxq stale
  cxq release <id>
  cxq edit <id> [--title ...] [--priority ...] [--due YYYY-MM-DD] [--recurs daily|weekly|monthly|none] [--status ...]
  cxq undo <id>
  cxq delete <id> [--force] | cxq remove <id> [--force]
  cxq restore <id>
  cxq trash
  cxq trash purge [--days N] [--all]
  cxq board
  cxq stats
  cxq activity [--limit N]
  cxq export-md
  cxq export [--format json|csv]
  cxq watch [--interval 5s]
  cxq migrate
  cxq serve [--port 8080] [--host 127.0.0.1] [--db PATH] [--generate-token]
  cxq tokens list|add <agent>|revoke <agent>|rotate <agent> [--db PATH]
  cxq remote status

Add options:
  --priority <n>        Priority, default 50
  --status <status>    inbox, ready, claimed, blocked, review, done, wontfix, trashed
  --body <text>        Extra task body
  --files <paths>      Comma-separated allowed paths
  --tag <tag>          Add a tag. Can be repeated.
  --acceptance <text>  Acceptance criteria
  --verify <command>   Verification command
  --due <date>         Due date (YYYY-MM-DD)
  --recurs <interval>  Recur daily, weekly, or monthly when done (requires --due)

Examples:
  cxq install
  cxq update --status
  cxq add "Fix flaky auth refresh test" --priority 80 --files "src/auth,tests/auth"
  cxq block 42 --by 17
  cxq deps 42
  cxq next --format md
  cxq claim-next --lease 2h --format prompt
EOF
}

version() {
  printf 'cxq %s\n' "$CXQ_VERSION"
}

cmd_version() {
  case "${1:-}" in
    "" )
      version
      ;;
    --plain)
      printf '%s\n' "$CXQ_VERSION"
      ;;
    bump)
      shift
      cmd_version_bump "$@"
      ;;
    set)
      shift
      cmd_version_set "$@"
      ;;
    *)
      die "unknown version option: $1"
      ;;
  esac
}

require_macos() {
  require_supported_platform
}

require_supported_platform() {
  case "$(uname -s)" in
    Darwin|Linux) ;;
    *) die "cxq supports macOS and Linux only." ;;
  esac
}

require_sqlite3() {
  command -v sqlite3 >/dev/null 2>&1 || die "sqlite3 is required but was not found."
}

trim() {
  local value=${1-}
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

sql_quote() {
  local value=${1-}
  value=${value//\'/\'\'}
  printf "'%s'" "$value"
}

json_escape() {
  local value=${1-}
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}
  value=${value//$'\r'/\\r}
  value=${value//$'\t'/\\t}
  printf '%s' "$value"
}

# JSON-encode a string, or `null` when empty (for nullable columns).
json_string_or_null() {
  if [ -n "${1-}" ]; then
    printf '"%s"' "$(json_escape "$1")"
  else
    printf 'null'
  fi
}

csv_to_json_array() {
  local input=${1-}
  local out="["
  local first=1
  local part value escaped
  local parts=()

  if [ -n "$input" ]; then
    IFS=',' read -r -a parts <<<"$input"
    for part in "${parts[@]}"; do
      value=$(trim "$part")
      if [ -n "$value" ]; then
        escaped=$(json_escape "$value")
        if [ "$first" -eq 0 ]; then
          out="${out},"
        fi
        out="${out}\"${escaped}\""
        first=0
      fi
    done
  fi

  out="${out}]"
  printf '%s' "$out"
}

status_is_valid() {
  case "${1-}" in
    inbox|ready|claimed|blocked|review|done|wontfix|trashed) return 0 ;;
    *) return 1 ;;
  esac
}

git_root() {
  git rev-parse --show-toplevel 2>/dev/null
}

physical_path() {
  (cd "$1" >/dev/null 2>&1 && pwd -P)
}

project_root_or_die() {
  local root
  root=$(git_root) || die "cxq only runs inside Git projects."
  physical_path "$root"
}

install_root_or_die() {
  local root current
  root=$(git_root) || {
    printf 'cxq install only runs at the root of a Git project.\n' >&2
    exit 1
  }
  root=$(physical_path "$root")
  current=$(pwd -P)
  if [ "$root" != "$current" ]; then
    printf 'cxq install only runs at the root of a Git project.\n' >&2
    exit 1
  fi
  printf '%s' "$root"
}

# Queues created before v0.4.0 lived in .codex/. Move the queue to .cxq/
# on first use, preserving every task and event. Idempotent: a repo with
# only .cxq/ (or neither) is untouched. Only a genuine conflict — a
# database in BOTH directories, which might hold different tasks — is
# left alone with a warning; .cxq/ wins then. A half-moved queue (for
# example template files already in .cxq/ but the database still in
# .codex/) is finished by moving the missing files over.
migrate_legacy_queue_dir() {
  local root=$1 legacy new tmp f
  legacy="$root/.codex"
  new="$root/.cxq"
  if [ -d "$legacy" ] && [ ! -e "$new" ]; then
    mv "$legacy" "$new" || die "could not migrate $legacy to $new"
    migrate_gitignore_legacy "$root"
    printf 'cxq: migrated queue directory .codex -> .cxq\n' >&2
  elif [ -d "$legacy" ] && [ -e "$new" ]; then
    if [ -f "$legacy/tasks.db" ] && [ ! -f "$new/tasks.db" ]; then
      mv "$legacy/tasks.db" "$new/tasks.db" || die "could not migrate $legacy/tasks.db to $new/tasks.db"
      for f in tasks.db-wal tasks.db-shm tasks.schema.sql prompts/task.md; do
        if [ -f "$legacy/$f" ] && [ ! -f "$new/$f" ]; then
          mkdir -p "$(dirname "$new/$f")"
          mv "$legacy/$f" "$new/$f" || die "could not migrate $legacy/$f"
        fi
      done
      rmdir "$legacy/prompts" 2>/dev/null || true
      rmdir "$legacy" 2>/dev/null || true
      migrate_gitignore_legacy "$root"
      printf 'cxq: migrated queue database .codex -> .cxq\n' >&2
    else
      printf 'cxq: warning: both .codex and .cxq exist; using .cxq, stale .codex left untouched\n' >&2
    fi
  fi
}

migrate_gitignore_legacy() {
  local root=$1 tmp
  if [ -f "$root/.gitignore" ]; then
    tmp="$root/.gitignore.tmp.$$"
    sed 's|^\.codex/|.cxq/|' "$root/.gitignore" >"$tmp" && mv "$tmp" "$root/.gitignore"
  fi
}

db_path_or_die() {
  local root db
  root=$(project_root_or_die)
  migrate_legacy_queue_dir "$root"
  db="$root/.cxq/tasks.db"
  [ -f "$db" ] || die "cxq is not installed in this project. Run 'cxq install' at the Git root."
  migrate_db_if_needed "$db"
  printf '%s' "$db"
}

# Single source of truth for the tasks table definition. schema_sql()
# uses it (with IF NOT EXISTS) for fresh installs; migrate_db() uses it
# (without IF NOT EXISTS) when rebuilding a pre-v5 table, because SQLite
# cannot ALTER a CHECK constraint. Keep the emitted text byte-identical
# when editing: `cxq migrate` compares schema_sql() against the stock
# .cxq/tasks.schema.sql template.
tasks_table_sql() {
  cat <<'EOF'
CREATE TABLE tasks (
  id INTEGER PRIMARY KEY AUTOINCREMENT,

  title TEXT NOT NULL,
  body TEXT NOT NULL DEFAULT '',

  status TEXT NOT NULL DEFAULT 'inbox'
    CHECK (status IN (
      'inbox',
      'ready',
      'claimed',
      'blocked',
      'review',
      'done',
      'wontfix',
      'trashed'
    )),

  priority INTEGER NOT NULL DEFAULT 50,

  due_date TEXT,

  -- Recurrence interval for recurring tasks (daily|weekly|monthly).
  -- NULL means the task does not recur. A recurring task must have a
  -- due date: the next occurrence is advanced from the old due date
  -- when the task is marked done. Validated in code, not by CHECK, so
  -- older queues gain the column with a plain ALTER (see migrate_db).
  recurs TEXT,

  -- Trash bookkeeping: the status the task had before `cxq delete` moved
  -- it to 'trashed', and when it was trashed (purge age counts from this).
  trashed_from_status TEXT,
  trashed_at TEXT,

  repo_path TEXT NOT NULL,
  branch TEXT,

  allowed_paths_json TEXT NOT NULL DEFAULT '[]',
  tags_json TEXT NOT NULL DEFAULT '[]',
  deps_json TEXT NOT NULL DEFAULT '[]',

  acceptance TEXT NOT NULL DEFAULT '',
  verify_command TEXT NOT NULL DEFAULT '',

  claimed_by TEXT,
  claimed_at TEXT,
  lease_until TEXT,

  result_summary TEXT NOT NULL DEFAULT '',
  transcript_path TEXT,

  created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
  updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
);
EOF
}

schema_sql() {
  cat <<'EOF'
PRAGMA journal_mode = WAL;
PRAGMA foreign_keys = ON;

EOF
  tasks_table_sql | sed 's/^CREATE TABLE tasks (/CREATE TABLE IF NOT EXISTS tasks (/'
  cat <<'EOF'

CREATE INDEX IF NOT EXISTS idx_tasks_status_priority
ON tasks(status, priority DESC, created_at ASC);

CREATE INDEX IF NOT EXISTS idx_tasks_repo_status
ON tasks(repo_path, status);

CREATE INDEX IF NOT EXISTS idx_tasks_due
ON tasks(due_date);

CREATE TABLE IF NOT EXISTS task_events (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  task_id INTEGER NOT NULL REFERENCES tasks(id) ON DELETE CASCADE,

  event_type TEXT NOT NULL,
  actor TEXT NOT NULL,
  note TEXT NOT NULL DEFAULT '',
  data_json TEXT NOT NULL DEFAULT '{}',

  created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
);

CREATE INDEX IF NOT EXISTS idx_task_events_task_created
ON task_events(task_id, created_at);

CREATE TABLE IF NOT EXISTS task_dependencies (
  task_id INTEGER NOT NULL REFERENCES tasks(id) ON DELETE CASCADE,
  blocker_task_id INTEGER NOT NULL REFERENCES tasks(id) ON DELETE CASCADE,
  created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
  PRIMARY KEY (task_id, blocker_task_id),
  CHECK (task_id <> blocker_task_id)
);

CREATE INDEX IF NOT EXISTS idx_task_dependencies_blocker
ON task_dependencies(blocker_task_id);

CREATE TABLE IF NOT EXISTS task_findings (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  task_id INTEGER NOT NULL REFERENCES tasks(id) ON DELETE CASCADE,

  severity TEXT NOT NULL DEFAULT 'medium'
    CHECK (severity IN ('low', 'medium', 'high', 'critical')),

  status TEXT NOT NULL DEFAULT 'open'
    CHECK (status IN ('open', 'accepted', 'resolved')),

  note TEXT NOT NULL DEFAULT '',
  followup_task_id INTEGER REFERENCES tasks(id) ON DELETE SET NULL,

  created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
  updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
);

CREATE INDEX IF NOT EXISTS idx_task_findings_task_status
ON task_findings(task_id, status);

CREATE TABLE IF NOT EXISTS cxq_meta (
  key TEXT PRIMARY KEY,
  value TEXT NOT NULL
);

INSERT OR IGNORE INTO cxq_meta (key, value)
VALUES ('schema_version', '6');

UPDATE cxq_meta
SET value = '6'
WHERE key = 'schema_version'
  AND CAST(value AS INTEGER) < 6;

CREATE TRIGGER IF NOT EXISTS trg_tasks_updated_at
AFTER UPDATE ON tasks
FOR EACH ROW
BEGIN
  UPDATE tasks
  SET updated_at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now')
  WHERE id = OLD.id;
END;

CREATE TRIGGER IF NOT EXISTS trg_task_findings_updated_at
AFTER UPDATE ON task_findings
FOR EACH ROW
BEGIN
  UPDATE task_findings
  SET updated_at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now')
  WHERE id = OLD.id;
END;
EOF
}

prompt_template() {
  cat <<'EOF'
You are working on a local cxq task.

Use `cxq prompt <id>` to render the full current task prompt.
Use `cxq note <id> "..."` for important discoveries.
Move completed implementation work to `review`, not `done`, unless a human
explicitly asks you to mark it done.
EOF
}

agents_contract() {
  cat <<'EOF'

## Local task queue

This repo uses a local agent task queue.

Use `cxq` to read and update tasks. Do not edit `.cxq/tasks.db` directly.

Before starting queued work:

1. Claim exactly one task with `cxq claim-next --lease 2h --format prompt`.
2. Work only on the claimed task.
3. Respect `allowed_paths` unless the task clearly requires more scope.
4. Run the task's `verify_command` when present.
5. Add notes with `cxq note <id> "..."`.
6. End by moving the task to `review`, with:
   - files changed
   - tests run
   - remaining risks
   - suggested next step

If `cxq` exits with update-required, run:
`cxq update --yes`
then retry the original command.

Tasks may depend on other tasks. Use `cxq deps <id>` to inspect blockers and
do not claim tasks whose blockers are not done.

Prefix questions in notes with `DUDA:` or `BLOCKER:` so they show up in
`cxq list --questions`.

Record review caveats with `cxq finding add <id> --severity ... --note "..."`
instead of burying them in the summary.

A human sends work back with `cxq reopen <id> --reason "..."` and splits
leftover work with `cxq followup <id> "..."`. Run `cxq status-transitions` to
see which movements are supported.

Never mark a task `done` unless explicitly instructed.
EOF
}

sqlite_error_is_transient() {
  case "${1-}" in
    *"database is locked"*) return 0 ;;
    *"database table is locked"*) return 0 ;;
    *"database schema is locked"*) return 0 ;;
    *) return 1 ;;
  esac
}

sqlite_backoff() {
  local attempt=$1
  local seconds
  case "$attempt" in
    1) seconds="0.1" ;;
    2) seconds="0.25" ;;
    3) seconds="0.5" ;;
    *) seconds="1" ;;
  esac
  sleep "$seconds" 2>/dev/null || sleep 1
}

# Runs sqlite3 with a busy timeout and retries transient lock failures.
# Usage: sqlite_run <db> <sql> [extra sqlite3 flags...]
sqlite_run() {
  local db=$1
  local sql=$2
  shift 2

  local attempt=1 output status
  while :; do
    set +e
    output=$(sqlite3 -batch -cmd ".timeout $CXQ_SQLITE_BUSY_TIMEOUT_MS" "$@" "$db" "$sql" 2>&1)
    status=$?
    set -e

    if [ "$status" -eq 0 ]; then
      [ -n "$output" ] && printf '%s\n' "$output"
      return 0
    fi

    if [ "$attempt" -ge "$CXQ_SQLITE_MAX_ATTEMPTS" ] || ! sqlite_error_is_transient "$output"; then
      printf '%s\n' "$output" >&2
      return "$status"
    fi

    sqlite_backoff "$attempt"
    attempt=$((attempt + 1))
  done
}

sqlite_exec() {
  local db=$1
  local sql=$2
  sqlite_run "$db" "$sql"
}

sqlite_value() {
  local db=$1
  local sql=$2
  sqlite_run "$db" "$sql" -noheader
}

sqlite_query() {
  local db=$1
  local sql=$2
  sqlite_run "$db" "$sql" -noheader
}

sqlite_table() {
  local db=$1
  local sql=$2
  sqlite_run "$db" "$sql" -header -column
}

now_epoch() {
  if [ -n "${CXQ_NOW_EPOCH:-}" ]; then
    printf '%s' "$CXQ_NOW_EPOCH"
  else
    date +%s
  fi
}

format_epoch() {
  local epoch=${1-}
  if [[ "$epoch" =~ ^[0-9]+$ ]]; then
    if date -u -r "$epoch" '+%Y-%m-%dT%H:%M:%SZ' >/dev/null 2>&1; then
      date -u -r "$epoch" '+%Y-%m-%dT%H:%M:%SZ'
    else
      date -u -d "@$epoch" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || printf '%s' "$epoch"
    fi
  else
    printf '%s' "$epoch"
  fi
}

state_db_path() {
  printf '%s/.cxq/state.db' "$HOME"
}

init_state_db() {
  require_sqlite3
  local db
  db=$(state_db_path)
  mkdir -p "$(dirname "$db")"
  sqlite_run "$db" "PRAGMA journal_mode = WAL; CREATE TABLE IF NOT EXISTS cxq_state (key TEXT PRIMARY KEY, value TEXT NOT NULL);" >/dev/null
}

state_get() {
  local key=$1
  local db
  init_state_db
  db=$(state_db_path)
  sqlite_query "$db" "SELECT value FROM cxq_state WHERE key = $(sql_quote "$key");"
}

state_set() {
  local key=$1
  local value=${2-}
  local db
  init_state_db
  db=$(state_db_path)
  sqlite_run "$db" "INSERT OR REPLACE INTO cxq_state (key, value) VALUES ($(sql_quote "$key"), $(sql_quote "$value"));" >/dev/null
}

mark_update_required() {
  local kind=$1
  local reason=$2
  local latest=${3-}
  state_set "update_required" "1"
  state_set "update_required_kind" "$kind"
  state_set "update_required_reason" "$reason"
  state_set "update_required_since" "$(now_epoch)"
  if [ -n "$latest" ]; then
    state_set "latest_version" "$latest"
  fi
}

clear_update_required() {
  state_set "update_required" "0"
  state_set "update_required_kind" ""
  state_set "update_required_reason" ""
  state_set "update_required_since" ""
}

clear_update_required_if_kind() {
  local kind=$1
  local current
  current=$(state_get "update_required_kind")
  if [ "$(state_get "update_required")" = "1" ] && [ "$current" = "$kind" ]; then
    clear_update_required
  fi
}

stable_semver() {
  local version=${1#v}
  if [[ "$version" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
    printf '%s' "$version"
    return 0
  fi
  return 1
}

# Splits a project version into "major minor patch rank".
# rank 0 means an unreleased X.Y.Z-dev build, rank 1 means the stable X.Y.Z.
# A dev build always sorts below the stable release it is working towards.
version_parts() {
  local version=${1#v}
  local rank=1
  case "$version" in
    *-dev) version=${version%-dev}; rank=0 ;;
  esac
  if [[ "$version" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
    printf '%s %s %s %s' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "$rank"
    return 0
  fi
  return 1
}

version_is_dev() {
  case "${1:-}" in
    *-dev) return 0 ;;
    *) return 1 ;;
  esac
}

# True when the left version is strictly greater than the right version.
# Both sides accept X.Y.Z and X.Y.Z-dev.
semver_gt() {
  local left right
  left=$(version_parts "$1") || return 1
  right=$(version_parts "$2") || return 1

  local l_major l_minor l_patch l_rank r_major r_minor r_patch r_rank
  read -r l_major l_minor l_patch l_rank <<<"$left"
  read -r r_major r_minor r_patch r_rank <<<"$right"

  if [ "$((10#$l_major))" -gt "$((10#$r_major))" ]; then return 0; fi
  if [ "$((10#$l_major))" -lt "$((10#$r_major))" ]; then return 1; fi
  if [ "$((10#$l_minor))" -gt "$((10#$r_minor))" ]; then return 0; fi
  if [ "$((10#$l_minor))" -lt "$((10#$r_minor))" ]; then return 1; fi
  if [ "$((10#$l_patch))" -gt "$((10#$r_patch))" ]; then return 0; fi
  if [ "$((10#$l_patch))" -lt "$((10#$r_patch))" ]; then return 1; fi
  [ "$l_rank" -gt "$r_rank" ]
}

valid_project_version() {
  [[ "${1:-}" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-dev)?$ ]]
}

valid_stable_version() {
  [[ "${1:-}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]
}

source_repo_root_or_die() {
  local root
  root=$(git_root) || die "version and release commands must run inside the cxq source repo."
  root=$(physical_path "$root")
  # A && ... || die is intentional here:
  # shellcheck disable=SC2015
  # die must run if ANY of the four files is missing.
  [ -f "$root/bin/cxq" ] &&
    [ -f "$root/install.sh" ] &&
    [ -f "$root/tests/run_tests.sh" ] &&
    [ -f "$root/README.md" ] ||
    die "this command must run inside the cxq source repo."
  printf '%s' "$root"
}

repo_cxq_version() {
  local root=$1
  local line
  line=$(grep -E '^CXQ_VERSION="' "$root/bin/cxq" | head -n 1)
  line=${line#CXQ_VERSION=\"}
  line=${line%\"}
  printf '%s' "$line"
}

write_cxq_version() {
  local root=$1
  local new_version=$2
  local src="$root/bin/cxq"
  local tmp="$root/bin/cxq.tmp.$$"
  local changed=0 line

  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      CXQ_VERSION=\"*\")
        printf 'CXQ_VERSION="%s"\n' "$new_version" >>"$tmp"
        changed=1
        ;;
      *)
        printf '%s\n' "$line" >>"$tmp"
        ;;
    esac
  done <"$src"

  [ "$changed" -eq 1 ] || {
    rm -f "$tmp"
    die "CXQ_VERSION not found in bin/cxq."
  }
  chmod 0755 "$tmp"
  mv "$tmp" "$src"
}

bump_version_value() {
  local version=$1
  local part=$2
  local base major minor patch
  base=${version%-dev}
  IFS=. read -r major minor patch <<<"$base"
  case "$part" in
    patch) patch=$((10#$patch + 1)) ;;
    minor) minor=$((10#$minor + 1)); patch=0 ;;
    major) major=$((10#$major + 1)); minor=0; patch=0 ;;
    *) die "version bump must be patch, minor, or major." ;;
  esac
  printf '%s.%s.%s\n' "$major" "$minor" "$patch"
}

highest_stable_version_from_lsremote() {
  local lines=$1
  local line ref version highest=""

  while IFS= read -r line; do
    ref=${line##*refs/tags/}
    version=$(stable_semver "$ref" 2>/dev/null || true)
    if [ -z "$version" ]; then
      continue
    fi
    if [ -z "$highest" ] || semver_gt "$version" "$highest"; then
      highest=$version
    fi
  done <<<"$lines"

  if [ -n "$highest" ]; then
    printf 'v%s' "$highest"
  fi
}

update_remote_url() {
  local remote
  remote=$(state_get "install_remote_url")
  if [ -n "$remote" ]; then
    printf '%s' "$remote"
  else
    printf '%s' "$CXQ_DEFAULT_REMOTE_URL"
  fi
}

record_update_check_result() {
  local result=$1
  state_set "last_update_check_at" "$(now_epoch)"
  state_set "last_update_check_result" "$result"
}

run_remote_update_check() {
  local remote output status latest latest_stable reason
  remote=$(update_remote_url)

  if [ -n "${CXQ_TEST_LATEST_VERSION:-}" ]; then
    if [ "$CXQ_TEST_LATEST_VERSION" = "fail" ]; then
      record_update_check_result "failed: test remote failure"
      return 1
    fi
    latest_stable=$(stable_semver "$CXQ_TEST_LATEST_VERSION" 2>/dev/null || true)
    if [ -n "$latest_stable" ]; then
      latest="v$latest_stable"
    else
      latest=""
    fi
  else
    set +e
    output=$(GIT_TERMINAL_PROMPT=0 git ls-remote --tags --refs "$remote" "v*" 2>&1)
    status=$?
    set -e
    if [ "$status" -ne 0 ]; then
      record_update_check_result "failed: $output"
      return 1
    fi
    latest=$(highest_stable_version_from_lsremote "$output")
  fi

  if [ -z "$latest" ]; then
    state_set "latest_version" ""
    record_update_check_result "ok: no stable tags found"
    clear_update_required_if_kind "self"
    return 0
  fi

  state_set "latest_version" "$latest"
  if semver_gt "$latest" "$CXQ_VERSION"; then
    reason="cxq $latest is available; installed version is $CXQ_VERSION."
    mark_update_required "self" "$reason" "$latest"
    record_update_check_result "update-available: $latest"
    return 0
  fi

  if version_is_dev "$CXQ_VERSION"; then
    record_update_check_result "dev-build: $CXQ_VERSION is ahead of latest stable $latest"
  else
    record_update_check_result "up-to-date: $latest"
  fi
  clear_update_required_if_kind "self"
  return 0
}

remote_check_due() {
  local last now
  last=$(state_get "last_update_check_at")
  now=$(now_epoch)
  if ! [[ "$last" =~ ^[0-9]+$ ]]; then
    return 0
  fi
  [ "$((now - last))" -gt 86400 ]
}

log_event() {
  local db=$1
  local task_id=$2
  local event_type=$3
  local actor=$4
  local note=${5-}
  local data_json=${6:-'{}'}
  sqlite_exec "$db" "INSERT INTO task_events (task_id, event_type, actor, note, data_json) VALUES ($task_id, $(sql_quote "$event_type"), $(sql_quote "$actor"), $(sql_quote "$note"), $(sql_quote "$data_json"));"
}

append_gitignore() {
  local file=$1
  touch "$file"
  if ! grep -qxF ".cxq/tasks.db" "$file"; then
    {
      printf '\n# cxq local queue\n'
      printf '.cxq/tasks.db\n'
      printf '.cxq/tasks.db-*\n'
    } >>"$file"
  elif ! grep -qxF ".cxq/tasks.db-*" "$file"; then
    printf '.cxq/tasks.db-*\n' >>"$file"
  fi
}

append_agents_contract() {
  local file=$1
  touch "$file"
  if ! grep -qxF "## Local task queue" "$file"; then
    agents_contract >>"$file"
  fi
}

write_file_if_missing() {
  local file=$1
  local label=$2
  local writer=$3

  if [ -f "$file" ]; then
    printf 'Left unchanged: %s\n' "$label"
    return
  fi

  "$writer" >"$file"
  printf 'Created: %s\n' "$label"
}

setup_project_queue() {
  local root=$1
  local queue_dir schema_file prompt_dir prompt_file db
  migrate_legacy_queue_dir "$root"
  queue_dir="$root/.cxq"
  schema_file="$queue_dir/tasks.schema.sql"
  prompt_dir="$queue_dir/prompts"
  prompt_file="$prompt_dir/task.md"
  db="$queue_dir/tasks.db"

  mkdir -p "$prompt_dir"
  write_file_if_missing "$schema_file" ".cxq/tasks.schema.sql" schema_sql
  write_file_if_missing "$prompt_file" ".cxq/prompts/task.md" prompt_template
  sqlite_run "$db" "$(schema_sql)" >/dev/null
  append_gitignore "$root/.gitignore"
  append_agents_contract "$root/AGENTS.md"

  printf 'cxq installed for project: %s\n' "$root"
  printf 'Database: %s\n' "$db"
}

cmd_install() {
  require_macos
  require_sqlite3

  local root
  root=$(install_root_or_die)
  setup_project_queue "$root"
}

repo_update_reason() {
  local root=${1-}
  local db version reasons=""

  if [ -z "$root" ]; then
    root=$(git_root 2>/dev/null || true)
    [ -n "$root" ] || return 1
    root=$(physical_path "$root")
  fi

  migrate_legacy_queue_dir "$root"
  db="$root/.cxq/tasks.db"

  [ -f "$db" ] || reasons="${reasons}${reasons:+; }missing .cxq/tasks.db"
  [ -f "$root/.cxq/tasks.schema.sql" ] || reasons="${reasons}${reasons:+; }missing .cxq/tasks.schema.sql"
  [ -f "$root/.cxq/prompts/task.md" ] || reasons="${reasons}${reasons:+; }missing .cxq/prompts/task.md"
  if [ ! -f "$root/AGENTS.md" ] || ! grep -qxF "## Local task queue" "$root/AGENTS.md"; then
    reasons="${reasons}${reasons:+; }missing AGENTS.md cxq block"
  fi

  if [ -f "$db" ]; then
    version=$(sqlite_query "$db" "SELECT value FROM cxq_meta WHERE key = 'schema_version';" 2>/dev/null || true)
    if ! [[ "$version" =~ ^[0-9]+$ ]]; then
      version=0
    fi
    if [ "$version" -lt 3 ]; then
      reasons="${reasons}${reasons:+; }repo schema version $version is lower than 3 (too old to auto-migrate)"
    fi
  fi

  if [ -n "$reasons" ]; then
    printf '%s' "$reasons"
    return 0
  fi
  return 1
}

detect_repo_update_required() {
  local root reason
  root=$(git_root 2>/dev/null || true)
  [ -n "$root" ] || return 0
  root=$(physical_path "$root")

  reason=$(repo_update_reason "$root" || true)
  if [ -n "$reason" ]; then
    if [ "$(state_get "update_required")" != "1" ]; then
      mark_update_required "repo" "Project queue update required: $reason"
    fi
  fi
}

current_actor() {
  printf '%s' "${USER:-unknown}"
}

current_branch() {
  local root=$1
  git -C "$root" rev-parse --abbrev-ref HEAD 2>/dev/null || true
}

cmd_add() {
  require_sqlite3

  local title="" body="" priority=50 status="ready" files="" tags="" acceptance="" verify="" due="" recurs=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --due)
        [ "$#" -ge 2 ] || die "--due requires a value."
        due=$2
        shift 2
        ;;
      --recurs)
        [ "$#" -ge 2 ] || die "--recurs requires a value."
        recurs=$2
        shift 2
        ;;
      --priority)
        [ "$#" -ge 2 ] || die "--priority requires a value."
        priority=$2
        shift 2
        ;;
      --status)
        [ "$#" -ge 2 ] || die "--status requires a value."
        status=$2
        shift 2
        ;;
      --body)
        [ "$#" -ge 2 ] || die "--body requires a value."
        body=$2
        shift 2
        ;;
      --files|--allowed-paths)
        [ "$#" -ge 2 ] || die "$1 requires a value."
        files=$2
        shift 2
        ;;
      --tag)
        [ "$#" -ge 2 ] || die "--tag requires a value."
        tags="${tags}${tags:+,}$2"
        shift 2
        ;;
      --acceptance)
        [ "$#" -ge 2 ] || die "--acceptance requires a value."
        acceptance=$2
        shift 2
        ;;
      --verify|--verify-command)
        [ "$#" -ge 2 ] || die "$1 requires a value."
        verify=$2
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      --*)
        die "unknown add option: $1"
        ;;
      *)
        if [ -z "$title" ]; then
          title=$1
        else
          body="${body}${body:+ }$1"
        fi
        shift
        ;;
    esac
  done

  [ -n "$title" ] || die "task title is required."
  [[ "$priority" =~ ^[0-9]+$ ]] || die "priority must be an integer."
  status_is_valid "$status" || die "invalid status: $status"
  [ "$status" != "trashed" ] || die "cannot create a task with status 'trashed'."
  if [ -n "$due" ]; then
    valid_due_date "$due" || die "due date must be a valid YYYY-MM-DD date."
  fi
  if [ -n "$recurs" ]; then
    valid_recurs "$recurs" || die "invalid recurrence: $recurs (expected daily, weekly, or monthly)."
    [ -n "$due" ] || die "recurring tasks require a due date (--due YYYY-MM-DD)."
  fi

  local root db branch files_json tags_json id actor due_sql recurs_sql
  root=$(project_root_or_die)
  db=$(db_path_or_die)
  branch=$(current_branch "$root")
  files_json=$(csv_to_json_array "$files")
  tags_json=$(csv_to_json_array "$tags")
  actor=$(current_actor)
  due_sql="NULL"
  [ -n "$due" ] && due_sql=$(sql_quote "$due")
  recurs_sql="NULL"
  [ -n "$recurs" ] && recurs_sql=$(sql_quote "$recurs")

  id=$(sqlite_value "$db" "INSERT INTO tasks (title, body, status, priority, due_date, recurs, repo_path, branch, allowed_paths_json, tags_json, acceptance, verify_command) VALUES ($(sql_quote "$title"), $(sql_quote "$body"), $(sql_quote "$status"), $priority, $due_sql, $recurs_sql, $(sql_quote "$root"), $(sql_quote "$branch"), $(sql_quote "$files_json"), $(sql_quote "$tags_json"), $(sql_quote "$acceptance"), $(sql_quote "$verify")); SELECT last_insert_rowid();")
  log_event "$db" "$id" "created" "$actor" "$title"
  printf 'Created task #%s\n' "$id"
}

format_task_text() {
  local db=$1
  local id=$2
  sqlite_table "$db" "SELECT id, status, priority, title, claimed_by, lease_until FROM tasks WHERE id = $id;"
}

print_json_array_md() {
  local db=$1
  local id=$2
  local column=$3
  local values
  values=$(sqlite_query "$db" "SELECT '- ' || value FROM json_each((SELECT $column FROM tasks WHERE id = $id));" 2>/dev/null || true)
  if [ -n "$values" ]; then
    printf '%s\n' "$values"
  else
    printf 'None\n'
  fi
}

render_task_dependencies() {
  local db=$1
  local id=$2
  local blockers blocks

  blockers=$(sqlite_query "$db" "SELECT '- #' || t.id || ' [' || t.status || '] ' || t.title FROM task_dependencies td JOIN tasks t ON t.id = td.blocker_task_id WHERE td.task_id = $id ORDER BY t.status <> 'done' DESC, t.priority DESC, t.id ASC;")
  blocks=$(sqlite_query "$db" "SELECT '- #' || t.id || ' [' || t.status || '] ' || t.title FROM task_dependencies td JOIN tasks t ON t.id = td.task_id WHERE td.blocker_task_id = $id ORDER BY t.status <> 'done' DESC, t.priority DESC, t.id ASC;")

  printf '## Dependencies\n'
  printf 'Blocked by:\n'
  if [ -n "$blockers" ]; then
    printf '%s\n' "$blockers"
  else
    printf 'None\n'
  fi
  printf '\n'

  printf 'Blocks:\n'
  if [ -n "$blocks" ]; then
    printf '%s\n' "$blocks"
  else
    printf 'None\n'
  fi
  printf '\n'
}

render_task_core() {
  local db=$1
  local id=$2
  local title status priority body acceptance verify claimed_by claimed_at lease_until result_summary trashed_from trashed_at

  title=$(sqlite_value "$db" "SELECT title FROM tasks WHERE id = $id;")
  [ -n "$title" ] || die "task not found: $id"
  status=$(sqlite_value "$db" "SELECT status FROM tasks WHERE id = $id;")
  trashed_from=$(sqlite_value "$db" "SELECT COALESCE(trashed_from_status, '') FROM tasks WHERE id = $id;")
  trashed_at=$(sqlite_value "$db" "SELECT COALESCE(trashed_at, '') FROM tasks WHERE id = $id;")
  priority=$(sqlite_value "$db" "SELECT priority FROM tasks WHERE id = $id;")
  body=$(sqlite_value "$db" "SELECT body FROM tasks WHERE id = $id;")
  acceptance=$(sqlite_value "$db" "SELECT acceptance FROM tasks WHERE id = $id;")
  verify=$(sqlite_value "$db" "SELECT verify_command FROM tasks WHERE id = $id;")
  claimed_by=$(sqlite_value "$db" "SELECT COALESCE(claimed_by, '') FROM tasks WHERE id = $id;")
  claimed_at=$(sqlite_value "$db" "SELECT COALESCE(claimed_at, '') FROM tasks WHERE id = $id;")
  lease_until=$(sqlite_value "$db" "SELECT COALESCE(lease_until, '') FROM tasks WHERE id = $id;")
  result_summary=$(sqlite_value "$db" "SELECT result_summary FROM tasks WHERE id = $id;")
  due_date=$(sqlite_value "$db" "SELECT COALESCE(due_date, '') FROM tasks WHERE id = $id;")
  created_at=$(sqlite_value "$db" "SELECT created_at FROM tasks WHERE id = $id;")
  age_days=$(sqlite_value "$db" "SELECT CAST(MAX(0, julianday('now') - julianday(created_at)) AS INTEGER) FROM tasks WHERE id = $id;")
  lease_remaining=$(sqlite_value "$db" "SELECT CASE WHEN lease_until IS NULL OR lease_until = '' THEN '' WHEN lease_until < strftime('%Y-%m-%dT%H:%M:%fZ', 'now') THEN 'expired' ELSE CAST((julianday(lease_until) - julianday('now')) * 1440 AS INTEGER) || ' minutes' END FROM tasks WHERE id = $id;")

  printf '# Task #%s\n\n' "$id"
  printf '## Title\n%s\n\n' "$title"
  printf '## Status\n%s\n\n' "$status"
  if [ "$status" = "trashed" ]; then
    printf "Trashed from: %s\nTrashed at: %s\nRestore with 'cxq restore %s'.\n\n" "${trashed_from:-unknown}" "${trashed_at:-unknown}" "$id"
  fi
  printf '## Priority\n%s\n\n' "$priority"

  printf '## Due date\n'
  if [ -n "$due_date" ]; then
    if [ "$due_date" "<" "$(date -u '+%Y-%m-%d' 2>/dev/null || date '+%Y-%m-%d')" ] && [ "$status" != "done" ] && [ "$status" != "wontfix" ]; then
      printf '%s (OVERDUE)\n\n' "$due_date"
    else
      printf '%s\n\n' "$due_date"
    fi
  else
    printf 'None\n\n'
  fi

  local recurs
  recurs=$(sqlite_value "$db" "SELECT COALESCE(recurs, '') FROM tasks WHERE id = $id;")
  printf '## Recurrence\n'
  if [ -n "$recurs" ]; then
    printf '%s\n\n' "$recurs"
  else
    printf 'None\n\n'
  fi

  printf '## Age\n%s day(s) (created %s)\n\n' "${age_days:-0}" "$created_at"

  printf '## Body\n'
  if [ -n "$body" ]; then
    printf '%s\n' "$body"
  else
    printf 'None\n'
  fi
  printf '\n'

  printf '## Allowed paths\n'
  print_json_array_md "$db" "$id" "allowed_paths_json"
  printf '\n'

  printf '## Tags\n'
  print_json_array_md "$db" "$id" "tags_json"
  printf '\n'

  render_task_dependencies "$db" "$id"

  printf '## Acceptance criteria\n'
  if [ -n "$acceptance" ]; then
    printf '%s\n' "$acceptance"
  else
    printf 'None\n'
  fi
  printf '\n'

  printf '## Verification command\n'
  if [ -n "$verify" ]; then
    printf '%s\n' "$verify"
  else
    printf 'None\n'
  fi
  printf '\n'

  if [ -n "$claimed_by" ] || [ -n "$lease_until" ]; then
    printf '## Claim\n'
    [ -n "$claimed_by" ] && printf 'Claimed by: %s\n' "$claimed_by"
    [ -n "$claimed_at" ] && printf 'Claimed at: %s\n' "$claimed_at"
    [ -n "$lease_until" ] && printf 'Lease until: %s\n' "$lease_until"
    [ -n "$lease_remaining" ] && printf 'Lease remaining: %s\n' "$lease_remaining"
    printf '\n'
  fi

  if [ -n "$result_summary" ]; then
    printf '## Result summary\n%s\n\n' "$result_summary"
  fi

  render_task_findings "$db" "$id"
}

render_task_events() {
  local db=$1
  local id=$2
  local events

  events=$(sqlite_query "$db" "SELECT '- ' || created_at || ' \`' || event_type || '\` by ' || actor || CASE WHEN note <> '' THEN ': ' || replace(note, char(10), ' ') ELSE '' END FROM (SELECT id, created_at, event_type, actor, note FROM task_events WHERE task_id = $id ORDER BY created_at DESC, id DESC LIMIT 10) ORDER BY created_at ASC, id ASC;")

  printf '## Recent events\n'
  if [ -n "$events" ]; then
    printf '%s\n' "$events"
  else
    printf 'None\n'
  fi
  printf '\n'
}

render_agent_instructions() {
  local id=$1

  cat <<EOF
## Agent instructions
- Work only on this task.
- Respect allowed paths unless the implementation clearly requires more scope.
- Run the verification command when present.
- Use \`cxq note $id "..."\` for important discoveries.
- Move implementation work to \`review\`, not \`done\`:
  \`cxq review $id --summary "..."\`
EOF
}

render_task_md() {
  local db=$1
  local id=$2
  render_task_core "$db" "$id"
}

render_task_show() {
  local db=$1
  local id=$2
  render_task_core "$db" "$id"
  render_task_events "$db" "$id"
  render_task_edit_history "$db" "$id"
}

render_task_prompt() {
  local db=$1
  local id=$2

  printf 'You are working on local task #%s.\n\n' "$id"
  render_task_core "$db" "$id"
  render_task_events "$db" "$id"
  render_agent_instructions "$id"
}

task_exists() {
  local db=$1
  local id=$2
  local count
  count=$(sqlite_value "$db" "SELECT COUNT(*) FROM tasks WHERE id = $id;")
  [ "$count" = "1" ]
}

# Refuse to move a trashed task; it must be restored first. Used by the
# commands that change status with an unconditional UPDATE.
die_if_trashed() {
  local db=$1 id=$2 status
  status=$(sqlite_value "$db" "SELECT status FROM tasks WHERE id = $id;")
  [ "$status" != "trashed" ] || die "task $id is trashed; restore it first with 'cxq restore $id'."
}

task_has_open_blockers() {
  local db=$1
  local id=$2
  local count
  count=$(sqlite_value "$db" "SELECT COUNT(*) FROM task_dependencies td JOIN tasks blocker ON blocker.id = td.blocker_task_id WHERE td.task_id = $id AND blocker.status NOT IN ('done', 'trashed');")
  [ "$count" != "0" ]
}

dependency_would_cycle() {
  local db=$1
  local task_id=$2
  local blocker_id=$3
  local count
  count=$(sqlite_value "$db" "WITH RECURSIVE dependency_chain(id) AS (SELECT blocker_task_id FROM task_dependencies WHERE task_id = $blocker_id UNION SELECT td.blocker_task_id FROM task_dependencies td JOIN dependency_chain dc ON td.task_id = dc.id) SELECT COUNT(*) FROM dependency_chain WHERE id = $task_id;")
  [ "$count" != "0" ]
}

require_task_id() {
  local id=${1-}
  [[ "$id" =~ ^[0-9]+$ ]] || die "task id must be an integer."
}

list_status_order_sql() {
  printf "CASE status WHEN 'ready' THEN 0 WHEN 'claimed' THEN 1 WHEN 'review' THEN 2 WHEN 'blocked' THEN 3 WHEN 'inbox' THEN 4 ELSE 5 END"
}

cmd_list_questions() {
  local db=$1
  sqlite_table "$db" "SELECT t.id, t.status, t.priority, t.title, replace(e.note, char(10), ' ') AS question FROM tasks t JOIN task_events e ON e.task_id = t.id WHERE e.event_type = 'note' AND (e.note LIKE 'DUDA:%' OR e.note LIKE 'BLOCKER:%') AND t.status NOT IN ('done', 'wontfix', 'trashed') ORDER BY $(list_status_order_sql), t.priority DESC, e.id ASC;"
}

cmd_list_needs_action() {
  local db=$1
  sqlite_table "$db" "SELECT id, status, priority, title, COALESCE(claimed_by, '') AS claimed_by, (SELECT COUNT(*) FROM task_findings f WHERE f.task_id = tasks.id AND f.status = 'open') AS open_findings FROM tasks WHERE status IN ('ready', 'blocked') OR (status = 'review' AND EXISTS (SELECT 1 FROM task_findings f WHERE f.task_id = tasks.id AND f.status = 'open')) ORDER BY $(list_status_order_sql), priority DESC, created_at ASC;"
}

cmd_list() {
  require_sqlite3

  local include_all=0 status="" view="" tag="" agent="" pmin="" search="" overdue=0 due_before="" format="table"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --all)
        include_all=1
        shift
        ;;
      --needs-action|--questions)
        [ -z "$view" ] || die "choose only one list view."
        view=$1
        shift
        ;;
      --status)
        [ "$#" -ge 2 ] || die "--status requires a value."
        status=$2
        status_is_valid "$status" || die "invalid status: $status"
        shift 2
        ;;
      --tag)
        [ "$#" -ge 2 ] || die "--tag requires a value."
        tag=$2
        shift 2
        ;;
      --agent)
        [ "$#" -ge 2 ] || die "--agent requires a value."
        agent=$2
        shift 2
        ;;
      --priority-min)
        [ "$#" -ge 2 ] || die "--priority-min requires a value."
        pmin=$2
        [[ "$pmin" =~ ^[0-9]+$ ]] || die "--priority-min must be an integer."
        shift 2
        ;;
      --search)
        [ "$#" -ge 2 ] || die "--search requires a value."
        search=$2
        shift 2
        ;;
      --overdue)
        overdue=1
        shift
        ;;
      --due-before)
        [ "$#" -ge 2 ] || die "--due-before requires a value."
        due_before=$2
        valid_due_date "$due_before" || die "--due-before must be a valid YYYY-MM-DD date."
        shift 2
        ;;
      --format)
        [ "$#" -ge 2 ] || die "--format requires a value."
        format=$2
        case "$format" in
          json|table|md) ;;
          *) die "invalid format: $format" ;;
        esac
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        die "unknown list option: $1"
        ;;
    esac
  done

  local db where
  db=$(db_path_or_die)

  case "$view" in
    --needs-action)
      cmd_list_needs_action "$db"
      return
      ;;
    --questions)
      cmd_list_questions "$db"
      return
      ;;
  esac

  local filtered=0
  [ -n "$tag" ] && filtered=1
  [ -n "$agent" ] && filtered=1
  [ -n "$pmin" ] && filtered=1
  [ -n "$search" ] && filtered=1
  [ "$overdue" -eq 1 ] && filtered=1
  [ -n "$due_before" ] && filtered=1

  if [ -n "$status" ]; then
    where="status = $(sql_quote "$status")"
  elif [ "$include_all" -eq 1 ]; then
    where="1 = 1"
  else
    where="status NOT IN ('done', 'wontfix', 'trashed')"
  fi
  [ -n "$tag" ] && where="$where AND EXISTS (SELECT 1 FROM json_each(tags_json) WHERE value = $(sql_quote "$tag"))"
  [ -n "$agent" ] && where="$where AND claimed_by = $(sql_quote "$agent")"
  [ -n "$pmin" ] && where="$where AND priority >= $pmin"
  if [ -n "$search" ]; then
    local esc
    esc=$(like_escape "$search")
    where="$where AND (title LIKE $(sql_quote "%$esc%") ESCAPE '\\' OR body LIKE $(sql_quote "%$esc%") ESCAPE '\\' OR tags_json LIKE $(sql_quote "%$esc%") ESCAPE '\\')"
  fi
  [ "$overdue" -eq 1 ] && where="$where AND due_date IS NOT NULL AND due_date < date('now') AND status NOT IN ('done', 'wontfix', 'trashed')"
  [ -n "$due_before" ] && where="$where AND due_date IS NOT NULL AND due_date < $(sql_quote "$due_before")"

  if [ "$format" = "json" ]; then
    sqlite_run "$db" "SELECT id, status, priority, title, claimed_by, lease_until, due_date, created_at FROM tasks WHERE $where ORDER BY $(list_status_order_sql), priority DESC, created_at ASC;" -json
    return
  fi
  if [ "$format" = "md" ]; then
    printf '| id | status | priority | title |\n| --- | --- | --- | --- |\n'
    sqlite_query "$db" "SELECT '| ' || id || ' | ' || status || ' | ' || priority || ' | ' || replace(title, '|', '/') || ' |' FROM tasks WHERE $where ORDER BY $(list_status_order_sql), priority DESC, created_at ASC;"
    return
  fi
  if [ "$filtered" -eq 1 ]; then
    sqlite_table "$db" "SELECT id, status, priority, title, COALESCE(claimed_by, '') AS claimed_by, COALESCE(lease_until, '') AS lease_until, COALESCE(due_date, '') AS due_date FROM tasks WHERE $where ORDER BY $(list_status_order_sql), priority DESC, created_at ASC;"
    return
  fi
  # No new flags: byte-stable legacy output.
  sqlite_table "$db" "SELECT id, status, priority, title, COALESCE(claimed_by, '') AS claimed_by, COALESCE(lease_until, '') AS lease_until FROM tasks WHERE $where ORDER BY $(list_status_order_sql), priority DESC, created_at ASC;"
}

# One group of `cxq due`: a heading plus the group's tasks, or (none).
due_section() {
  local db=$1 heading=$2 where=$3 format=$4
  local count
  printf '%s\n' "$heading"
  count=$(sqlite_value "$db" "SELECT COUNT(*) FROM tasks WHERE $where;")
  if [ "$count" = "0" ]; then
    printf '(none)\n\n'
    return 0
  fi
  if [ "$format" = "md" ]; then
    printf '| id | status | priority | title | due_date |\n| --- | --- | --- | --- | --- |\n'
    sqlite_query "$db" "SELECT '| ' || id || ' | ' || status || ' | ' || priority || ' | ' || replace(title, '|', '/') || ' | ' || due_date || ' |' FROM tasks WHERE $where ORDER BY due_date ASC, priority DESC, created_at ASC;"
  else
    sqlite_table "$db" "SELECT id, status, priority, title, due_date FROM tasks WHERE $where ORDER BY due_date ASC, priority DESC, created_at ASC;"
  fi
  printf '\n'
}

# `cxq due`: tasks with a due date, grouped overdue first, then due
# today, then due tomorrow. Tasks without a due date never appear, and
# neither do done, wontfix, or trashed tasks. "Today" is SQLite
# date('now') — UTC — the same definition the existing --overdue filter
# and the OVERDUE markers use, so the three views agree.
cmd_due() {
  require_sqlite3

  local format="table"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --format)
        [ "$#" -ge 2 ] || die "--format requires a value."
        format=$2
        case "$format" in
          json|table|md) ;;
          *) die "invalid format: $format" ;;
        esac
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        die "unknown due option: $1"
        ;;
    esac
  done

  local db
  db=$(db_path_or_die)

  if [ "$format" = "json" ]; then
    # sqlite3 -json prints nothing for zero rows; default to [] so the
    # output is always valid JSON.
    local tasks_json
    tasks_json=$(sqlite_run "$db" "SELECT id, status, priority, title, due_date, CASE WHEN due_date < date('now') THEN 'overdue' WHEN due_date = date('now') THEN 'today' ELSE 'tomorrow' END AS due_group FROM tasks WHERE due_date IS NOT NULL AND due_date <= date('now', '+1 day') AND status NOT IN ('done', 'wontfix', 'trashed') ORDER BY due_date ASC, priority DESC, created_at ASC;" -json)
    printf '%s\n' "${tasks_json:-[]}"
    return
  fi
  due_section "$db" "Overdue:" "due_date IS NOT NULL AND due_date < date('now') AND status NOT IN ('done', 'wontfix', 'trashed')" "$format"
  due_section "$db" "Due today:" "due_date = date('now') AND status NOT IN ('done', 'wontfix', 'trashed')" "$format"
  due_section "$db" "Due tomorrow:" "due_date = date('now', '+1 day') AND status NOT IN ('done', 'wontfix', 'trashed')" "$format"
}

# `cxq digest`: the daily overdue digest — overdue + due today + due
# tomorrow, with a one-line summary and the date. No daemon, no email:
# wire it to a daily cron (see README) or paste `--format md` into chat.
# Same date definition and groups as `cxq due` (SQLite date('now'), UTC).
cmd_digest() {
  require_sqlite3

  local format="table"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --format)
        [ "$#" -ge 2 ] || die "--format requires a value."
        format=$2
        case "$format" in
          json|table|md) ;;
          *) die "invalid format: $format" ;;
        esac
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        die "unknown digest option: $1"
        ;;
    esac
  done

  local db today overdue today_n tomorrow_n
  db=$(db_path_or_die)
  today=$(sqlite_value "$db" "SELECT date('now');")
  overdue=$(sqlite_value "$db" "SELECT COUNT(*) FROM tasks WHERE due_date IS NOT NULL AND due_date < date('now') AND status NOT IN ('done', 'wontfix', 'trashed');")
  today_n=$(sqlite_value "$db" "SELECT COUNT(*) FROM tasks WHERE due_date = date('now') AND status NOT IN ('done', 'wontfix', 'trashed');")
  tomorrow_n=$(sqlite_value "$db" "SELECT COUNT(*) FROM tasks WHERE due_date = date('now', '+1 day') AND status NOT IN ('done', 'wontfix', 'trashed');")

  if [ "$format" = "json" ]; then
    # sqlite3 -json prints nothing for zero rows; default to [] so the
    # output is always valid JSON.
    local tasks_json
    tasks_json=$(sqlite_run "$db" "SELECT id, status, priority, title, due_date, CASE WHEN due_date < date('now') THEN 'overdue' WHEN due_date = date('now') THEN 'today' ELSE 'tomorrow' END AS due_group FROM tasks WHERE due_date IS NOT NULL AND due_date <= date('now', '+1 day') AND status NOT IN ('done', 'wontfix', 'trashed') ORDER BY due_date ASC, priority DESC, created_at ASC;" -json)
    printf '{"date": "%s", "overdue_count": %s, "today_count": %s, "tomorrow_count": %s, "tasks": %s}\n' "$today" "$overdue" "$today_n" "$tomorrow_n" "${tasks_json:-[]}"
    return 0
  fi

  printf '# cxq digest — %s\n\n' "$today"
  printf 'Overdue: %s | Due today: %s | Due tomorrow: %s\n\n' "$overdue" "$today_n" "$tomorrow_n"
  if [ "$overdue" = "0" ] && [ "$today_n" = "0" ] && [ "$tomorrow_n" = "0" ]; then
    printf 'All clear — nothing overdue or due in the next 2 days.\n'
    return 0
  fi
  due_section "$db" "Overdue:" "due_date IS NOT NULL AND due_date < date('now') AND status NOT IN ('done', 'wontfix', 'trashed')" "$format"
  due_section "$db" "Due today:" "due_date = date('now') AND status NOT IN ('done', 'wontfix', 'trashed')" "$format"
  due_section "$db" "Due tomorrow:" "due_date = date('now', '+1 day') AND status NOT IN ('done', 'wontfix', 'trashed')" "$format"
}

cmd_review_stale() {
  require_sqlite3

  local older_than="24h"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --older-than)
        [ "$#" -ge 2 ] || die "--older-than requires a value."
        older_than=$2
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        die "unknown review-stale option: $1"
        ;;
    esac
  done

  local db modifier
  db=$(db_path_or_die)
  modifier=$(duration_modifier "$older_than" "-" "--older-than")
  sqlite_table "$db" "SELECT id, priority, title, updated_at, (SELECT COUNT(*) FROM task_findings f WHERE f.task_id = tasks.id AND f.status = 'open') AS open_findings FROM tasks WHERE status = 'review' AND updated_at < strftime('%Y-%m-%dT%H:%M:%fZ', 'now', $(sql_quote "$modifier")) ORDER BY updated_at ASC;"
}

cmd_next() {
  require_sqlite3

  local format="text"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --format)
        [ "$#" -ge 2 ] || die "--format requires a value."
        format=$2
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        die "unknown next option: $1"
        ;;
    esac
  done

  case "$format" in
    text|id|md) ;;
    *) die "invalid format: $format" ;;
  esac

  local db id
  db=$(db_path_or_die)
  id=$(sqlite_value "$db" "SELECT id FROM tasks candidate WHERE status = 'ready' AND NOT EXISTS (SELECT 1 FROM task_dependencies td JOIN tasks blocker ON blocker.id = td.blocker_task_id WHERE td.task_id = candidate.id AND blocker.status NOT IN ('done', 'trashed')) ORDER BY priority DESC, created_at ASC LIMIT 1;")
  if [ -z "$id" ]; then
    printf 'No ready tasks.\n' >&2
    exit 1
  fi

  case "$format" in
    id) printf '%s\n' "$id" ;;
    md) render_task_md "$db" "$id" ;;
    text) format_task_text "$db" "$id" ;;
  esac
}

cmd_show() {
  require_sqlite3
  [ "$#" -eq 1 ] || die "usage: cxq show <id>"

  local id=$1 db
  require_task_id "$id"
  db=$(db_path_or_die)
  task_exists "$db" "$id" || die "task not found: $id"
  render_task_show "$db" "$id"
}

cmd_block() {
  require_sqlite3
  [ "$#" -ge 1 ] || die "usage: cxq block <id> --by <blocker-id>"

  local id=$1 blocker_id="" db actor changed
  require_task_id "$id"
  shift

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --by)
        [ "$#" -ge 2 ] || die "--by requires a task id."
        blocker_id=$2
        require_task_id "$blocker_id"
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        die "unknown block option: $1"
        ;;
    esac
  done

  [ -n "$blocker_id" ] || die "blocker task id is required."
  [ "$id" != "$blocker_id" ] || die "task cannot block itself."

  db=$(db_path_or_die)
  task_exists "$db" "$id" || die "task not found: $id"
  task_exists "$db" "$blocker_id" || die "blocker task not found: $blocker_id"
  if dependency_would_cycle "$db" "$id" "$blocker_id"; then
    die "dependency would create a cycle."
  fi

  changed=$(sqlite_value "$db" "INSERT OR IGNORE INTO task_dependencies (task_id, blocker_task_id) VALUES ($id, $blocker_id); SELECT changes();")
  actor=$(current_actor)
  if [ "$changed" = "1" ]; then
    log_event "$db" "$id" "blocked_by" "$actor" "blocked by #$blocker_id"
  fi
  printf 'Task #%s is blocked by #%s\n' "$id" "$blocker_id"
}

cmd_deps() {
  require_sqlite3
  [ "$#" -eq 1 ] || die "usage: cxq deps <id>"

  local id=$1 db
  require_task_id "$id"
  db=$(db_path_or_die)
  task_exists "$db" "$id" || die "task not found: $id"
  printf '# Dependencies for task #%s\n\n' "$id"
  render_task_dependencies "$db" "$id"
}

cmd_unblock() {
  require_sqlite3
  [ "$#" -ge 1 ] || die "usage: cxq unblock <id> --by <blocker-id>"

  local id=$1 blocker_id="" db actor changed
  require_task_id "$id"
  shift

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --by)
        [ "$#" -ge 2 ] || die "--by requires a task id."
        blocker_id=$2
        require_task_id "$blocker_id"
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        die "unknown unblock option: $1"
        ;;
    esac
  done

  [ -n "$blocker_id" ] || die "blocker task id is required."

  db=$(db_path_or_die)
  task_exists "$db" "$id" || die "task not found: $id"
  task_exists "$db" "$blocker_id" || die "blocker task not found: $blocker_id"
  changed=$(sqlite_value "$db" "DELETE FROM task_dependencies WHERE task_id = $id AND blocker_task_id = $blocker_id; SELECT changes();")
  if [ "$changed" = "0" ]; then
    die "task $id is not blocked by $blocker_id."
  fi
  actor=$(current_actor)
  log_event "$db" "$id" "unblocked_by" "$actor" "removed blocker #$blocker_id"
  printf 'Task #%s is no longer blocked by #%s\n' "$id" "$blocker_id"
}

duration_modifier() {
  local duration=${1-}
  local sign=${2:-+}
  local label=${3:-duration}
  if [[ "$duration" =~ ^([0-9]+)m$ ]]; then
    printf '%s%s minutes' "$sign" "${BASH_REMATCH[1]}"
  elif [[ "$duration" =~ ^([0-9]+)h$ ]]; then
    printf '%s%s hours' "$sign" "${BASH_REMATCH[1]}"
  elif [[ "$duration" =~ ^([0-9]+)d$ ]]; then
    printf '%s%s days' "$sign" "${BASH_REMATCH[1]}"
  else
    die "$label must look like 30m, 2h, or 1d."
  fi
}

lease_modifier() {
  duration_modifier "${1:-2h}" "+" "lease"
}

# Single source of truth for supported status movements.
# Each line is: from|to|command that performs it.
status_transitions_table() {
  cat <<'EOF'
inbox|ready|cxq reopen <id> --to ready --reason "..."
inbox|claimed|cxq claim <id>
ready|claimed|cxq claim <id> or cxq claim-next
ready|blocked|cxq reopen <id> --to blocked --reason "..."
claimed|ready|cxq release <id>
claimed|blocked|cxq reopen <id> --to blocked --reason "..."
claimed|review|cxq review <id> --summary "..."
claimed|done|cxq done <id>
blocked|ready|cxq release <id>
blocked|inbox|cxq reopen <id> --to inbox --reason "..."
review|ready|cxq reopen <id> --reason "..."
review|inbox|cxq reopen <id> --to inbox --reason "..."
review|blocked|cxq reopen <id> --to blocked --reason "..."
review|done|cxq done <id>
done|ready|cxq reopen <id> --reason "..."
done|inbox|cxq reopen <id> --to inbox --reason "..."
wontfix|ready|cxq reopen <id> --reason "..."
wontfix|inbox|cxq reopen <id> --to inbox --reason "..."
inbox|trashed|cxq delete <id> [--force]
ready|trashed|cxq delete <id> [--force]
claimed|trashed|cxq delete <id> [--force]
blocked|trashed|cxq delete <id> [--force]
review|trashed|cxq delete <id> [--force]
done|trashed|cxq delete <id> [--force]
wontfix|trashed|cxq delete <id> [--force]
trashed|inbox|cxq restore <id>
trashed|ready|cxq restore <id>
trashed|blocked|cxq restore <id>
trashed|review|cxq restore <id>
trashed|done|cxq restore <id>
trashed|wontfix|cxq restore <id>
EOF
}

transition_allows() {
  local from=$1
  local to=$2
  local t_from t_to rest
  while IFS='|' read -r t_from t_to rest; do
    [ -n "$t_from" ] || continue
    if [ "$t_from" = "$from" ] && [ "$t_to" = "$to" ]; then
      return 0
    fi
  done <<<"$(status_transitions_table)"
  return 1
}

cmd_status_transitions() {
  [ "$#" -eq 0 ] || die "status-transitions does not accept arguments."

  local from to command
  printf '# cxq status transitions\n\n'
  printf '%-8s  %-8s  %s\n' "from" "to" "command"
  printf '%-8s  %-8s  %s\n' "--------" "--------" "--------------------------------------"
  while IFS='|' read -r from to command; do
    [ -n "$from" ] || continue
    printf '%-8s  %-8s  %s\n' "$from" "$to" "$command"
  done <<<"$(status_transitions_table)"
  printf '\nAgents normally stop at review. A human decides done.\n'
}

cmd_reopen() {
  require_sqlite3
  [ "$#" -ge 1 ] || die "usage: cxq reopen <id> [--to ready|inbox|blocked] --reason <reason>"

  local id=$1 target="ready" reason=""
  require_task_id "$id"
  shift

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --to)
        [ "$#" -ge 2 ] || die "--to requires a value."
        target=$2
        shift 2
        ;;
      --reason)
        [ "$#" -ge 2 ] || die "--reason requires a value."
        reason=$2
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        die "unknown reopen option: $1"
        ;;
    esac
  done

  case "$target" in
    ready|inbox|blocked) ;;
    *) die "reopen target must be ready, inbox, or blocked." ;;
  esac
  [ -n "$reason" ] || die "reopen reason is required."

  local db actor from
  db=$(db_path_or_die)
  task_exists "$db" "$id" || die "task not found: $id"
  from=$(sqlite_value "$db" "SELECT status FROM tasks WHERE id = $id;")
  [ "$from" != "$target" ] || die "task $id is already $target."
  die_if_trashed "$db" "$id"
  transition_allows "$from" "$target" ||
    die "cannot move task $id from $from to $target; run 'cxq status-transitions'."

  actor=$(current_actor)
  sqlite_exec "$db" "UPDATE tasks SET status = $(sql_quote "$target"), claimed_by = NULL, claimed_at = NULL, lease_until = NULL WHERE id = $id;"
  log_event "$db" "$id" "reopened" "$actor" "$from -> $target: $reason"
  printf 'Reopened task #%s: %s -> %s\n' "$id" "$from" "$target"
}

cmd_followup() {
  require_sqlite3
  [ "$#" -ge 1 ] || die "usage: cxq followup <id> <title> [options]"

  local parent=$1
  require_task_id "$parent"
  shift

  local title="" body="" priority="" close=0 files="" tags="" acceptance="" verify=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --priority)
        [ "$#" -ge 2 ] || die "--priority requires a value."
        priority=$2
        shift 2
        ;;
      --body)
        [ "$#" -ge 2 ] || die "--body requires a value."
        body=$2
        shift 2
        ;;
      --files|--allowed-paths)
        [ "$#" -ge 2 ] || die "$1 requires a value."
        files=$2
        shift 2
        ;;
      --tag)
        [ "$#" -ge 2 ] || die "--tag requires a value."
        tags="${tags}${tags:+,}$2"
        shift 2
        ;;
      --acceptance)
        [ "$#" -ge 2 ] || die "--acceptance requires a value."
        acceptance=$2
        shift 2
        ;;
      --verify|--verify-command)
        [ "$#" -ge 2 ] || die "$1 requires a value."
        verify=$2
        shift 2
        ;;
      --close)
        close=1
        shift
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      --*)
        die "unknown followup option: $1"
        ;;
      *)
        if [ -z "$title" ]; then
          title=$1
        else
          body="${body}${body:+ }$1"
        fi
        shift
        ;;
    esac
  done

  [ -n "$title" ] || die "followup title is required."
  if [ -n "$priority" ]; then
    [[ "$priority" =~ ^[0-9]+$ ]] || die "priority must be an integer."
  fi

  local db root branch actor files_json tags_json new_id full_body parent_status next_id next_due
  db=$(db_path_or_die)
  task_exists "$db" "$parent" || die "task not found: $parent"
  root=$(project_root_or_die)
  branch=$(current_branch "$root")
  actor=$(current_actor)

  if [ -n "$files" ]; then
    files_json=$(csv_to_json_array "$files")
  else
    files_json=$(sqlite_value "$db" "SELECT allowed_paths_json FROM tasks WHERE id = $parent;")
  fi
  if [ -n "$tags" ]; then
    tags_json=$(csv_to_json_array "$tags")
  else
    tags_json=$(sqlite_value "$db" "SELECT tags_json FROM tasks WHERE id = $parent;")
  fi
  if [ -z "$priority" ]; then
    priority=$(sqlite_value "$db" "SELECT priority FROM tasks WHERE id = $parent;")
  fi
  if [ -z "$verify" ]; then
    verify=$(sqlite_value "$db" "SELECT verify_command FROM tasks WHERE id = $parent;")
  fi

  full_body="Follow-up of task #$parent."
  if [ -n "$body" ]; then
    full_body="$full_body"$'\n\n'"$body"
  fi

  new_id=$(sqlite_value "$db" "INSERT INTO tasks (title, body, status, priority, repo_path, branch, allowed_paths_json, tags_json, acceptance, verify_command) VALUES ($(sql_quote "$title"), $(sql_quote "$full_body"), 'ready', $priority, $(sql_quote "$root"), $(sql_quote "$branch"), $(sql_quote "$files_json"), $(sql_quote "$tags_json"), $(sql_quote "$acceptance"), $(sql_quote "$verify")); SELECT last_insert_rowid();")
  sqlite_exec "$db" "INSERT OR IGNORE INTO task_dependencies (task_id, blocker_task_id) VALUES ($new_id, $parent);"
  log_event "$db" "$new_id" "created" "$actor" "$title"
  log_event "$db" "$new_id" "followup_of" "$actor" "follow-up of #$parent"
  log_event "$db" "$parent" "followup_created" "$actor" "follow-up #$new_id: $title"
  printf 'Created follow-up task #%s for #%s\n' "$new_id" "$parent"

  if [ "$close" -eq 1 ]; then
    die_if_trashed "$db" "$parent"
    parent_status=$(sqlite_value "$db" "SELECT status FROM tasks WHERE id = $parent;")
    sqlite_exec "$db" "UPDATE tasks SET status = 'done', result_summary = TRIM(result_summary || ' Closed with follow-up #$new_id.'), claimed_by = NULL, claimed_at = NULL, lease_until = NULL WHERE id = $parent;"
    log_event "$db" "$parent" "done" "$actor" "closed with follow-up #$new_id"
    printf 'Closed task #%s with follow-up #%s\n' "$parent" "$new_id"
    if [ "$parent_status" != "done" ]; then
      next_id=$(maybe_create_next_occurrence "$db" "$parent" "$actor")
      if [ -n "$next_id" ]; then
        next_due=$(sqlite_value "$db" "SELECT due_date FROM tasks WHERE id = $next_id;")
        printf 'Created next occurrence #%s (due %s)\n' "$next_id" "$next_due"
      fi
    fi
  fi
}

cmd_claim() {
  require_sqlite3
  [ "$#" -ge 1 ] || die "task id is required."

  local id=$1 agent="agent" lease="2h"
  require_task_id "$id"
  shift

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --agent)
        [ "$#" -ge 2 ] || die "--agent requires a value."
        agent=$2
        shift 2
        ;;
      --lease)
        [ "$#" -ge 2 ] || die "--lease requires a value."
        lease=$2
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        die "unknown claim option: $1"
        ;;
    esac
  done

  local db modifier changed
  db=$(db_path_or_die)
  task_exists "$db" "$id" || die "task not found: $id"
  modifier=$(lease_modifier "$lease")

  changed=$(sqlite_value "$db" "UPDATE tasks SET status = 'claimed', claimed_by = $(sql_quote "$agent"), claimed_at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now'), lease_until = strftime('%Y-%m-%dT%H:%M:%fZ', 'now', $(sql_quote "$modifier")) WHERE id = $id AND (status IN ('ready', 'inbox') OR (status = 'claimed' AND lease_until IS NOT NULL AND lease_until < strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))) AND NOT EXISTS (SELECT 1 FROM task_dependencies td JOIN tasks blocker ON blocker.id = td.blocker_task_id WHERE td.task_id = tasks.id AND blocker.status NOT IN ('done', 'trashed')); SELECT changes();")
  if [ "$changed" = "0" ]; then
    die "task $id is not available to claim."
  fi

  log_event "$db" "$id" "claimed" "$agent" "lease $lease"
  printf 'Claimed task #%s as %s\n' "$id" "$agent"
}

cmd_claim_next() {
  require_sqlite3

  local agent="agent" lease="2h" format="id"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --agent)
        [ "$#" -ge 2 ] || die "--agent requires a value."
        agent=$2
        shift 2
        ;;
      --lease)
        [ "$#" -ge 2 ] || die "--lease requires a value."
        lease=$2
        shift 2
        ;;
      --format)
        [ "$#" -ge 2 ] || die "--format requires a value."
        format=$2
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        die "unknown claim-next option: $1"
        ;;
    esac
  done

  case "$format" in
    id|md|prompt) ;;
    *) die "invalid format: $format" ;;
  esac

  local db modifier id sql
  db=$(db_path_or_die)
  modifier=$(lease_modifier "$lease")
  sql="
BEGIN IMMEDIATE;
CREATE TEMP TABLE cxq_claim_next_selection (id INTEGER PRIMARY KEY);
INSERT INTO cxq_claim_next_selection (id)
SELECT id
FROM tasks candidate
WHERE (
    status = 'ready'
    OR (
    status = 'claimed'
    AND lease_until IS NOT NULL
    AND lease_until < strftime('%Y-%m-%dT%H:%M:%fZ', 'now')
   ))
  AND NOT EXISTS (
    SELECT 1
    FROM task_dependencies td
    JOIN tasks blocker ON blocker.id = td.blocker_task_id
    WHERE td.task_id = candidate.id
      AND blocker.status NOT IN ('done', 'trashed')
  )
ORDER BY priority DESC, created_at ASC
LIMIT 1;
UPDATE tasks
SET status = 'claimed',
    claimed_by = $(sql_quote "$agent"),
    claimed_at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now'),
    lease_until = strftime('%Y-%m-%dT%H:%M:%fZ', 'now', $(sql_quote "$modifier"))
WHERE id IN (SELECT id FROM cxq_claim_next_selection);
INSERT INTO task_events (task_id, event_type, actor, note, data_json)
SELECT id, 'claimed', $(sql_quote "$agent"), $(sql_quote "lease $lease"), '{\"source\":\"claim-next\"}'
FROM cxq_claim_next_selection;
SELECT id FROM cxq_claim_next_selection;
COMMIT;
"
  id=$(sqlite_query "$db" "$sql")
  if [ -z "$id" ]; then
    printf 'No available tasks.\n' >&2
    exit 1
  fi

  case "$format" in
    id) printf '%s\n' "$id" ;;
    md) render_task_show "$db" "$id" ;;
    prompt) render_task_prompt "$db" "$id" ;;
  esac
}

cmd_note() {
  require_sqlite3
  [ "$#" -ge 2 ] || die "usage: cxq note <id> <note>"

  local id=$1
  require_task_id "$id"
  shift

  local note="$*"
  local db actor
  db=$(db_path_or_die)
  task_exists "$db" "$id" || die "task not found: $id"
  actor=$(current_actor)
  log_event "$db" "$id" "note" "$actor" "$note"
  printf 'Noted task #%s\n' "$id"
}

cmd_prompt() {
  require_sqlite3
  [ "$#" -eq 1 ] || die "usage: cxq prompt <id>"

  local id=$1
  require_task_id "$id"

  local db
  db=$(db_path_or_die)
  task_exists "$db" "$id" || die "task not found: $id"
  render_task_prompt "$db" "$id"
}

cmd_review() {
  require_sqlite3
  [ "$#" -ge 1 ] || die "task id is required."

  local id=$1 summary=""
  require_task_id "$id"
  shift

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --summary)
        [ "$#" -ge 2 ] || die "--summary requires a value."
        summary=$2
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        summary="${summary}${summary:+ }$1"
        shift
        ;;
    esac
  done

  [ -n "$summary" ] || die "review summary is required."

  local db actor
  db=$(db_path_or_die)
  task_exists "$db" "$id" || die "task not found: $id"
  die_if_trashed "$db" "$id"
  actor=$(current_actor)
  sqlite_exec "$db" "UPDATE tasks SET status = 'review', result_summary = $(sql_quote "$summary"), claimed_by = NULL, claimed_at = NULL, lease_until = NULL WHERE id = $id;"
  log_event "$db" "$id" "review" "$actor" "$summary"
  printf 'Moved task #%s to review\n' "$id"
}

# Deliberately narrow: a false warning costs a --force, but a chatty heuristic
# trains people to ignore it. 'todo' alone is not a marker because it is an
# ordinary Spanish word; only the uppercase code marker counts.
summary_mentions_pending_work() {
  local raw=${1-}
  local text
  text=$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')

  case "$raw" in
    *TODO*) return 0 ;;
  esac

  case "$text" in
    *pending*|*pendiente*|*"still needs"*|*"still missing"*|*"not implemented"*|*"no implementado"*|*"sin terminar"*|*"left over"*|*leftover*|*"follow-up"*|*followup*|*falta*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

# Prints the reasons closing this task looks premature. Returns 1 when clean.
done_close_warnings() {
  local db=$1
  local id=$2
  local summary=$3
  local warnings="" open_findings

  if summary_mentions_pending_work "$summary"; then
    warnings="${warnings}${warnings:+; }the summary still mentions pending work"
  fi

  open_findings=$(task_open_finding_count "$db" "$id" 2>/dev/null || printf '0')
  if [[ "$open_findings" =~ ^[0-9]+$ ]] && [ "$open_findings" -gt 0 ]; then
    warnings="${warnings}${warnings:+; }task has $open_findings open finding(s)"
  fi

  if [ -n "$warnings" ]; then
    printf '%s' "$warnings"
    return 0
  fi
  return 1
}

cmd_done() {
  require_sqlite3
  [ "$#" -ge 1 ] || die "task id is required."

  local id=$1 summary="" force=0
  require_task_id "$id"
  shift

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --summary)
        [ "$#" -ge 2 ] || die "--summary requires a value."
        summary=$2
        shift 2
        ;;
      --force|--yes)
        force=1
        shift
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        summary="${summary}${summary:+ }$1"
        shift
        ;;
    esac
  done

  local db actor effective_summary warnings answer old_status next_id next_due
  db=$(db_path_or_die)
  task_exists "$db" "$id" || die "task not found: $id"
  die_if_trashed "$db" "$id"
  actor=$(current_actor)
  old_status=$(sqlite_value "$db" "SELECT status FROM tasks WHERE id = $id;")

  effective_summary=$summary
  if [ -z "$effective_summary" ]; then
    effective_summary=$(sqlite_value "$db" "SELECT result_summary FROM tasks WHERE id = $id;")
  fi

  warnings=$(done_close_warnings "$db" "$id" "$effective_summary" || true)
  if [ -n "$warnings" ] && [ "$force" -ne 1 ]; then
    printf 'Warning: task #%s may not be finished: %s\n' "$id" "$warnings" >&2
    if gate_is_interactive; then
      printf 'Mark task #%s done anyway? [y/N] ' "$id" >&2
      answer=$(gate_read_answer)
      printf '\n' >&2
      case "$answer" in
        y|Y|yes|YES|Yes) ;;
        *) die "task $id was not closed." ;;
      esac
    else
      printf 'Run: cxq done %s --force\n' "$id" >&2
      die "task $id has unfinished work; use --force to close it anyway."
    fi
  fi
  sqlite_exec "$db" "UPDATE tasks SET status = 'done', result_summary = CASE WHEN $(sql_quote "$summary") = '' THEN result_summary ELSE $(sql_quote "$summary") END, claimed_by = NULL, claimed_at = NULL, lease_until = NULL WHERE id = $id;"
  log_event "$db" "$id" "done" "$actor" "$summary"
  printf 'Marked task #%s done\n' "$id"
  # A second `cxq done` on an already-done task must not spawn a duplicate:
  # only a real transition into done creates the next occurrence.
  if [ "$old_status" != "done" ]; then
    next_id=$(maybe_create_next_occurrence "$db" "$id" "$actor")
    if [ -n "$next_id" ]; then
      next_due=$(sqlite_value "$db" "SELECT due_date FROM tasks WHERE id = $next_id;")
      printf 'Created next occurrence #%s (due %s)\n' "$next_id" "$next_due"
    fi
  fi
}

finding_severity_is_valid() {
  case "${1-}" in
    low|medium|high|critical) return 0 ;;
    *) return 1 ;;
  esac
}

finding_status_is_valid() {
  case "${1-}" in
    open|accepted|resolved) return 0 ;;
    *) return 1 ;;
  esac
}

task_open_finding_count() {
  local db=$1
  local id=$2
  sqlite_value "$db" "SELECT COUNT(*) FROM task_findings WHERE task_id = $id AND status = 'open';"
}

render_task_findings() {
  local db=$1
  local id=$2
  local findings

  findings=$(sqlite_query "$db" "SELECT '- #' || id || ' [' || severity || '/' || status || '] ' || replace(note, char(10), ' ') || CASE WHEN followup_task_id IS NOT NULL THEN ' (follow-up #' || followup_task_id || ')' ELSE '' END FROM task_findings WHERE task_id = $id ORDER BY status = 'open' DESC, id ASC;" 2>/dev/null || true)

  [ -n "$findings" ] || return 0
  printf '## Findings\n'
  printf '%s\n' "$findings"
  printf '\n'
}

cmd_finding_add() {
  local id=${1-}
  require_task_id "$id"
  shift

  local severity="medium" status="open" note="" followup=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --severity)
        [ "$#" -ge 2 ] || die "--severity requires a value."
        severity=$2
        shift 2
        ;;
      --status)
        [ "$#" -ge 2 ] || die "--status requires a value."
        status=$2
        shift 2
        ;;
      --note)
        [ "$#" -ge 2 ] || die "--note requires a value."
        note=$2
        shift 2
        ;;
      --followup)
        [ "$#" -ge 2 ] || die "--followup requires a task id."
        followup=$2
        require_task_id "$followup"
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      --*)
        die "unknown finding option: $1"
        ;;
      *)
        note="${note}${note:+ }$1"
        shift
        ;;
    esac
  done

  finding_severity_is_valid "$severity" || die "finding severity must be low, medium, high, or critical."
  finding_status_is_valid "$status" || die "finding status must be open, accepted, or resolved."
  [ -n "$note" ] || die "finding note is required."

  local db actor finding_id followup_sql
  db=$(db_path_or_die)
  task_exists "$db" "$id" || die "task not found: $id"
  if [ -n "$followup" ]; then
    task_exists "$db" "$followup" || die "follow-up task not found: $followup"
    followup_sql="$followup"
  else
    followup_sql="NULL"
  fi

  finding_id=$(sqlite_value "$db" "INSERT INTO task_findings (task_id, severity, status, note, followup_task_id) VALUES ($id, $(sql_quote "$severity"), $(sql_quote "$status"), $(sql_quote "$note"), $followup_sql); SELECT last_insert_rowid();")
  actor=$(current_actor)
  log_event "$db" "$id" "finding_added" "$actor" "[$severity/$status] $note"
  printf 'Added finding #%s to task #%s\n' "$finding_id" "$id"
}

cmd_finding_list() {
  [ "$#" -eq 1 ] || die "usage: cxq finding list <id>"
  local id=$1 db
  require_task_id "$id"
  db=$(db_path_or_die)
  task_exists "$db" "$id" || die "task not found: $id"
  sqlite_table "$db" "SELECT id, severity, status, note, COALESCE(followup_task_id, '') AS followup, created_at FROM task_findings WHERE task_id = $id ORDER BY status = 'open' DESC, id ASC;"
}

cmd_finding_resolve() {
  local finding_id=${1-}
  require_task_id "$finding_id"
  shift

  local status="resolved" note=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --status)
        [ "$#" -ge 2 ] || die "--status requires a value."
        status=$2
        shift 2
        ;;
      --note)
        [ "$#" -ge 2 ] || die "--note requires a value."
        note=$2
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        die "unknown finding resolve option: $1"
        ;;
    esac
  done

  case "$status" in
    accepted|resolved) ;;
    *) die "finding resolve status must be accepted or resolved." ;;
  esac

  local db actor task_id changed
  db=$(db_path_or_die)
  task_id=$(sqlite_value "$db" "SELECT task_id FROM task_findings WHERE id = $finding_id;")
  [ -n "$task_id" ] || die "finding not found: $finding_id"

  changed=$(sqlite_value "$db" "UPDATE task_findings SET status = $(sql_quote "$status"), note = CASE WHEN $(sql_quote "$note") = '' THEN note ELSE note || ' | ' || $(sql_quote "$note") END WHERE id = $finding_id AND status = 'open'; SELECT changes();")
  [ "$changed" = "1" ] || die "finding $finding_id is not open."

  actor=$(current_actor)
  log_event "$db" "$task_id" "finding_closed" "$actor" "finding #$finding_id $status${note:+: $note}"
  printf 'Marked finding #%s as %s\n' "$finding_id" "$status"
}

cmd_finding() {
  require_sqlite3
  local action=${1-}
  case "$action" in
    add)
      shift
      cmd_finding_add "$@"
      ;;
    list)
      shift
      cmd_finding_list "$@"
      ;;
    resolve)
      shift
      cmd_finding_resolve "$@"
      ;;
    ""|--help|-h)
      die "usage: cxq finding add|list|resolve ..."
      ;;
    *)
      die "unknown finding action: $action"
      ;;
  esac
}

cmd_repo() {
  require_sqlite3
  [ "$#" -eq 1 ] || die "usage: cxq repo <id>"

  local id=$1 db repo
  require_task_id "$id"
  db=$(db_path_or_die)
  task_exists "$db" "$id" || die "task not found: $id"
  repo=$(sqlite_value "$db" "SELECT repo_path FROM tasks WHERE id = $id;")
  printf '%s\n' "$repo"
}

cmd_stale() {
  require_sqlite3
  local db
  db=$(db_path_or_die)
  sqlite_table "$db" "SELECT id, status, priority, title, claimed_by, lease_until FROM tasks WHERE status = 'claimed' AND lease_until IS NOT NULL AND lease_until < strftime('%Y-%m-%dT%H:%M:%fZ', 'now') ORDER BY lease_until ASC;"
}

cmd_task_release() {
  require_sqlite3
  [ "$#" -eq 1 ] || die "usage: cxq release <id>"

  local id=$1 db actor changed
  require_task_id "$id"
  db=$(db_path_or_die)
  task_exists "$db" "$id" || die "task not found: $id"
  changed=$(sqlite_value "$db" "UPDATE tasks SET status = 'ready', claimed_by = NULL, claimed_at = NULL, lease_until = NULL WHERE id = $id AND status IN ('claimed', 'blocked'); SELECT changes();")
  if [ "$changed" = "0" ]; then
    die "task $id is not claimed or blocked; run 'cxq status-transitions'."
  fi
  actor=$(current_actor)
  log_event "$db" "$id" "released" "$actor" ""
  printf 'Released task #%s\n' "$id"
}

# --- cxq 0.4.0 additions (inserted before cmd_version_set) ---

valid_due_date() {
  local d=${1-}
  [[ "$d" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || return 1
  local normalized=""
  if date -d "$d" '+%Y-%m-%d' >/dev/null 2>&1; then
    normalized=$(date -d "$d" '+%Y-%m-%d' 2>/dev/null || true)
    [ "$normalized" = "$d" ]
  elif date -j -f '%Y-%m-%d' "$d" '+%Y-%m-%d' >/dev/null 2>&1; then
    normalized=$(date -j -f '%Y-%m-%d' "$d" '+%Y-%m-%d' 2>/dev/null || true)
    [ "$normalized" = "$d" ]
  else
    return 1
  fi
}

valid_recurs() {
  case "${1-}" in
    daily|weekly|monthly) return 0 ;;
    *) return 1 ;;
  esac
}

# Next due date for a recurring task, advanced from its current due date.
# daily +1 day, weekly +7 days, monthly +1 calendar month clamped to the
# last day of the target month (2026-01-31 -> 2026-02-28). Pure SQLite
# date math: portable to macOS, no GNU date flags.
advance_due_date() {
  local due=$1 recurs=$2
  case "$recurs" in
    daily)
      sqlite_value ":memory:" "SELECT date($(sql_quote "$due"), '+1 day');"
      ;;
    weekly)
      sqlite_value ":memory:" "SELECT date($(sql_quote "$due"), '+7 days');"
      ;;
    monthly)
      sqlite_value ":memory:" "SELECT CASE WHEN CAST(strftime('%d', $(sql_quote "$due")) AS INTEGER) <= CAST(strftime('%d', date($(sql_quote "$due"), 'start of month', '+2 months', '-1 day')) AS INTEGER) THEN date($(sql_quote "$due"), 'start of month', '+1 month', '+' || (CAST(strftime('%d', $(sql_quote "$due")) AS INTEGER) - 1) || ' days') ELSE date($(sql_quote "$due"), 'start of month', '+2 months', '-1 day') END;"
      ;;
    *) die "invalid recurrence: $recurs" ;;
  esac
}

# When a recurring task is marked done, create its next occurrence as a
# fresh task: same title/body/priority/tags/files/acceptance, due date
# advanced from the OLD due date, same recurs value, status ready (the
# `cxq add` default). The claim is never inherited, and neither are
# dependencies or the result summary. Prints the new task id, or nothing
# when the task does not recur. Callers must only call this when the task
# actually transitions into done, so a second `cxq done` cannot spawn a
# duplicate. The completed task gets a `recurrence` event noting the id.
maybe_create_next_occurrence() {
  local db=$1 id=$2 actor=$3
  local recurs due next_due title body priority files_json tags_json acceptance verify root branch new_id
  recurs=$(sqlite_value "$db" "SELECT COALESCE(recurs, '') FROM tasks WHERE id = $id;")
  [ -n "$recurs" ] || return 0
  due=$(sqlite_value "$db" "SELECT COALESCE(due_date, '') FROM tasks WHERE id = $id;")
  [ -n "$due" ] || return 0
  next_due=$(advance_due_date "$due" "$recurs")
  title=$(sqlite_value "$db" "SELECT title FROM tasks WHERE id = $id;")
  body=$(sqlite_value "$db" "SELECT body FROM tasks WHERE id = $id;")
  priority=$(sqlite_value "$db" "SELECT priority FROM tasks WHERE id = $id;")
  files_json=$(sqlite_value "$db" "SELECT allowed_paths_json FROM tasks WHERE id = $id;")
  tags_json=$(sqlite_value "$db" "SELECT tags_json FROM tasks WHERE id = $id;")
  acceptance=$(sqlite_value "$db" "SELECT acceptance FROM tasks WHERE id = $id;")
  verify=$(sqlite_value "$db" "SELECT verify_command FROM tasks WHERE id = $id;")
  root=$(sqlite_value "$db" "SELECT repo_path FROM tasks WHERE id = $id;")
  branch=$(sqlite_value "$db" "SELECT COALESCE(branch, '') FROM tasks WHERE id = $id;")
  new_id=$(sqlite_value "$db" "INSERT INTO tasks (title, body, status, priority, due_date, recurs, repo_path, branch, allowed_paths_json, tags_json, acceptance, verify_command) VALUES ($(sql_quote "$title"), $(sql_quote "$body"), 'ready', $priority, $(sql_quote "$next_due"), $(sql_quote "$recurs"), $(sql_quote "$root"), $(sql_quote "$branch"), $(sql_quote "$files_json"), $(sql_quote "$tags_json"), $(sql_quote "$acceptance"), $(sql_quote "$verify")); SELECT last_insert_rowid();")
  log_event "$db" "$new_id" "created" "$actor" "$title"
  log_event "$db" "$id" "recurrence" "$actor" "next occurrence #$new_id (due $next_due, recurs $recurs)"
  printf '%s' "$new_id"
}

like_escape() {
  local value=${1-}
  value=${value//\\/\\\\}
  value=${value//%/\\%}
  value=${value//_/\\_}
  printf '%s' "$value"
}

# CSV (comma-separated) values stored as a JSON array in a task column.
task_json_csv() {
  local db=$1
  local id=$2
  local column=$3
  sqlite_query "$db" "SELECT COALESCE(group_concat(value, ','), '') FROM json_each((SELECT $column FROM tasks WHERE id = $id));"
}

csv_add() {
  local csv=${1-}
  local val=${2-}
  [ -n "$val" ] || { printf '%s' "$csv"; return 0; }
  if [ -z "$csv" ]; then
    printf '%s' "$val"
    return 0
  fi
  case ",$csv," in
    *",$val,"*) printf '%s' "$csv" ;;
    *) printf '%s,%s' "$csv" "$val" ;;
  esac
}

csv_remove() {
  local csv=${1-}
  local val=${2-}
  local out="" part
  local parts=()
  if [ -n "$csv" ]; then
    IFS=',' read -r -a parts <<<"$csv"
    for part in "${parts[@]}"; do
      part=$(trim "$part")
      [ -n "$part" ] || continue
      [ "$part" = "$val" ] && continue
      out="${out}${out:+,}$part"
    done
  fi
  printf '%s' "$out"
}

db_schema_version() {
  local db=$1
  local v
  v=$(sqlite_value "$db" "SELECT value FROM cxq_meta WHERE key = 'schema_version';" 2>/dev/null || true)
  [[ "$v" =~ ^[0-9]+$ ]] || v=0
  printf '%s' "$v"
}

# Bring a queue DB up to the current schema (v6). Idempotent, preserves data.
# Prints a one-line notice to stderr when it actually migrates.
migrate_db() {
  local db=$1
  local before has_due has_recurs table_sql
  before=$(db_schema_version "$db")
  if [ "$before" -ge "$CXQ_REPO_SCHEMA_VERSION" ]; then
    return 0
  fi
  # Add the column BEFORE applying the v4 schema: schema_sql creates an
  # index on due_date, which fails on a v3 table that lacks the column.
  has_due=$(sqlite_value "$db" "SELECT COUNT(*) FROM pragma_table_info('tasks') WHERE name = 'due_date';" 2>/dev/null || printf '0')
  if [ "$has_due" = "0" ]; then
    sqlite_exec "$db" "ALTER TABLE tasks ADD COLUMN due_date TEXT;"
  fi
  # v6 adds the recurs column (plain TEXT, validated in code, so no table
  # rebuild is needed the way the v5 CHECK change required).
  has_recurs=$(sqlite_value "$db" "SELECT COUNT(*) FROM pragma_table_info('tasks') WHERE name = 'recurs';" 2>/dev/null || printf '0')
  if [ "$has_recurs" = "0" ]; then
    sqlite_exec "$db" "ALTER TABLE tasks ADD COLUMN recurs TEXT;"
  fi
  # v5 adds the 'trashed' status, which needs a new CHECK constraint, and
  # SQLite cannot ALTER a CHECK. Rebuild the tasks table in place (same
  # ids, same rows); the trigger and indexes are recreated by schema_sql
  # below. A missing tasks table (fresh DB) is created by schema_sql.
  table_sql=$(sqlite_value "$db" "SELECT sql FROM sqlite_master WHERE type = 'table' AND name = 'tasks';" 2>/dev/null || true)
  case "$table_sql" in
    *trashed*) ;;
    *CREATE\ TABLE\ tasks*)
      sqlite_exec "$db" "DROP TRIGGER IF EXISTS trg_tasks_updated_at;"
      sqlite_exec "$db" "ALTER TABLE tasks RENAME TO tasks_migrate_old;"
      sqlite_exec "$db" "$(tasks_table_sql)"
      sqlite_exec "$db" "INSERT INTO tasks (id, title, body, status, priority, due_date, repo_path, branch, allowed_paths_json, tags_json, deps_json, acceptance, verify_command, claimed_by, claimed_at, lease_until, result_summary, transcript_path, created_at, updated_at, trashed_from_status, trashed_at) SELECT id, title, body, status, priority, due_date, repo_path, branch, allowed_paths_json, tags_json, deps_json, acceptance, verify_command, claimed_by, claimed_at, lease_until, result_summary, transcript_path, created_at, updated_at, NULL, NULL FROM tasks_migrate_old;"
      sqlite_exec "$db" "DROP TABLE tasks_migrate_old;"
      ;;
  esac
  sqlite_run "$db" "$(schema_sql)" >/dev/null
  sqlite_exec "$db" "CREATE INDEX IF NOT EXISTS idx_tasks_due ON tasks(due_date); INSERT OR REPLACE INTO cxq_meta (key, value) VALUES ('schema_version', '$CXQ_REPO_SCHEMA_VERSION');"
  printf 'cxq: migrated queue schema v%s -> v%s\n' "$before" "$CXQ_REPO_SCHEMA_VERSION" >&2
}

# Auto-migrate on open (skipped for `cxq migrate`, which reports itself).
migrate_db_if_needed() {
  local db=$1
  [ "${CXQ_SKIP_AUTO_MIGRATE:-}" = "1" ] && return 0
  migrate_db "$db"
}

cmd_migrate() {
  require_sqlite3
  [ "$#" -eq 0 ] || die "migrate does not accept arguments."
  local root db before after schema_file new_schema
  root=$(project_root_or_die)
  db=$(db_path_or_die)
  before=$(db_schema_version "$db")
  migrate_db "$db"
  after=$(db_schema_version "$db")
  schema_file="$root/.cxq/tasks.schema.sql"
  new_schema=$(schema_sql)
  if [ ! -f "$schema_file" ]; then
    printf '%s' "$new_schema" >"$schema_file"
    printf 'Created: .cxq/tasks.schema.sql (schema v%s)\n' "$after"
  elif grep -q "schema_version', '1'" "$schema_file" || grep -q "schema_version', '3'" "$schema_file"; then
    # Old stock template (v1 file shipped with the repo, or a v3-era file):
    # not a user customization, safe to refresh in place.
    printf '%s' "$new_schema" >"$schema_file"
    printf 'Updated: .cxq/tasks.schema.sql to schema v%s\n' "$after"
  elif ! cmp -s <(printf '%s' "$new_schema") "$schema_file"; then
    printf '%s' "$new_schema" >"$schema_file.new"
    printf 'Left customized schema file unchanged; new template written to .cxq/tasks.schema.sql.new\n'
  fi
  printf 'Migrated schema v%s -> v%s\n' "$before" "$after"
  printf 'Database: %s\n' "$db"
}

render_task_edit_history() {
  local db=$1
  local id=$2
  local edits
  edits=$(sqlite_query "$db" "SELECT '- ' || created_at || ' by ' || actor || ': ' || replace(note, char(10), ' ') FROM task_events WHERE task_id = $id AND event_type = 'edited' ORDER BY created_at DESC, id DESC LIMIT 20;")
  printf '## Edit history\n'
  if [ -n "$edits" ]; then
    printf '%s\n' "$edits"
  else
    printf 'None\n'
  fi
  printf '\n'
}

cmd_edit() {
  require_sqlite3
  [ "$#" -ge 1 ] || die "usage: cxq edit <id> [--title ...] [--status ...] [...]"

  local id=$1
  require_task_id "$id"
  shift

  local new_title="" new_body="" new_priority="" new_status="" new_acceptance=""
  local new_verify="" new_branch="" new_due="" new_due_set=0 new_recurs="" new_recurs_set=0 reason=""
  local files_set="" files_add="" files_remove="" tags_set="" tags_add="" tags_remove=""
  local have_flag=0
  local _cxq_parts=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --title) [ "$#" -ge 2 ] || die "--title requires a value."; new_title=$2; have_flag=1; shift 2 ;;
      --body) [ "$#" -ge 2 ] || die "--body requires a value."; new_body=$2; have_flag=1; shift 2 ;;
      --priority) [ "$#" -ge 2 ] || die "--priority requires a value."; new_priority=$2; have_flag=1; shift 2 ;;
      --status) [ "$#" -ge 2 ] || die "--status requires a value."; new_status=$2; have_flag=1; shift 2 ;;
      --acceptance) [ "$#" -ge 2 ] || die "--acceptance requires a value."; new_acceptance=$2; have_flag=1; shift 2 ;;
      --verify|--verify-command) [ "$#" -ge 2 ] || die "$1 requires a value."; new_verify=$2; have_flag=1; shift 2 ;;
      --branch) [ "$#" -ge 2 ] || die "--branch requires a value."; new_branch=$2; have_flag=1; shift 2 ;;
      --due) [ "$#" -ge 2 ] || die "--due requires a value."; new_due=$2; new_due_set=1; have_flag=1; shift 2 ;;
      --due-clear) new_due=""; new_due_set=1; have_flag=1; shift ;;
      --recurs) [ "$#" -ge 2 ] || die "--recurs requires a value."; new_recurs=$2; new_recurs_set=1; have_flag=1; shift 2 ;;
      --reason) [ "$#" -ge 2 ] || die "--reason requires a value."; reason=$2; shift 2 ;;
      --files|--allowed-paths) [ "$#" -ge 2 ] || die "$1 requires a value."; files_set=$2; have_flag=1; shift 2 ;;
      --files-add) [ "$#" -ge 2 ] || die "--files-add requires a value."; files_add=$2; have_flag=1; shift 2 ;;
      --files-remove) [ "$#" -ge 2 ] || die "--files-remove requires a value."; files_remove=$2; have_flag=1; shift 2 ;;
      --tags) [ "$#" -ge 2 ] || die "--tags requires a value."; tags_set=$2; have_flag=1; shift 2 ;;
      --tags-add) [ "$#" -ge 2 ] || die "--tags-add requires a value."; tags_add=$2; have_flag=1; shift 2 ;;
      --tags-remove) [ "$#" -ge 2 ] || die "--tags-remove requires a value."; tags_remove=$2; have_flag=1; shift 2 ;;
      --help|-h) usage; exit 0 ;;
      --*) die "unknown edit option: $1" ;;
      *) die "unknown edit argument: $1" ;;
    esac
  done
  [ "$have_flag" -eq 1 ] || die "cxq edit requires at least one change flag (see --help)."

  if [ -n "$new_priority" ]; then
    [[ "$new_priority" =~ ^[0-9]+$ ]] || die "priority must be an integer."
  fi
  if [ "$new_due_set" -eq 1 ] && [ -n "$new_due" ]; then
    valid_due_date "$new_due" || die "due date must be a valid YYYY-MM-DD date."
  fi
  if [ "$new_recurs_set" -eq 1 ] && [ "$new_recurs" != "none" ]; then
    valid_recurs "$new_recurs" || die "invalid recurrence: $new_recurs (expected daily, weekly, monthly, or none)."
  fi
  if [ -n "$new_status" ]; then
    status_is_valid "$new_status" || die "invalid status: $new_status"
    [ "$new_status" != "trashed" ] || die "cannot move a task to 'trashed' with edit; use 'cxq delete <id>' to trash it."
  fi

  local db actor next_id next_due
  db=$(db_path_or_die)
  task_exists "$db" "$id" || die "task not found: $id"
  actor=$(current_actor)

  local old_title old_body old_priority old_status old_acceptance old_verify old_branch old_due old_recurs old_files old_tags
  old_title=$(sqlite_value "$db" "SELECT title FROM tasks WHERE id = $id;")
  old_body=$(sqlite_value "$db" "SELECT body FROM tasks WHERE id = $id;")
  old_priority=$(sqlite_value "$db" "SELECT priority FROM tasks WHERE id = $id;")
  old_status=$(sqlite_value "$db" "SELECT status FROM tasks WHERE id = $id;")
  old_acceptance=$(sqlite_value "$db" "SELECT acceptance FROM tasks WHERE id = $id;")
  old_verify=$(sqlite_value "$db" "SELECT verify_command FROM tasks WHERE id = $id;")
  old_branch=$(sqlite_value "$db" "SELECT COALESCE(branch, '') FROM tasks WHERE id = $id;")
  old_due=$(sqlite_value "$db" "SELECT COALESCE(due_date, '') FROM tasks WHERE id = $id;")
  old_recurs=$(sqlite_value "$db" "SELECT COALESCE(recurs, '') FROM tasks WHERE id = $id;")
  old_files=$(task_json_csv "$db" "$id" "allowed_paths_json")
  old_tags=$(task_json_csv "$db" "$id" "tags_json")
  [ "$old_status" != "trashed" ] || die "task $id is trashed; restore it first with 'cxq restore $id'."
  # A recurring task must always have a due date: the next occurrence is
  # advanced from it. This covers --recurs on a dateless task and
  # --due-clear on a recurring one.
  local eff_recurs eff_due
  if [ "$new_recurs_set" -eq 1 ]; then
    [ "$new_recurs" = "none" ] && eff_recurs="" || eff_recurs="$new_recurs"
  else
    eff_recurs="$old_recurs"
  fi
  if [ "$new_due_set" -eq 1 ]; then eff_due="$new_due"; else eff_due="$old_due"; fi
  [ -n "$eff_recurs" ] && [ -z "$eff_due" ] && die "recurring tasks require a due date (--due YYYY-MM-DD)."
  # The claim fields are cleared when an edit changes the status; keep the
  # old ones so `cxq undo` can put the claim back.
  local old_claimed_by old_claimed_at old_lease_until
  old_claimed_by=$(sqlite_value "$db" "SELECT COALESCE(claimed_by, '') FROM tasks WHERE id = $id;")
  old_claimed_at=$(sqlite_value "$db" "SELECT COALESCE(claimed_at, '') FROM tasks WHERE id = $id;")
  old_lease_until=$(sqlite_value "$db" "SELECT COALESCE(lease_until, '') FROM tasks WHERE id = $id;")

  # Resolve --files/--tags set/add/remove into final CSV values.
  local final_files="$old_files" final_tags="$old_tags"
  if [ -n "$files_set" ]; then final_files="$files_set"; fi
  if [ -n "$files_add" ]; then
    local part
    IFS=',' read -r -a _cxq_parts <<<"$files_add"
    for part in "${_cxq_parts[@]}"; do final_files=$(csv_add "$final_files" "$(trim "$part")"); done
  fi
  if [ -n "$files_remove" ]; then
    local part
    IFS=',' read -r -a _cxq_parts <<<"$files_remove"
    for part in "${_cxq_parts[@]}"; do final_files=$(csv_remove "$final_files" "$(trim "$part")"); done
  fi
  if [ -n "$tags_set" ]; then final_tags="$tags_set"; fi
  if [ -n "$tags_add" ]; then
    local part
    IFS=',' read -r -a _cxq_parts <<<"$tags_add"
    for part in "${_cxq_parts[@]}"; do final_tags=$(csv_add "$final_tags" "$(trim "$part")"); done
  fi
  if [ -n "$tags_remove" ]; then
    local part
    IFS=',' read -r -a _cxq_parts <<<"$tags_remove"
    for part in "${_cxq_parts[@]}"; do final_tags=$(csv_remove "$final_tags" "$(trim "$part")"); done
  fi

  if [ -n "$new_status" ] && [ "$new_status" != "$old_status" ]; then
    if [ "$new_status" = "claimed" ]; then
      die "use 'cxq claim <id>' to claim a task (a claim needs an agent and a lease)."
    fi
    transition_allows "$old_status" "$new_status" ||
      die "cannot move task $id from $old_status to $new_status; run 'cxq status-transitions'."
    case "$old_status" in
      review|done)
        [ -n "$reason" ] || die "moving a task out of $old_status requires --reason."
        ;;
    esac
  fi

  local sets="" diffs="" disp_old disp_new changed_fields=()
  add_change() {
    local field=$1 old=$2 new=$3 sql_value=$4
    [ "$old" != "$new" ] || return 0
    disp_old=${old:-"(empty)"}
    disp_new=${new:-"(empty)"}
    diffs="${diffs}${diffs:+; }$field: $disp_old -> $disp_new"
    sets="${sets}${sets:+, }$field = $sql_value"
    changed_fields+=("$field")
  }
  sets=""; diffs=""
  [ -n "$new_title" ] && add_change "title" "$old_title" "$new_title" "$(sql_quote "$new_title")"
  [ -n "$new_body" ] || new_body="$old_body"
  # body may legitimately be set to an empty string only via explicit flag;
  # bash cannot distinguish here, so --body "" is treated as no change.
  if [ "$new_body" != "$old_body" ]; then add_change "body" "$old_body" "$new_body" "$(sql_quote "$new_body")"; fi
  [ -n "$new_priority" ] && add_change "priority" "$old_priority" "$new_priority" "$new_priority"
  if [ -n "$new_status" ] && [ "$new_status" != "$old_status" ]; then
    add_change "status" "$old_status" "$new_status" "$(sql_quote "$new_status")"
    case "$new_status" in
      ready|inbox|blocked|done)
        sets="${sets}${sets:+, }claimed_by = NULL, claimed_at = NULL, lease_until = NULL"
        ;;
    esac
    if [ -n "$reason" ]; then
      diffs="${diffs} (reason: $reason)"
    fi
  fi
  if [ "$new_acceptance" != "$old_acceptance" ] && { [ -n "$new_acceptance" ] || [ "$new_acceptance" != "$old_acceptance" ]; }; then
    # Only record when the flag was passed; --acceptance "" is ambiguous, skip empty.
    [ -n "$new_acceptance" ] && add_change "acceptance" "$old_acceptance" "$new_acceptance" "$(sql_quote "$new_acceptance")"
  fi
  [ -n "$new_verify" ] && add_change "verify_command" "$old_verify" "$new_verify" "$(sql_quote "$new_verify")"
  [ -n "$new_branch" ] && add_change "branch" "$old_branch" "$new_branch" "$(sql_quote "$new_branch")"
  if [ "$new_due_set" -eq 1 ]; then
    if [ -n "$new_due" ]; then
      add_change "due_date" "$old_due" "$new_due" "$(sql_quote "$new_due")"
    elif [ -n "$old_due" ]; then
      diffs="${diffs}${diffs:+; }due_date: $old_due -> (empty)"
      sets="${sets}${sets:+, }due_date = NULL"
      changed_fields+=("due_date")
    fi
  fi
  if [ "$new_recurs_set" -eq 1 ]; then
    if [ "$new_recurs" = "none" ]; then
      if [ -n "$old_recurs" ]; then
        diffs="${diffs}${diffs:+; }recurs: $old_recurs -> (empty)"
        sets="${sets}${sets:+, }recurs = NULL"
        changed_fields+=("recurs")
      fi
    else
      add_change "recurs" "$old_recurs" "$new_recurs" "$(sql_quote "$new_recurs")"
    fi
  fi
  if [ "$final_files" != "$old_files" ]; then
    add_change "allowed_paths" "$old_files" "$final_files" "$(sql_quote "$(csv_to_json_array "$final_files")")"
    # add_change used the field name for the column; fix the column name.
    sets=${sets//allowed_paths = /allowed_paths_json = }
  fi
  if [ "$final_tags" != "$old_tags" ]; then
    add_change "tags" "$old_tags" "$final_tags" "$(sql_quote "$(csv_to_json_array "$final_tags")")"
    sets=${sets//tags = /tags_json = }
  fi

  [ -n "$diffs" ] || die "cxq edit made no changes to task $id (new values match the current ones)."

  # Undo data: the previous values of exactly the fields this edit changed,
  # stored as JSON in the 'edited' event so `cxq undo` can revert it.
  # Strings are JSON-escaped, priority is a number, due_date/branch and the
  # claim fields are null when empty (NULL in the row), and the JSON arrays
  # are stored verbatim.
  local undo_json="{" undo_sep="" undo_field
  undo_pair() {
    undo_json="${undo_json}${undo_sep}\"$1\":$2"
    undo_sep=","
  }
  for undo_field in "${changed_fields[@]}"; do
    case "$undo_field" in
      title) undo_pair "title" "\"$(json_escape "$old_title")\"" ;;
      body) undo_pair "body" "\"$(json_escape "$old_body")\"" ;;
      priority) undo_pair "priority" "$old_priority" ;;
      status)
        undo_pair "status" "\"$(json_escape "$old_status")\""
        undo_pair "claimed_by" "$(json_string_or_null "$old_claimed_by")"
        undo_pair "claimed_at" "$(json_string_or_null "$old_claimed_at")"
        undo_pair "lease_until" "$(json_string_or_null "$old_lease_until")"
        ;;
      acceptance) undo_pair "acceptance" "\"$(json_escape "$old_acceptance")\"" ;;
      verify_command) undo_pair "verify_command" "\"$(json_escape "$old_verify")\"" ;;
      branch) undo_pair "branch" "$(json_string_or_null "$old_branch")" ;;
      due_date) undo_pair "due_date" "$(json_string_or_null "$old_due")" ;;
      recurs) undo_pair "recurs" "$(json_string_or_null "$old_recurs")" ;;
      allowed_paths) undo_pair "allowed_paths" "$(csv_to_json_array "$old_files")" ;;
      tags) undo_pair "tags" "$(csv_to_json_array "$old_tags")" ;;
    esac
  done
  undo_json="${undo_json}}"

  sqlite_exec "$db" "UPDATE tasks SET $sets WHERE id = $id;"
  log_event "$db" "$id" "edited" "$actor" "$diffs" "$undo_json"
  printf 'Edited task #%s: %s\n' "$id" "$diffs"
  if [ "$old_status" != "done" ] && [ "$new_status" = "done" ]; then
    next_id=$(maybe_create_next_occurrence "$db" "$id" "$actor")
    if [ -n "$next_id" ]; then
      next_due=$(sqlite_value "$db" "SELECT due_date FROM tasks WHERE id = $next_id;")
      printf 'Created next occurrence #%s (due %s)\n' "$next_id" "$next_due"
    fi
  fi
}

# Delete moves the task to trash instead of removing the row, so it can be
# restored with `cxq restore`. --force is still required: without it a TTY
# asks for confirmation and a non-interactive run refuses. Only
# `cxq trash purge` permanently deletes trashed tasks. Events, findings,
# and dependencies are kept, so a restore brings the whole task back.
cmd_delete() {
  require_sqlite3
  [ "$#" -ge 1 ] || die "usage: cxq delete <id> [--force]"

  local id=$1 force=0
  require_task_id "$id"
  shift
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --force|--yes) force=1; shift ;;
      --help|-h) usage; exit 0 ;;
      *) die "unknown delete option: $1" ;;
    esac
  done

  local db actor status
  db=$(db_path_or_die)
  task_exists "$db" "$id" || die "task not found: $id"
  status=$(sqlite_value "$db" "SELECT status FROM tasks WHERE id = $id;")
  [ "$status" != "trashed" ] || die "task $id is already trashed; use 'cxq trash purge' to delete it permanently."
  if [ "$force" -ne 1 ]; then
    if gate_is_interactive; then
      local answer
      printf 'Move task #%s (%s) to trash? Restore it later with %s. [y/N] ' "$id" "$status" "'cxq restore $id'" >&2
      answer=$(gate_read_answer)
      printf '\n' >&2
      case "$answer" in
        y|Y|yes|YES|Yes) ;;
        *) die "task $id was not deleted." ;;
      esac
    else
      die "deleting task $id requires --force in non-interactive mode."
    fi
  fi
  actor=$(current_actor)
  sqlite_exec "$db" "UPDATE tasks SET status = 'trashed', trashed_from_status = $(sql_quote "$status"), trashed_at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now'), claimed_by = NULL, claimed_at = NULL, lease_until = NULL WHERE id = $id;"
  log_event "$db" "$id" "trashed" "$actor" "trashed from $status; restore with 'cxq restore $id'"
  printf 'Trashed task #%s (was %s). Restore with %s.\n' "$id" "$status" "'cxq restore $id'"
}

cmd_restore() {
  require_sqlite3
  [ "$#" -ge 1 ] || die "usage: cxq restore <id>"

  local id=$1
  require_task_id "$id"
  shift
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --help|-h) usage; exit 0 ;;
      *) die "unknown restore option: $1" ;;
    esac
  done

  local db actor status from
  db=$(db_path_or_die)
  task_exists "$db" "$id" || die "task not found: $id"
  status=$(sqlite_value "$db" "SELECT status FROM tasks WHERE id = $id;")
  [ "$status" = "trashed" ] || die "task $id is not trashed (status: $status)."
  from=$(sqlite_value "$db" "SELECT COALESCE(trashed_from_status, '') FROM tasks WHERE id = $id;")
  # A trashed claim lost its agent and lease when trashed, so a task that
  # was claimed lands back on 'ready' instead of 'claimed'.
  if [ -z "$from" ] || [ "$from" = "claimed" ]; then
    from="ready"
  fi
  actor=$(current_actor)
  sqlite_exec "$db" "UPDATE tasks SET status = $(sql_quote "$from"), trashed_from_status = NULL, trashed_at = NULL WHERE id = $id;"
  log_event "$db" "$id" "restored" "$actor" "restored to $from"
  printf 'Restored task #%s to %s\n' "$id" "$from"
}

# Revert the most recent edit of a task, using the previous values stored
# in the 'edited' event. Each invocation reverts one edit; a second
# invocation reverts the edit before that. An edit made before undo support
# (no previous values recorded) cannot be undone.
cmd_undo() {
  require_sqlite3
  [ "$#" -ge 1 ] || die "usage: cxq undo <id>"

  local id=$1
  require_task_id "$id"
  shift
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --help|-h) usage; exit 0 ;;
      *) die "unknown undo option: $1" ;;
    esac
  done

  local db actor status edit_id data_json
  db=$(db_path_or_die)
  task_exists "$db" "$id" || die "task not found: $id"
  status=$(sqlite_value "$db" "SELECT status FROM tasks WHERE id = $id;")
  [ "$status" != "trashed" ] || die "task $id is trashed; restore it first with 'cxq restore $id'."
  actor=$(current_actor)
  # The most recent edit that has not been undone yet. Each 'undone' event
  # records the edit it reverted, so a second undo walks back to the edit
  # before it instead of finding nothing.
  edit_id=$(sqlite_value "$db" "SELECT e.id FROM task_events e WHERE e.task_id = $id AND e.event_type = 'edited' AND NOT EXISTS (SELECT 1 FROM task_events u WHERE u.task_id = $id AND u.event_type = 'undone' AND CAST(json_extract(u.data_json, '\$.undid_edit_id') AS INTEGER) = e.id) ORDER BY e.id DESC LIMIT 1;")
  [ -n "$edit_id" ] || die "task $id has nothing to undo."
  data_json=$(sqlite_value "$db" "SELECT data_json FROM task_events WHERE id = $edit_id;")
  if [ -z "$data_json" ] || [ "$data_json" = "{}" ]; then
    die "the last edit of task $id cannot be undone (no previous values recorded)."
  fi

  local sets="" reverted=""
  # Append "column = <previous value>" to $sets when the edit stored a
  # previous value for $2; $3 is text|int|nullable-text|json. A missing key
  # means the edit did not touch that field.
  undo_field() {
    local column=$1 key=$2 kind=$3 jtype value
    jtype=$(sqlite_value "$db" "SELECT json_type(data_json, '\$.$key') FROM task_events WHERE id = $edit_id;")
    [ -n "$jtype" ] || return 0
    case "$kind" in
      text|json)
        value=$(sqlite_value "$db" "SELECT json_extract(data_json, '\$.$key') FROM task_events WHERE id = $edit_id;")
        sets="${sets}${sets:+, }$column = $(sql_quote "$value")"
        ;;
      int)
        value=$(sqlite_value "$db" "SELECT json_extract(data_json, '\$.$key') FROM task_events WHERE id = $edit_id;")
        [[ "$value" =~ ^[0-9]+$ ]] || die "cannot undo task $id: stored $key is not an integer."
        sets="${sets}${sets:+, }$column = $value"
        ;;
      nullable-text)
        if [ "$jtype" = "null" ]; then
          sets="${sets}${sets:+, }$column = NULL"
        else
          value=$(sqlite_value "$db" "SELECT json_extract(data_json, '\$.$key') FROM task_events WHERE id = $edit_id;")
          sets="${sets}${sets:+, }$column = $(sql_quote "$value")"
        fi
        ;;
    esac
    reverted="${reverted}${reverted:+, }$key"
  }
  undo_field "title" "title" "text"
  undo_field "body" "body" "text"
  undo_field "priority" "priority" "int"
  undo_field "status" "status" "text"
  undo_field "acceptance" "acceptance" "text"
  undo_field "verify_command" "verify_command" "text"
  undo_field "branch" "branch" "nullable-text"
  undo_field "due_date" "due_date" "nullable-text"
  undo_field "recurs" "recurs" "nullable-text"
  undo_field "allowed_paths_json" "allowed_paths" "json"
  undo_field "tags_json" "tags" "json"
  undo_field "claimed_by" "claimed_by" "nullable-text"
  undo_field "claimed_at" "claimed_at" "nullable-text"
  undo_field "lease_until" "lease_until" "nullable-text"
  [ -n "$sets" ] || die "the last edit of task $id cannot be undone (no previous values recorded)."
  sqlite_exec "$db" "UPDATE tasks SET $sets WHERE id = $id;"
  log_event "$db" "$id" "undone" "$actor" "undid edit: $reverted" "{\"undid_edit_id\":$edit_id}"
  printf 'Undid last edit of task #%s: %s\n' "$id" "$reverted"
}

# `cxq trash` lists trashed tasks. `cxq trash purge` permanently deletes
# them: by default only those trashed more than 30 days ago (--days N
# changes the age), --all ignores age. Purged tasks are gone for real:
# the row, its events, findings, and dependencies are deleted.
cmd_trash() {
  require_sqlite3
  local db count
  db=$(db_path_or_die)
  if [ "$#" -eq 0 ]; then
    count=$(sqlite_value "$db" "SELECT COUNT(*) FROM tasks WHERE status = 'trashed';")
    printf '# cxq trash\n\n'
    if [ "$count" = "0" ]; then
      printf '(empty)\n'
      return 0
    fi
    sqlite_table "$db" "SELECT id, priority, title, COALESCE(trashed_from_status, '') AS trashed_from, COALESCE(trashed_at, '') AS trashed_at FROM tasks WHERE status = 'trashed' ORDER BY trashed_at ASC, id ASC;"
    return 0
  fi
  case "$1" in
    purge) shift; cmd_trash_purge "$db" "$@" ;;
    --help|-h) usage; exit 0 ;;
    *) die "unknown trash command: $1 (see 'cxq trash purge')" ;;
  esac
}

cmd_trash_purge() {
  local db=$1 days=30 all=0
  shift
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --days)
        [ "$#" -ge 2 ] || die "--days requires a value."
        days=$2
        shift 2
        ;;
      --all) all=1; shift ;;
      --help|-h) usage; exit 0 ;;
      *) die "unknown trash purge option: $1" ;;
    esac
  done
  [[ "$days" =~ ^[0-9]+$ ]] || die "--days must be a non-negative integer."
  local count where
  if [ "$all" -eq 1 ]; then
    where="status = 'trashed'"
  else
    where="status = 'trashed' AND trashed_at < strftime('%Y-%m-%dT%H:%M:%fZ', 'now', '-$days days')"
  fi
  count=$(sqlite_value "$db" "SELECT COUNT(*) FROM tasks WHERE $where;")
  if [ "$count" != "0" ]; then
    sqlite_exec "$db" "DELETE FROM task_events WHERE task_id IN (SELECT id FROM tasks WHERE $where); DELETE FROM task_findings WHERE task_id IN (SELECT id FROM tasks WHERE $where); DELETE FROM task_dependencies WHERE task_id IN (SELECT id FROM tasks WHERE $where) OR blocker_task_id IN (SELECT id FROM tasks WHERE $where); DELETE FROM tasks WHERE $where;"
  fi
  printf 'Purged %s trashed task(s)\n' "$count"
}

cmd_board() {
  require_sqlite3
  local db status count rows
  db=$(db_path_or_die)
  printf '# cxq board\n\n'
  for status in inbox ready claimed blocked review "done" wontfix; do
    count=$(sqlite_value "$db" "SELECT COUNT(*) FROM tasks WHERE status = '$status';")
    printf '## %s (%s)\n' "$status" "$count"
    rows=$(sqlite_query "$db" "SELECT '# ' || id || ' [P' || priority || '] ' || title || CASE WHEN due_date IS NOT NULL AND due_date < date('now') AND status NOT IN ('done', 'wontfix') THEN ' OVERDUE (due ' || due_date || ')' WHEN due_date IS NOT NULL THEN ' due ' || due_date ELSE '' END || CASE WHEN status = 'claimed' AND lease_until IS NOT NULL AND lease_until < strftime('%Y-%m-%dT%H:%M:%fZ', 'now') THEN ' LEASE EXPIRED' ELSE '' END || CASE WHEN claimed_by IS NOT NULL AND claimed_by <> '' THEN ' -- ' || claimed_by ELSE '' END FROM tasks WHERE status = '$status' ORDER BY priority DESC, created_at ASC;")
    if [ -n "$rows" ]; then
      printf '%s\n' "$rows"
    else
      printf '(empty)\n'
    fi
    printf '\n'
  done
}

cmd_stats() {
  require_sqlite3
  local db total overdue stale oldest done7 status count
  db=$(db_path_or_die)
  total=$(sqlite_value "$db" "SELECT COUNT(*) FROM tasks;")
  printf 'tasks_total: %s\n' "$total"
  for status in inbox ready claimed blocked review "done" wontfix trashed; do
    count=$(sqlite_value "$db" "SELECT COUNT(*) FROM tasks WHERE status = '$status';")
    printf 'status_%s: %s\n' "$status" "$count"
  done
  overdue=$(sqlite_value "$db" "SELECT COUNT(*) FROM tasks WHERE due_date IS NOT NULL AND due_date < date('now') AND status NOT IN ('done', 'wontfix', 'trashed');")
  printf 'overdue: %s\n' "$overdue"
  stale=$(sqlite_value "$db" "SELECT COUNT(*) FROM tasks WHERE status = 'review' AND updated_at < strftime('%Y-%m-%dT%H:%M:%fZ', 'now', '-24 hours');")
  printf 'stale_reviews: %s\n' "$stale"
  oldest=$(sqlite_query "$db" "SELECT '#' || id || ' ' || title || ' (created ' || created_at || ')' FROM tasks WHERE status = 'ready' ORDER BY created_at ASC LIMIT 1;")
  printf 'oldest_ready: %s\n' "${oldest:-none}"
  done7=$(sqlite_value "$db" "SELECT COUNT(*) FROM tasks WHERE status = 'done' AND updated_at >= strftime('%Y-%m-%dT%H:%M:%fZ', 'now', '-7 days');")
  printf 'done_last_7d: %s\n' "$done7"
  printf 'top_blockers:\n'
  local blockers
  blockers=$(sqlite_query "$db" "SELECT '- #' || t.id || ' ' || t.title || ' blocks ' || COUNT(*) || ' task(s)' FROM task_dependencies td JOIN tasks t ON t.id = td.blocker_task_id GROUP BY t.id ORDER BY COUNT(*) DESC, t.id ASC LIMIT 5;")
  if [ -n "$blockers" ]; then
    printf '%s\n' "$blockers"
  else
    printf 'none\n'
  fi
}

cmd_activity() {
  require_sqlite3
  local limit=20
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --limit) [ "$#" -ge 2 ] || die "--limit requires a value."; limit=$2; shift 2 ;;
      --help|-h) usage; exit 0 ;;
      *) die "unknown activity option: $1" ;;
    esac
  done
  [[ "$limit" =~ ^[0-9]+$ ]] || die "--limit must be an integer."
  local db
  db=$(db_path_or_die)
  sqlite_table "$db" "SELECT created_at, task_id, event_type, actor, replace(note, char(10), ' ') AS note FROM task_events ORDER BY created_at DESC, id DESC LIMIT $limit;"
}

cmd_export_md() {
  require_sqlite3
  local db status count rows generated
  db=$(db_path_or_die)
  generated=$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || printf 'unknown')
  printf '# cxq board\n\n'
  printf 'Generated: %s\n\n' "$generated"
  for status in inbox ready claimed blocked review "done" wontfix; do
    count=$(sqlite_value "$db" "SELECT COUNT(*) FROM tasks WHERE status = '$status';")
    printf '## %s (%s)\n\n' "$status" "$count"
    rows=$(sqlite_query "$db" "SELECT '- #' || id || ' **' || replace(title, '*', '') || '** [P' || priority || ']' || CASE WHEN due_date IS NOT NULL THEN ' (due ' || due_date || ')' ELSE '' END || CASE WHEN claimed_by IS NOT NULL AND claimed_by <> '' THEN ' -- ' || claimed_by ELSE '' END FROM tasks WHERE status = '$status' ORDER BY priority DESC, created_at ASC;")
    if [ -n "$rows" ]; then
      printf '%s\n\n' "$rows"
    else
      printf '_(empty)_\n\n'
    fi
  done
}

cmd_export() {
  require_sqlite3
  local format="json"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --format) [ "$#" -ge 2 ] || die "--format requires a value."; format=$2; shift 2 ;;
      --help|-h) usage; exit 0 ;;
      *) die "unknown export option: $1" ;;
    esac
  done
  case "$format" in
    json|csv) ;;
    *) die "export format must be json or csv." ;;
  esac
  local db sql
  db=$(db_path_or_die)
  sql="SELECT id, title, body, status, priority, due_date, recurs, branch, allowed_paths_json, tags_json, acceptance, verify_command, claimed_by, claimed_at, lease_until, result_summary, created_at, updated_at FROM tasks ORDER BY id ASC;"
  if [ "$format" = "json" ]; then
    sqlite_run "$db" "$sql" -json
  else
    sqlite_run "$db" "$sql" -header -csv
  fi
}

cmd_watch() {
  require_sqlite3
  local interval="5s" seconds=5
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --interval) [ "$#" -ge 2 ] || die "--interval requires a value."; interval=$2; shift 2 ;;
      --help|-h) usage; exit 0 ;;
      *) die "unknown watch option: $1" ;;
    esac
  done
  case "$interval" in
    *s) seconds=${interval%s} ;;
    *m) seconds=$(( ${interval%m} * 60 )) ;;
    *) die "--interval must look like 5s or 1m." ;;
  esac
  # die must run unless BOTH checks pass.
  # shellcheck disable=SC2015
  [[ "$seconds" =~ ^[0-9]+$ ]] && [ "$seconds" -gt 0 ] || die "--interval must be a positive duration."
  while :; do
    if [ -t 1 ]; then
      printf '\033[2J\033[H'
    fi
    printf 'cxq board -- %s (refresh every %s, Ctrl-C to stop)\n\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || printf 'now')" "$interval"
    cmd_board
    sleep "$seconds"
  done
}

find_server_file() {
  local script_dir candidate
  script_dir=$(cd "$(dirname "$0")" 2>/dev/null && pwd -P || printf '.')
  for candidate in \
    "${CXQ_SERVER_PATH:-}" \
    "$script_dir/../server/cxq_server.py" \
    "$script_dir/../lib/cxq/cxq_server.py" \
    "$HOME/.local/lib/cxq/cxq_server.py" \
    "/usr/local/lib/cxq/cxq_server.py" ; do
    [ -n "$candidate" ] || continue
    [ -f "$candidate" ] && { printf '%s' "$candidate"; return 0; }
  done
  return 1
}

cmd_serve() {
  local port=8080 host="127.0.0.1" db="" generate_token=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --port) [ "$#" -ge 2 ] || die "--port requires a value."; port=$2; shift 2 ;;
      --host) [ "$#" -ge 2 ] || die "--host requires a value."; host=$2; shift 2 ;;
      --db) [ "$#" -ge 2 ] || die "--db requires a value."; db=$2; shift 2 ;;
      --generate-token) generate_token=1; shift ;;
      --help|-h) usage; exit 0 ;;
      *) die "unknown serve option: $1" ;;
    esac
  done
  [[ "$port" =~ ^[0-9]+$ ]] || die "--port must be an integer."
  command -v python3 >/dev/null 2>&1 || die "python3 is required for 'cxq serve'."
  local server
  server=$(find_server_file) || die "cxq server not found (server/cxq_server.py). Reinstall with ./install.sh from the cxq repo."
  if [ -z "$db" ]; then
    if [ -n "${CXQ_DB:-}" ]; then
      db="$CXQ_DB"
    else
      local root
      root=$(git_root 2>/dev/null || true)
      if [ -n "$root" ]; then
        root=$(physical_path "$root")
        migrate_legacy_queue_dir "$root"
        db="$root/.cxq/tasks.db"
      else
        db="$PWD/tasks.db"
      fi
    fi
  fi
  mkdir -p "$(dirname "$db")"
  if [ -z "${CXQ_TOKEN:-}" ]; then
    if [ "$generate_token" -eq 1 ]; then
      CXQ_TOKEN=$(python3 -c 'import secrets; print(secrets.token_urlsafe(32))')
      export CXQ_TOKEN
      printf 'Generated CXQ_TOKEN (shown once — save it, agents need it as CXQ_REMOTE_TOKEN):\n%s\n' "$CXQ_TOKEN" >&2
    else
      die "CXQ_TOKEN is required for 'cxq serve'. Set CXQ_TOKEN or rerun with --generate-token."
    fi
  fi
  printf 'cxq server: http://%s:%s  db: %s\n' "$host" "$port" "$db" >&2
  printf 'Dashboard: open the URL above, paste your CXQ_TOKEN when prompted.\n' >&2
  exec python3 "$server" --host "$host" --port "$port" --db "$db"
}

# --- Per-agent API tokens (server-side registry) ---
# The server accepts Bearer tokens from the `api_tokens` table in the same
# SQLite file it owns, one per agent, in addition to the legacy CXQ_TOKEN.
# These commands manage that table and must run on the server host, where
# the server DB file lives (pass --db PATH, set CXQ_DB, or run inside the
# repo whose queue the server owns). Token values are printed once on
# add/rotate and never stored anywhere else; `list` never prints them.

tokens_table_sql() {
  cat <<'EOF'
CREATE TABLE IF NOT EXISTS api_tokens (
  agent TEXT PRIMARY KEY,
  token TEXT NOT NULL UNIQUE,
  created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
  last_used_at TEXT,
  revoked INTEGER NOT NULL DEFAULT 0 CHECK (revoked IN (0, 1))
);
CREATE INDEX IF NOT EXISTS idx_api_tokens_token ON api_tokens(token);
EOF
}

tokens_ensure_table() {
  sqlite_exec "$1" "$(tokens_table_sql)" >/dev/null
}

tokens_valid_agent() {
  [[ "${1-}" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$ ]]
}

tokens_new_token() {
  python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
}

tokens_usage() {
  cat <<'EOF'
usage:
  cxq tokens list [--db PATH]
  cxq tokens add <agent> [--db PATH]
  cxq tokens revoke <agent> [--db PATH]
  cxq tokens rotate <agent> [--db PATH]

Manage per-agent Bearer tokens for the shared server. The registry lives
in the server's SQLite file (--db PATH, CXQ_DB, or the current repo's
.cxq/tasks.db); run these commands on the server host. Agents use their
token as CXQ_REMOTE_TOKEN. The legacy CXQ_TOKEN keeps working unchanged.
`list` never prints token values; `add` and `rotate` print the new token
once — save it, it cannot be shown again.
EOF
}

cmd_tokens() {
  local action=${1:-}
  shift || true
  local db=""
  local -a args=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --db) [ "$#" -ge 2 ] || die "--db requires a value."; db=$2; shift 2 ;;
      --help|-h) tokens_usage; exit 0 ;;
      *) args+=("$1"); shift ;;
    esac
  done
  case "$action" in
    list|add|revoke|rotate) ;;
    ""|--help|-h) tokens_usage; exit 0 ;;
    *) die "unknown tokens action: $action" ;;
  esac
  if [ -z "$db" ]; then
    if [ -n "${CXQ_DB:-}" ]; then
      db="$CXQ_DB"
    else
      local root
      root=$(project_root_or_die)
      db="$root/.cxq/tasks.db"
    fi
  fi
  [ -f "$db" ] || die "no queue database at $db (run 'cxq tokens' on the server host, or pass --db PATH)."
  command -v python3 >/dev/null 2>&1 || die "python3 is required for 'cxq tokens'."
  require_sqlite3
  tokens_ensure_table "$db"
  local agent token row count
  case "$action" in
    list)
      [ "${#args[@]}" -eq 0 ] || die "usage: cxq tokens list [--db PATH]"
      count=$(sqlite_value "$db" "SELECT COUNT(*) FROM api_tokens;")
      if [ "$count" = "0" ]; then
        printf 'No per-agent tokens yet. Add one with: cxq tokens add <agent>\n'
        return 0
      fi
      sqlite_table "$db" "SELECT agent AS agent, created_at AS created, COALESCE(last_used_at, 'never') AS last_used, CASE revoked WHEN 1 THEN 'revoked' ELSE 'active' END AS status FROM api_tokens ORDER BY agent;"
      ;;
    add)
      [ "${#args[@]}" -eq 1 ] || die "usage: cxq tokens add <agent> [--db PATH]"
      agent=${args[0]}
      tokens_valid_agent "$agent" || die "agent name must be 1-64 characters: letters, digits, '-' or '_'."
      row=$(sqlite_value "$db" "SELECT agent FROM api_tokens WHERE agent = $(sql_quote "$agent");")
      [ -z "$row" ] || die "agent '$agent' already has a token. Use 'cxq tokens rotate $agent' to issue a new one."
      token=$(tokens_new_token)
      sqlite_exec "$db" "INSERT INTO api_tokens (agent, token) VALUES ($(sql_quote "$agent"), $(sql_quote "$token"));" >/dev/null
      printf 'Token for agent %s (shown once — save it; agents use it as CXQ_REMOTE_TOKEN):\n%s\n' "$agent" "$token"
      ;;
    revoke)
      [ "${#args[@]}" -eq 1 ] || die "usage: cxq tokens revoke <agent> [--db PATH]"
      agent=${args[0]}
      row=$(sqlite_value "$db" "SELECT revoked FROM api_tokens WHERE agent = $(sql_quote "$agent");")
      [ -n "$row" ] || die "no token for agent '$agent'."
      [ "$row" = "1" ] && die "token for agent '$agent' is already revoked."
      sqlite_exec "$db" "UPDATE api_tokens SET revoked = 1 WHERE agent = $(sql_quote "$agent");" >/dev/null
      printf 'Revoked token for agent %s.\n' "$agent"
      ;;
    rotate)
      [ "${#args[@]}" -eq 1 ] || die "usage: cxq tokens rotate <agent> [--db PATH]"
      agent=${args[0]}
      row=$(sqlite_value "$db" "SELECT agent FROM api_tokens WHERE agent = $(sql_quote "$agent");")
      [ -n "$row" ] || die "no token for agent '$agent'. Use 'cxq tokens add $agent' first."
      token=$(tokens_new_token)
      sqlite_exec "$db" "UPDATE api_tokens SET token = $(sql_quote "$token"), revoked = 0, last_used_at = NULL WHERE agent = $(sql_quote "$agent");" >/dev/null
      printf 'New token for agent %s (shown once — the old token no longer works):\n%s\n' "$agent" "$token"
      ;;
  esac
}

cmd_remote() {
  local action=${1:-status}
  case "$action" in
    status) shift ;;
    ""|--help|-h) die "usage: cxq remote status" ;;
    *) die "unknown remote action: $action" ;;
  esac
  [ "$#" -eq 0 ] || die "cxq remote status does not accept arguments."
  remote_require_curl
  local url body code
  url="$(remote_base_url)/api/v1/health"
  body=$(curl -sS --max-time 10 "$url" 2>&1) || die "remote is not reachable: $url ($body)"
  printf 'remote_url: %s\n' "$(remote_base_url)"
  printf 'reachable: yes\n'
  printf 'health: %s\n' "$body"
  if [ -n "${CXQ_REMOTE_TOKEN:-}" ]; then
    local stats
    stats=$(remote_api GET "/api/v1/stats" 2>/dev/null || true)
    if [ -n "$stats" ]; then
      printf 'stats: %s\n' "$stats"
    fi
  else
    printf 'authenticated: no (CXQ_REMOTE_TOKEN is not set)\n'
  fi
}

# --- Remote mode (CXQ_REMOTE_URL / CXQ_REMOTE_TOKEN) ---
# The server is the single writer for a shared queue. Agents never point
# sqlite3 at a shared file over NFS/SSHFS; they talk HTTP to cxq serve.

remote_base_url() {
  local u=${CXQ_REMOTE_URL:-}
  u=${u%/}
  printf '%s' "$u"
}

remote_require_curl() {
  command -v curl >/dev/null 2>&1 || die "curl is required for remote mode (CXQ_REMOTE_URL is set)."
}

remote_require_python() {
  command -v python3 >/dev/null 2>&1 || die "python3 is required for remote mode (JSON rendering)."
}

remote_require_token() {
  [ -n "${CXQ_REMOTE_TOKEN:-}" ] || die "CXQ_REMOTE_TOKEN is required when CXQ_REMOTE_URL is set."
}

# remote_api <METHOD> <PATH> [body-file]
# Prints the response body on stdout. Dies on transport failure or non-2xx.
remote_api() {
  local method=$1 path=$2 body_file=${3:-}
  remote_require_curl
  remote_require_token
  local url tmp_out tmp_err code
  url="$(remote_base_url)$path"
  tmp_out=$(mktemp)
  tmp_err=$(mktemp)
  local -a curl_args=(-sS --max-time 30 -w '%{http_code}' -o "$tmp_out" -H "Authorization: Bearer $CXQ_REMOTE_TOKEN" -H "Accept: application/json")
  if [ -n "$body_file" ]; then
    curl_args+=(-H "Content-Type: application/json" --data-binary "@$body_file")
  fi
  code=$(curl "${curl_args[@]}" -X "$method" "$url" 2>"$tmp_err") || {
    local err
    err=$(cat "$tmp_err" 2>/dev/null || true)
    rm -f "$tmp_out" "$tmp_err"
    die "remote request failed: $url (${err:-curl error})"
  }
  case "$code" in
    2*) cat "$tmp_out"; rm -f "$tmp_out" "$tmp_err"; return 0 ;;
    *)
      local msg
      msg=$(python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d.get("error", ""))' "$tmp_out" 2>/dev/null || cat "$tmp_out")
      rm -f "$tmp_out" "$tmp_err"
      die "remote error $code from $url: ${msg:-unknown error}"
      ;;
  esac
}

remote_api_noauth() {
  local path=$1
  remote_require_curl
  curl -sS --max-time 10 "$(remote_base_url)$path"
}

# json_body_file key value [key value ...]
# Values starting with "json:" are parsed as raw JSON (arrays/objects/numbers).
json_body_file() {
  local f
  f=$(mktemp)
  python3 -c '
import json, sys
a = sys.argv[1:]
d = {}
for i in range(0, len(a) - 1, 2):
    v = a[i + 1]
    if v.startswith("json:"):
        d[a[i]] = json.loads(v[5:])
    else:
        d[a[i]] = v
print(json.dumps(d))
' "$@" >"$f"
  printf '%s' "$f"
}

url_quote() {
  python3 -c 'import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1], safe=""))' "$1"
}

# Render a JSON response file as CLI text. Kinds: list, task, board, stats,
# activity, deps, findings, prompt, raw.
remote_render() {
  local kind=$1 file=$2
  remote_require_python
  python3 - "$kind" "$file" <<'PYEOF'
import json, sys
kind, path = sys.argv[1], sys.argv[2]
with open(path) as f:
    data = json.load(f)

def show(v):
    return "" if v is None else str(v)

def task_lines(t):
    print("# Task #%s" % t.get("id"))
    print()
    print("## Title\n%s\n" % show(t.get("title")))
    print("## Status\n%s\n" % show(t.get("status")))
    print("## Priority\n%s\n" % show(t.get("priority")))
    if t.get("due_date"):
        print("## Due date\n%s\n" % t["due_date"])
    else:
        print("## Due date\nNone\n")
    if t.get("recurs"):
        print("## Recurrence\n%s\n" % t["recurs"])
    else:
        print("## Recurrence\nNone\n")
    print("## Body\n%s\n" % (show(t.get("body")) or "None"))
    print("## Allowed paths")
    for p in t.get("allowed_paths") or []:
        print("- %s" % p)
    if not t.get("allowed_paths"):
        print("None")
    print()
    print("## Tags")
    for p in t.get("tags") or []:
        print("- %s" % p)
    if not t.get("tags"):
        print("None")
    print()
    if t.get("acceptance"):
        print("## Acceptance criteria\n%s\n" % t["acceptance"])
    if t.get("verify_command"):
        print("## Verification command\n%s\n" % t["verify_command"])
    if t.get("claimed_by") or t.get("lease_until"):
        print("## Claim")
        if t.get("claimed_by"):
            print("Claimed by: %s" % t["claimed_by"])
        if t.get("claimed_at"):
            print("Claimed at: %s" % t["claimed_at"])
        if t.get("lease_until"):
            print("Lease until: %s" % t["lease_until"])
        print()
    if t.get("result_summary"):
        print("## Result summary\n%s\n" % t["result_summary"])
    events = t.get("events") or []
    print("## Recent events")
    for e in events[-10:]:
        note = (": " + e.get("note", "")) if e.get("note") else ""
        print("- %s `%s` by %s%s" % (e.get("created_at", ""), e.get("event_type", ""), e.get("actor", ""), note))
    if not events:
        print("None")
    print()
    print("## Edit history")
    edits = [e for e in events if e.get("event_type") == "edited"]
    for e in edits:
        print("- %s by %s: %s" % (e.get("created_at", ""), e.get("actor", ""), e.get("note", "")))
    if not edits:
        print("None")
    print()

if kind == "list":
    tasks = data.get("tasks", [data] if isinstance(data, dict) and "id" in data else data if isinstance(data, list) else [])
    print("%-4s %-8s %-8s %s" % ("id", "status", "priority", "title"))
    print("%-4s %-8s %-8s %s" % ("--", "------", "--------", "-" * 40))
    for t in tasks:
        print("%-4s %-8s %-8s %s" % (t.get("id"), t.get("status"), t.get("priority"), t.get("title")))
elif kind == "list_md":
    tasks = data.get("tasks", data if isinstance(data, list) else [])
    print("| id | status | priority | title |")
    print("| --- | --- | --- | --- |")
    for t in tasks:
        print("| %s | %s | %s | %s |" % (t.get("id"), t.get("status"), t.get("priority"), t.get("title")))
elif kind == "due" or kind == "due_md":
    for heading, key in (("Overdue:", "overdue"), ("Due today:", "today"), ("Due tomorrow:", "tomorrow")):
        print(heading)
        tasks = data.get(key, [])
        if not tasks:
            print("(none)")
        elif kind == "due_md":
            print("| id | status | priority | title | due_date |")
            print("| --- | --- | --- | --- | --- |")
            for t in tasks:
                print("| %s | %s | %s | %s | %s |" % (t.get("id"), t.get("status"), t.get("priority"), t.get("title"), t.get("due_date")))
        else:
            print("%-4s %-8s %-8s %-40s %s" % ("id", "status", "priority", "title", "due_date"))
            print("%-4s %-8s %-8s %-40s %s" % ("--", "------", "--------", "-" * 40, "----------"))
            for t in tasks:
                print("%-4s %-8s %-8s %-40s %s" % (t.get("id"), t.get("status"), t.get("priority"), t.get("title"), t.get("due_date")))
        print()
elif kind == "task":
    task_lines(data.get("task", data))
elif kind == "board":
    columns = data.get("columns", {})
    for status in ["inbox", "ready", "claimed", "blocked", "review", "done", "wontfix"]:
        tasks = columns.get(status, [])
        print("## %s (%d)" % (status, len(tasks)))
        if not tasks:
            print("(empty)")
        for t in tasks:
            line = "# %s [P%s] %s" % (t.get("id"), t.get("priority"), t.get("title"))
            if t.get("due_date"):
                line += " due %s" % t["due_date"]
                if t.get("overdue"):
                    line += " OVERDUE"
            if t.get("lease_expired"):
                line += " LEASE EXPIRED"
            if t.get("claimed_by"):
                line += " -- %s" % t["claimed_by"]
            print(line)
        print()
elif kind == "stats":
    print("tasks_total: %s" % data.get("tasks_total"))
    for status in ["inbox", "ready", "claimed", "blocked", "review", "done", "wontfix"]:
        print("status_%s: %s" % (status, (data.get("by_status") or {}).get(status, 0)))
    print("overdue: %s" % data.get("overdue"))
    print("stale_reviews: %s" % data.get("stale_reviews"))
    print("oldest_ready: %s" % (data.get("oldest_ready") or "none"))
    print("done_last_7d: %s" % data.get("done_last_7d"))
    print("top_blockers:")
    for b in data.get("top_blockers") or []:
        print("- #%s %s blocks %s task(s)" % (b.get("id"), b.get("title"), b.get("blocks")))
    if not data.get("top_blockers"):
        print("none")
elif kind == "activity":
    for e in data.get("events", []):
        print("%s  #%s  %s  by %s  %s" % (e.get("created_at"), e.get("task_id"), e.get("event_type"), e.get("actor"), e.get("note", "")))
elif kind == "trash":
    tasks = data.get("tasks", [])
    print("# cxq trash\n")
    if not tasks:
        print("(empty)")
    else:
        print("%-4s %-8s %-40s %-10s %s" % ("id", "priority", "title", "from", "trashed_at"))
        for t in tasks:
            print("%-4s %-8s %-40s %-10s %s" % (t.get("id"), t.get("priority"), (t.get("title") or "")[:40], show(t.get("trashed_from_status")), show(t.get("trashed_at"))))
elif kind == "deps":
    print("# Dependencies")
    print("Blocked by:")
    for t in data.get("blocked_by", []):
        print("- #%s [%s] %s" % (t.get("id"), t.get("status"), t.get("title")))
    if not data.get("blocked_by"):
        print("None")
    print("Blocks:")
    for t in data.get("blocks", []):
        print("- #%s [%s] %s" % (t.get("id"), t.get("status"), t.get("title")))
    if not data.get("blocks"):
        print("None")
elif kind == "findings":
    for f in data.get("findings", []):
        print("%s  %s/%s  %s" % (f.get("id"), f.get("severity"), f.get("status"), f.get("note")))
elif kind == "prompt":
    print(data.get("prompt", ""))
else:
    print(json.dumps(data, indent=2))
PYEOF
}

remote_task_id_from_body() {
  remote_require_python
  python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("id", ""))' "$1"
}

# Dispatch a CLI command to the remote server. $1 is the command name.
cmd_remote_dispatch() {
  local command=$1
  shift
  remote_require_curl
  remote_require_token
  local body_file="" resp_file
  resp_file=$(mktemp)
  case "$command" in
    add)
      local title="" priority=50 status="ready" body="" files="" tags="" acceptance="" verify="" due="" recurs="" branch=""
      local -a body_args=()
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --priority) priority=$2; shift 2 ;;
          --status) status=$2; shift 2 ;;
          --body) body=$2; shift 2 ;;
          --files|--allowed-paths) files=$2; shift 2 ;;
          --tag) tags="${tags}${tags:+,}$2"; shift 2 ;;
          --acceptance) acceptance=$2; shift 2 ;;
          --verify|--verify-command) verify=$2; shift 2 ;;
          --due) due=$2; shift 2 ;;
          --recurs) recurs=$2; shift 2 ;;
          --branch) branch=$2; shift 2 ;;
          --help|-h) usage; exit 0 ;;
          --*) die "unknown add option: $1" ;;
          *) if [ -z "$title" ]; then title=$1; else body="${body}${body:+ }$1"; fi; shift ;;
        esac
      done
      [ -n "$title" ] || die "task title is required."
      body_args=(title "$title" priority "json:$priority" status "$status")
      [ -n "$body" ] && body_args+=(body "$body")
      [ -n "$files" ] && body_args+=(allowed_paths "json:$(csv_to_json_array "$files")")
      [ -n "$tags" ] && body_args+=(tags "json:$(csv_to_json_array "$tags")")
      [ -n "$acceptance" ] && body_args+=(acceptance "$acceptance")
      [ -n "$verify" ] && body_args+=(verify_command "$verify")
      [ -n "$due" ] && body_args+=(due_date "$due")
      [ -n "$recurs" ] && body_args+=(recurs "$recurs")
      [ -n "$branch" ] && body_args+=(branch "$branch")
      body_file=$(json_body_file "${body_args[@]}")
      remote_api POST "/api/v1/tasks" "$body_file" >"$resp_file"
      printf 'Created task #%s\n' "$(remote_task_id_from_body "$resp_file")"
      ;;
    list|ls)
      local include_all=0 status="" view="" tag="" agent="" pmin="" search="" overdue=0 due_before="" format="table"
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --all) include_all=1; shift ;;
          --needs-action|--questions) view=$1; shift ;;
          --status) status=$2; shift 2 ;;
          --tag) tag=$2; shift 2 ;;
          --agent) agent=$2; shift 2 ;;
          --priority-min) pmin=$2; shift 2 ;;
          --search) search=$2; shift 2 ;;
          --overdue) overdue=1; shift ;;
          --due-before) due_before=$2; shift 2 ;;
          --format) format=$2; shift 2 ;;
          --help|-h) usage; exit 0 ;;
          *) die "unknown list option: $1" ;;
        esac
      done
      local query="?"
      [ -n "$status" ] && query="${query}status=$(url_quote "$status")&"
      [ -n "$tag" ] && query="${query}tag=$(url_quote "$tag")&"
      [ -n "$agent" ] && query="${query}agent=$(url_quote "$agent")&"
      [ -n "$pmin" ] && query="${query}priority_min=$pmin&"
      [ -n "$search" ] && query="${query}search=$(url_quote "$search")&"
      [ "$overdue" -eq 1 ] && query="${query}overdue=1&"
      [ -n "$due_before" ] && query="${query}due_before=$(url_quote "$due_before")&"
      [ "$include_all" -eq 1 ] && query="${query}all=1&"
      [ -n "$view" ] && query="${query}view=${view#--}&"
      remote_api GET "/api/v1/tasks${query}" >"$resp_file"
      case "$format" in
        json) cat "$resp_file"; printf '\n' ;;
        md) remote_render list_md "$resp_file" ;;
        table) remote_render list "$resp_file" ;;
        *) die "invalid format: $format" ;;
      esac
      ;;
    due)
      local format="table"
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --format) format=$2; shift 2 ;;
          --help|-h) usage; exit 0 ;;
          *) die "unknown due option: $1" ;;
        esac
      done
      case "$format" in
        json|table|md) ;;
        *) die "invalid format: $format" ;;
      esac
      remote_api GET "/api/v1/due" >"$resp_file"
      case "$format" in
        json) cat "$resp_file"; printf '\n' ;;
        md) remote_render due_md "$resp_file" ;;
        table) remote_render due "$resp_file" ;;
      esac
      ;;
    digest)
      local format="table"
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --format) format=$2; shift 2 ;;
          --help|-h) usage; exit 0 ;;
          *) die "unknown digest option: $1" ;;
        esac
      done
      case "$format" in
        json|table|md) ;;
        *) die "invalid format: $format" ;;
      esac
      remote_api GET "/api/v1/digest" >"$resp_file"
      case "$format" in
        json) cat "$resp_file"; printf '\n' ;;
        md|table)
          local oc tc mc
          oc=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("overdue_count", 0))' "$resp_file")
          tc=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("today_count", 0))' "$resp_file")
          mc=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("tomorrow_count", 0))' "$resp_file")
          local ddate
          ddate=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("date", ""))' "$resp_file")
          printf '# cxq digest — %s\n\n' "$ddate"
          printf 'Overdue: %s | Due today: %s | Due tomorrow: %s\n\n' "$oc" "$tc" "$mc"
          if [ "$oc" = "0" ] && [ "$tc" = "0" ] && [ "$mc" = "0" ]; then
            printf 'All clear — nothing overdue or due in the next 2 days.\n'
          elif [ "$format" = "md" ]; then
            remote_render due_md "$resp_file"
          else
            remote_render due "$resp_file"
          fi
          ;;
      esac
      ;;
    next)
      local format="text"
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --format) format=$2; shift 2 ;;
          --help|-h) usage; exit 0 ;;
          *) die "unknown next option: $1" ;;
        esac
      done
      remote_api GET "/api/v1/next" >"$resp_file" || die "No ready tasks."
      case "$format" in
        id) remote_task_id_from_body "$resp_file"; printf '\n' ;;
        md) remote_render task "$resp_file" ;;
        text) remote_render list "$resp_file" ;;
        *) die "invalid format: $format" ;;
      esac
      ;;
    show)
      [ "$#" -eq 1 ] || die "usage: cxq show <id>"
      require_task_id "$1"
      remote_api GET "/api/v1/tasks/$1" >"$resp_file"
      remote_render task "$resp_file"
      ;;
    prompt)
      [ "$#" -eq 1 ] || die "usage: cxq prompt <id>"
      require_task_id "$1"
      remote_api GET "/api/v1/tasks/$1/prompt" >"$resp_file"
      remote_render prompt "$resp_file"
      ;;
    claim)
      [ "$#" -ge 1 ] || die "task id is required."
      local id=$1 agent="agent" lease="2h"
      require_task_id "$id"; shift
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --agent) agent=$2; shift 2 ;;
          --lease) lease=$2; shift 2 ;;
          *) die "unknown claim option: $1" ;;
        esac
      done
      body_file=$(json_body_file agent "$agent" lease "$lease")
      remote_api POST "/api/v1/tasks/$id/claim" "$body_file" >"$resp_file"
      printf 'Claimed task #%s as %s\n' "$id" "$agent"
      ;;
    claim-next)
      local agent="agent" lease="2h" format="id"
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --agent) agent=$2; shift 2 ;;
          --lease) lease=$2; shift 2 ;;
          --format) format=$2; shift 2 ;;
          *) die "unknown claim-next option: $1" ;;
        esac
      done
      body_file=$(json_body_file agent "$agent" lease "$lease")
      remote_api POST "/api/v1/claim-next" "$body_file" >"$resp_file"
      case "$format" in
        id) remote_task_id_from_body "$resp_file"; printf '\n' ;;
        md|prompt) remote_render task "$resp_file" ;;
        *) die "invalid format: $format" ;;
      esac
      ;;
    note)
      [ "$#" -ge 2 ] || die "usage: cxq note <id> <note>"
      local id=$1; require_task_id "$id"; shift
      body_file=$(json_body_file note "$*")
      remote_api POST "/api/v1/tasks/$id/note" "$body_file" >"$resp_file"
      printf 'Noted task #%s\n' "$id"
      ;;
    review)
      [ "$#" -ge 1 ] || die "task id is required."
      local id=$1 summary=""; require_task_id "$id"; shift
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --summary) summary=$2; shift 2 ;;
          *) summary="${summary}${summary:+ }$1"; shift ;;
        esac
      done
      [ -n "$summary" ] || die "review summary is required."
      body_file=$(json_body_file summary "$summary")
      remote_api POST "/api/v1/tasks/$id/review" "$body_file" >"$resp_file"
      printf 'Moved task #%s to review\n' "$id"
      ;;
    done)
      [ "$#" -ge 1 ] || die "task id is required."
      local id=$1 summary="" force=0; require_task_id "$id"; shift
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --summary) summary=$2; shift 2 ;;
          --force|--yes) force=1; shift ;;
          *) summary="${summary}${summary:+ }$1"; shift ;;
        esac
      done
      body_file=$(json_body_file summary "$summary" force "json:$force")
      remote_api POST "/api/v1/tasks/$id/done" "$body_file" >"$resp_file"
      printf 'Marked task #%s done\n' "$id"
      local next_id next_due
      next_id=$(python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d.get("next_occurrence_id") or "")' "$resp_file" 2>/dev/null || true)
      if [ -n "$next_id" ]; then
        next_due=$(python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d.get("next_occurrence_due") or "")' "$resp_file" 2>/dev/null || true)
        printf 'Created next occurrence #%s (due %s)\n' "$next_id" "$next_due"
      fi
      ;;
    reopen)
      [ "$#" -ge 1 ] || die "usage: cxq reopen <id> [--to ...] --reason <reason>"
      local id=$1 target="ready" reason=""; require_task_id "$id"; shift
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --to) target=$2; shift 2 ;;
          --reason) reason=$2; shift 2 ;;
          *) die "unknown reopen option: $1" ;;
        esac
      done
      [ -n "$reason" ] || die "reopen reason is required."
      body_file=$(json_body_file to "$target" reason "$reason")
      remote_api POST "/api/v1/tasks/$id/reopen" "$body_file" >"$resp_file"
      printf 'Reopened task #%s\n' "$id"
      ;;
    release)
      [ "$#" -eq 1 ] || die "usage: cxq release <id>"
      require_task_id "$1"
      body_file=$(json_body_file)
      remote_api POST "/api/v1/tasks/$1/release" "$body_file" >"$resp_file"
      printf 'Released task #%s\n' "$1"
      ;;
    edit)
      [ "$#" -ge 1 ] || die "usage: cxq edit <id> [--title ...] [...]"
      local id=$1; require_task_id "$id"; shift
      local -a body_args=()
      local have_flag=0
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --title) body_args+=(title "$2"); have_flag=1; shift 2 ;;
          --body) body_args+=(body "$2"); have_flag=1; shift 2 ;;
          --priority) body_args+=(priority "json:$2"); have_flag=1; shift 2 ;;
          --status) body_args+=(status "$2"); have_flag=1; shift 2 ;;
          --acceptance) body_args+=(acceptance "$2"); have_flag=1; shift 2 ;;
          --verify|--verify-command) body_args+=(verify_command "$2"); have_flag=1; shift 2 ;;
          --branch) body_args+=(branch "$2"); have_flag=1; shift 2 ;;
          --due) body_args+=(due_date "$2"); have_flag=1; shift 2 ;;
          --due-clear) body_args+=(due_date "json:null"); have_flag=1; shift ;;
          --recurs)
            if [ "$2" = "none" ]; then body_args+=(recurs "json:null"); else body_args+=(recurs "$2"); fi
            have_flag=1; shift 2 ;;
          --reason) body_args+=(reason "$2"); shift 2 ;;
          --files|--allowed-paths) body_args+=(allowed_paths "json:$(csv_to_json_array "$2")"); have_flag=1; shift 2 ;;
          --files-add) body_args+=(files_add "$2"); have_flag=1; shift 2 ;;
          --files-remove) body_args+=(files_remove "$2"); have_flag=1; shift 2 ;;
          --tags) body_args+=(tags "json:$(csv_to_json_array "$2")"); have_flag=1; shift 2 ;;
          --tags-add) body_args+=(tags_add "$2"); have_flag=1; shift 2 ;;
          --tags-remove) body_args+=(tags_remove "$2"); have_flag=1; shift 2 ;;
          --help|-h) usage; exit 0 ;;
          --*) die "unknown edit option: $1" ;;
          *) die "unknown edit argument: $1" ;;
        esac
      done
      [ "$have_flag" -eq 1 ] || die "cxq edit requires at least one change flag."
      body_file=$(json_body_file "${body_args[@]}")
      remote_api PATCH "/api/v1/tasks/$id" "$body_file" >"$resp_file"
      local diff
      diff=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("diff", ""))' "$resp_file" 2>/dev/null || true)
      printf 'Edited task #%s: %s\n' "$id" "$diff"
      local next_id next_due
      next_id=$(python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d.get("next_occurrence_id") or "")' "$resp_file" 2>/dev/null || true)
      if [ -n "$next_id" ]; then
        next_due=$(python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d.get("next_occurrence_due") or "")' "$resp_file" 2>/dev/null || true)
        printf 'Created next occurrence #%s (due %s)\n' "$next_id" "$next_due"
      fi
      ;;
    delete|remove)
      [ "$#" -ge 1 ] || die "usage: cxq delete <id> [--force]"
      local id=$1 force=0; require_task_id "$id"; shift
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --force|--yes) force=1; shift ;;
          *) die "unknown delete option: $1" ;;
        esac
      done
      remote_api GET "/api/v1/tasks/$id" >"$resp_file"
      local status
      status=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("status",""))' "$resp_file")
      case "$status" in
        inbox|wontfix|done) ;;
        *) [ "$force" -eq 1 ] || die "task $id is $status; only inbox, wontfix, or done tasks can be deleted without --force." ;;
      esac
      if [ "$force" -ne 1 ]; then
        if gate_is_interactive; then
          local answer
          printf 'Move task #%s (%s) to trash? Restore it later with %s. [y/N] ' "$id" "$status" "'cxq restore $id'" >&2
          answer=$(gate_read_answer); printf '\n' >&2
          case "$answer" in y|Y|yes|YES|Yes) ;; *) die "task $id was not deleted." ;; esac
        else
          die "deleting task $id requires --force in non-interactive mode."
        fi
      fi
      remote_api DELETE "/api/v1/tasks/$id?force=1" >"$resp_file"
      local was
      was=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("was",""))' "$resp_file")
      printf 'Trashed task #%s (was %s). Restore with %s.\n' "$id" "$was" "'cxq restore $id'"
      ;;
    restore)
      [ "$#" -eq 1 ] || die "usage: cxq restore <id>"
      require_task_id "$1"
      body_file=$(json_body_file)
      remote_api POST "/api/v1/tasks/$1/restore" "$body_file" >"$resp_file"
      local restored_to
      restored_to=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("restored_to",""))' "$resp_file")
      printf 'Restored task #%s to %s\n' "$1" "$restored_to"
      ;;
    undo)
      [ "$#" -eq 1 ] || die "usage: cxq undo <id>"
      require_task_id "$1"
      body_file=$(json_body_file)
      remote_api POST "/api/v1/tasks/$1/undo" "$body_file" >"$resp_file"
      local reverted
      reverted=$(python3 -c 'import json,sys; print(", ".join(json.load(open(sys.argv[1])).get("reverted", [])))' "$resp_file")
      printf 'Undid last edit of task #%s: %s\n' "$1" "$reverted"
      ;;
    trash)
      if [ "$#" -ge 1 ] && [ "$1" = "purge" ]; then
        shift
        local days=30 all=0
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --days) [ "$#" -ge 2 ] || die "--days requires a value."; days=$2; shift 2 ;;
            --all) all=1; shift ;;
            --help|-h) usage; exit 0 ;;
            *) die "unknown trash purge option: $1" ;;
          esac
        done
        if [ "$all" -eq 1 ]; then
          body_file=$(json_body_file all "json:true")
        else
          [[ "$days" =~ ^[0-9]+$ ]] || die "--days must be a non-negative integer."
          body_file=$(json_body_file days "json:$days")
        fi
        remote_api POST "/api/v1/trash/purge" "$body_file" >"$resp_file"
        local purged
        purged=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("purged", 0))' "$resp_file")
        printf 'Purged %s trashed task(s)\n' "$purged"
      elif [ "$#" -eq 0 ]; then
        remote_api GET "/api/v1/trash" >"$resp_file"
        remote_render trash "$resp_file"
      else
        die "unknown trash command: $1 (see 'cxq trash purge')"
      fi
      ;;
    board)
      remote_api GET "/api/v1/board" >"$resp_file"
      remote_render board "$resp_file"
      ;;
    stats)
      remote_api GET "/api/v1/stats" >"$resp_file"
      remote_render stats "$resp_file"
      ;;
    activity)
      local limit=20
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --limit) limit=$2; shift 2 ;;
          *) die "unknown activity option: $1" ;;
        esac
      done
      remote_api GET "/api/v1/activity?limit=$limit" >"$resp_file"
      remote_render activity "$resp_file"
      ;;
    export)
      local format="json"
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --format) format=$2; shift 2 ;;
          *) die "unknown export option: $1" ;;
        esac
      done
      remote_api GET "/api/v1/export?format=$format" >"$resp_file"
      cat "$resp_file"; printf '\n'
      ;;
    export-md)
      remote_api GET "/api/v1/export-md" >"$resp_file"
      cat "$resp_file"
      ;;
    stale)
      remote_api GET "/api/v1/stale" >"$resp_file"
      remote_render list "$resp_file"
      ;;
    block)
      [ "$#" -ge 1 ] || die "usage: cxq block <id> --by <blocker-id>"
      local id=$1 blocker=""; require_task_id "$id"; shift
      while [ "$#" -gt 0 ]; do
        case "$1" in --by) blocker=$2; shift 2 ;; *) die "unknown block option: $1" ;; esac
      done
      [ -n "$blocker" ] || die "blocker task id is required."
      body_file=$(json_body_file blocker_id "json:$blocker")
      remote_api POST "/api/v1/tasks/$id/block" "$body_file" >"$resp_file"
      printf 'Task #%s is blocked by #%s\n' "$id" "$blocker"
      ;;
    unblock)
      [ "$#" -ge 1 ] || die "usage: cxq unblock <id> --by <blocker-id>"
      local id=$1 blocker=""; require_task_id "$id"; shift
      while [ "$#" -gt 0 ]; do
        case "$1" in --by) blocker=$2; shift 2 ;; *) die "unknown unblock option: $1" ;; esac
      done
      [ -n "$blocker" ] || die "blocker task id is required."
      body_file=$(json_body_file blocker_id "json:$blocker")
      remote_api POST "/api/v1/tasks/$id/unblock" "$body_file" >"$resp_file"
      printf 'Task #%s is no longer blocked by #%s\n' "$id" "$blocker"
      ;;
    deps)
      [ "$#" -eq 1 ] || die "usage: cxq deps <id>"
      require_task_id "$1"
      remote_api GET "/api/v1/tasks/$1/deps" >"$resp_file"
      remote_render deps "$resp_file"
      ;;
    finding)
      local action=${1:-}; shift
      case "$action" in
        list)
          [ "$#" -eq 1 ] || die "usage: cxq finding list <id>"
          remote_api GET "/api/v1/tasks/$1/findings" >"$resp_file"
          remote_render findings "$resp_file"
          ;;
        add)
          local id=$1; require_task_id "$id"; shift
          local severity="medium" note="" followup=""
          while [ "$#" -gt 0 ]; do
            case "$1" in
              --severity) severity=$2; shift 2 ;;
              --note) note=$2; shift 2 ;;
              --followup) followup=$2; shift 2 ;;
              *) note="${note}${note:+ }$1"; shift ;;
            esac
          done
          [ -n "$note" ] || die "finding note is required."
          local -a fargs=(severity "$severity" note "$note")
          [ -n "$followup" ] && fargs+=(followup_task_id "json:$followup")
          body_file=$(json_body_file "${fargs[@]}")
          remote_api POST "/api/v1/tasks/$id/findings" "$body_file" >"$resp_file"
          printf 'Added finding to task #%s\n' "$id"
          ;;
        resolve)
          local fid=$1; require_task_id "$fid"; shift
          local fstatus="resolved"
          while [ "$#" -gt 0 ]; do
            case "$1" in --status) fstatus=$2; shift 2 ;; *) die "unknown finding resolve option: $1" ;; esac
          done
          body_file=$(json_body_file status "$fstatus")
          remote_api POST "/api/v1/findings/$fid/resolve" "$body_file" >"$resp_file"
          printf 'Marked finding #%s as %s\n' "$fid" "$fstatus"
          ;;
        *) die "unknown finding action: $action" ;;
      esac
      ;;
    *)
      die "unknown remote command: $command"
      ;;
  esac
  rm -f "$resp_file"
  [ -n "$body_file" ] && rm -f "$body_file"
  return 0
}

cmd_version_set() {
  [ "$#" -eq 1 ] || die "usage: cxq version set X.Y.Z"
  local new_version=$1
  valid_project_version "$new_version" || die "version must be stable SemVer X.Y.Z or X.Y.Z-dev."

  local root old_version
  root=$(source_repo_root_or_die)
  old_version=$(repo_cxq_version "$root")
  write_cxq_version "$root" "$new_version"

  printf 'Updated cxq version: %s -> %s\n' "$old_version" "$new_version"
  printf 'Changed:\n'
  printf '%s\n\n' '- bin/cxq'
  printf 'Next:\n'
  printf '  git add bin/cxq README.md tests/run_tests.sh\n'
  printf '  git commit -m "chore: bump cxq to %s"\n' "$new_version"
}

cmd_version_bump() {
  [ "$#" -eq 1 ] || die "usage: cxq version bump patch|minor|major"
  local part=$1
  local root old_version new_version
  root=$(source_repo_root_or_die)
  old_version=$(repo_cxq_version "$root")
  valid_project_version "$old_version" || die "current CXQ_VERSION is not a supported project version: $old_version"
  new_version=$(bump_version_value "$old_version" "$part")
  cmd_version_set "$new_version"
}

release_notes_path() {
  local version=$1
  printf '/tmp/cxq-release-v%s.md' "$version"
}

tag_exists_local() {
  git rev-parse -q --verify "refs/tags/v$1" >/dev/null
}

tag_exists_remote() {
  local version=$1
  local output
  output=$(GIT_TERMINAL_PROMPT=0 git ls-remote --tags --refs origin "v$version" 2>/dev/null || true)
  [ -n "$output" ]
}

release_verify_version() {
  local root=$1
  local version=$2
  valid_stable_version "$version" || die "release version must be stable SemVer X.Y.Z."
  [ "$(repo_cxq_version "$root")" = "$version" ] || die "CXQ_VERSION does not match requested release version $version."
}

release_warn_dirty() {
  if [ -n "$(git status --porcelain)" ]; then
    printf 'Warning: working tree has uncommitted changes.\n' >&2
  fi
}

release_check_tag_available() {
  local version=$1
  if tag_exists_local "$version"; then
    die "tag v$version already exists locally."
  fi
  if tag_exists_remote "$version"; then
    die "tag v$version already exists on origin."
  fi
}

release_verify_main_ready() {
  local branch upstream counts ahead behind

  branch=$(git branch --show-current)
  [ "$branch" = "main" ] || die "release tags must be created from main."

  upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)
  [ -n "$upstream" ] || die "main must track an upstream before release tagging."
  git rev-parse -q --verify "$upstream" >/dev/null || die "upstream $upstream is not available; fetch before releasing."

  counts=$(git rev-list --left-right --count HEAD..."$upstream")
  # intentional split: $counts is "ahead behind" from git rev-list --count.
  # shellcheck disable=SC2086
  set -- $counts
  ahead=${1:-0}
  behind=${2:-0}

  if [ "$ahead" -gt 0 ] && [ "$behind" -gt 0 ]; then
    die "local main has diverged from $upstream; sync before releasing."
  fi
  if [ "$behind" -gt 0 ]; then
    die "local main is behind $upstream; pull before releasing."
  fi
  if [ "$ahead" -gt 0 ]; then
    die "local main has unpushed commits relative to $upstream; push before releasing."
  fi
}

release_run_tests() {
  local skip_tests=$1
  if [ "$skip_tests" -eq 1 ]; then
    printf 'Skipping tests.\n'
    return
  fi
  bash -n bin/cxq install.sh tests/run_tests.sh
  make test
}

# Highest local stable tag that is strictly below the version being released.
previous_stable_tag() {
  local root=$1
  local version=$2
  local line ref candidate best=""

  while IFS= read -r line; do
    ref=$(trim "$line")
    [ -n "$ref" ] || continue
    candidate=$(stable_semver "$ref" 2>/dev/null || true)
    [ -n "$candidate" ] || continue
    semver_gt "$version" "$candidate" || continue
    if [ -z "$best" ] || semver_gt "$candidate" "$best"; then
      best=$candidate
    fi
  done <<<"$(git -C "$root" tag -l 'v*' 2>/dev/null || true)"

  if [ -n "$best" ]; then
    printf 'v%s' "$best"
  fi
}

release_commit_summary() {
  local root=$1
  local previous=$2
  local range limit=20 total lines

  if [ -n "$previous" ]; then
    range="$previous..HEAD"
  else
    range="HEAD"
  fi

  total=$(git -C "$root" rev-list --no-merges --count "$range" 2>/dev/null || printf '0')
  [[ "$total" =~ ^[0-9]+$ ]] || total=0
  if [ "$total" -eq 0 ]; then
    printf -- '- No commits found for this range.\n'
    return 0
  fi

  lines=$(git -C "$root" log --no-merges --format='- %s' -n "$limit" "$range" 2>/dev/null || true)
  if [ -z "$lines" ]; then
    printf -- '- No commits found for this range.\n'
    return 0
  fi

  printf '%s\n' "$lines"
  if [ "$total" -gt "$limit" ]; then
    printf -- '- ...and %s more commits.\n' "$((total - limit))"
  fi
}

release_prepare_notes() {
  local version=$1
  local root=${2-}
  local notes previous summary intro

  [ -n "$root" ] || root=$(git_root 2>/dev/null || printf '.')
  notes=$(release_notes_path "$version")
  previous=$(previous_stable_tag "$root" "$version")

  if [ -n "$previous" ]; then
    intro="Changes since $previous."
    summary=$(release_commit_summary "$root" "$previous")
  else
    intro="First release draft: no previous stable tag was found."
    summary=$(release_commit_summary "$root" "")
  fi

  cat >"$notes" <<EOF
## cxq v$version

$intro

### Highlights

$summary

### Update

~~~sh
git pull --ff-only origin main
./install.sh
cxq version
cxq update --status
~~~

### Notes

- Review the generated highlights before publishing.
EOF
  printf '%s' "$notes"
}

cmd_release_prepare() {
  local version=$1
  local skip_tests=${2:-0}
  local root notes
  root=$(source_repo_root_or_die)
  release_verify_version "$root" "$version"
  release_warn_dirty
  release_check_tag_available "$version"
  release_run_tests "$skip_tests"
  notes=$(release_prepare_notes "$version" "$root")
  printf 'Prepared release notes:\n'
  printf '  %s\n\n' "$notes"
  printf 'Next:\n'
  printf '  cxq release tag %s\n' "$version"
  printf '  cxq release publish %s\n' "$version"
}

cmd_release_tag() {
  local version=$1
  local skip_tests=${2:-0}
  local dry_run=${3:-0}
  local root
  root=$(source_repo_root_or_die)
  release_verify_version "$root" "$version"
  release_verify_main_ready
  release_check_tag_available "$version"
  release_run_tests "$skip_tests"

  if [ "$dry_run" -eq 1 ]; then
    printf 'Dry run: would create and push tag v%s.\n' "$version"
    return
  fi

  git tag -a "v$version" -m "cxq v$version"
  git push origin "v$version"
  printf 'Tagged and pushed v%s.\n' "$version"
  printf 'Next:\n'
  printf '  cxq release publish %s\n' "$version"
}

cmd_release_publish() {
  local version=$1
  local yes=${2:-0}
  local dry_run=${3:-0}
  local root notes
  root=$(source_repo_root_or_die)
  release_verify_version "$root" "$version"
  notes=$(release_notes_path "$version")

  if [ "$dry_run" -eq 1 ]; then
    printf 'Dry run: would publish GitHub release v%s.\n' "$version"
    return
  fi

  if [ "$yes" -ne 1 ] && ! gate_is_interactive; then
    die "non-interactive release publish requires --yes."
  fi
  command -v gh >/dev/null 2>&1 || die "gh is required to publish releases."
  git rev-parse -q --verify "refs/tags/v$version" >/dev/null || die "tag v$version does not exist locally."
  if [ ! -f "$notes" ]; then
    notes=$(release_prepare_notes "$version" "$root")
  fi
  gh release create "v$version" \
    --repo daniel-aranda/Agents-todo \
    --title "cxq v$version" \
    --notes-file "$notes" \
    --verify-tag \
    --latest
}

cmd_release_workflow() {
  local version=$1
  local yes=${2:-0}
  local skip_tests=${3:-0}
  local dry_run=${4:-0}

  if [ "$dry_run" -eq 1 ]; then
    source_repo_root_or_die >/dev/null
    release_verify_version "$(source_repo_root_or_die)" "$version"
    release_verify_main_ready
    release_check_tag_available "$version"
    printf 'Dry run: would prepare, tag, and publish cxq v%s.\n' "$version"
    return
  fi

  cmd_release_prepare "$version" "$skip_tests"
  cmd_release_tag "$version" 1 0
  if [ "$yes" -ne 1 ] && gate_is_interactive; then
    local answer
    printf 'Publish GitHub release now? [y/N] ' >&2
    answer=$(gate_read_answer)
    printf '\n' >&2
    case "$answer" in
      y|Y|yes|YES|Yes) ;;
      *) printf 'Release tag created. Publish later with: cxq release publish %s\n' "$version"; return 0 ;;
    esac
  elif [ "$yes" -ne 1 ]; then
    die "non-interactive full release requires --yes before publishing."
  fi
  cmd_release_publish "$version" 1 0
}

cmd_release() {
  if [ "$#" -eq 1 ] && [[ "$1" =~ ^[0-9]+$ ]]; then
    cmd_task_release "$@"
    return
  fi

  local action=${1:-}
  local version="" yes=0 skip_tests=0 dry_run=0
  case "$action" in
    prepare|tag|publish)
      shift
      version=${1:-}
      [ -n "$version" ] || die "release version is required."
      shift
      ;;
    "")
      die "usage: cxq release <id>|prepare|tag|publish X.Y.Z"
      ;;
    *)
      version=$action
      shift
      action="all"
      ;;
  esac

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --yes) yes=1; shift ;;
      --skip-tests) skip_tests=1; shift ;;
      --dry-run) dry_run=1; shift ;;
      *) die "unknown release option: $1" ;;
    esac
  done

  valid_stable_version "$version" || die "release version must be stable SemVer X.Y.Z."
  case "$action" in
    prepare) cmd_release_prepare "$version" "$skip_tests" ;;
    tag) cmd_release_tag "$version" "$skip_tests" "$dry_run" ;;
    publish) cmd_release_publish "$version" "$yes" "$dry_run" ;;
    all) cmd_release_workflow "$version" "$yes" "$skip_tests" "$dry_run" ;;
    *) die "unknown release action: $action" ;;
  esac
}

print_update_status() {
  init_state_db
  local latest last required kind reason result since
  latest=$(state_get "latest_version")
  last=$(state_get "last_update_check_at")
  required=$(state_get "update_required")
  kind=$(state_get "update_required_kind")
  reason=$(state_get "update_required_reason")
  result=$(state_get "last_update_check_result")
  since=$(state_get "update_required_since")

  printf 'current_version: %s\n' "$CXQ_VERSION"
  printf 'latest_known_version: %s\n' "${latest:-unknown}"
  if [ -n "$last" ]; then
    printf 'last_update_check_at: %s (%s)\n' "$last" "$(format_epoch "$last")"
  else
    printf 'last_update_check_at: never\n'
  fi
  printf 'update_required: %s\n' "${required:-0}"
  printf 'update_required_kind: %s\n' "${kind:-none}"
  printf 'update_required_reason: %s\n' "${reason:-none}"
  if [ -n "$since" ]; then
    printf 'update_required_since: %s (%s)\n' "$since" "$(format_epoch "$since")"
  fi
  printf 'last_update_check_result: %s\n' "${result:-none}"
}

current_executable_path() {
  local dir base found

  case "$0" in
    */*)
      dir=$(dirname "$0")
      base=$(basename "$0")
      dir=$(physical_path "$dir" 2>/dev/null || printf '%s' "$dir")
      printf '%s/%s' "$dir" "$base"
      ;;
    *)
      found=$(command -v "$0" 2>/dev/null || true)
      printf '%s' "${found:-$0}"
      ;;
  esac
}

cmd_doctor() {
  local selected running git_status sqlite_status
  local install_source install_bin install_remote required kind reason
  local root repo_reason queue_installed

  selected=$(command -v cxq 2>/dev/null || true)
  running=$(current_executable_path)

  if command -v git >/dev/null 2>&1; then
    git_status="ok ($(command -v git))"
  else
    git_status="missing"
  fi

  if command -v sqlite3 >/dev/null 2>&1; then
    sqlite_status="ok ($(command -v sqlite3))"
    init_state_db
    install_source=$(state_get "install_source_dir")
    install_bin=$(state_get "install_bin_path")
    install_remote=$(state_get "install_remote_url")
    required=$(state_get "update_required")
    kind=$(state_get "update_required_kind")
    reason=$(state_get "update_required_reason")
  else
    sqlite_status="missing"
    install_source=""
    install_bin=""
    install_remote=""
    required=""
    kind=""
    reason=""
  fi

  printf '# cxq doctor\n\n'
  printf 'current_version: %s\n' "$CXQ_VERSION"
  printf 'running_script: %s\n' "${running:-unknown}"
  printf 'selected_binary: %s\n' "${selected:-not found on PATH}"
  printf 'git: %s\n' "$git_status"
  printf 'sqlite3: %s\n' "$sqlite_status"
  printf 'install_source_dir: %s\n' "${install_source:-unknown}"
  printf 'install_bin_path: %s\n' "${install_bin:-unknown}"
  printf 'install_remote_url: %s\n' "${install_remote:-unknown}"
  if [ -n "${CXQ_REMOTE_URL:-}" ]; then
    printf 'remote_mode: yes\n'
    printf 'remote_url: %s\n' "$CXQ_REMOTE_URL"
  else
    printf 'remote_mode: no\n'
  fi
  printf 'update_required: %s\n' "${required:-0}"
  printf 'update_required_kind: %s\n' "${kind:-none}"
  printf 'update_required_reason: %s\n' "${reason:-none}"

  root=$(git_root 2>/dev/null || true)
  if [ -z "$root" ]; then
    printf 'git_repo: no\n'
    return 0
  fi

  root=$(physical_path "$root")
  printf 'git_repo: %s\n' "$root"

  if [ -f "$root/.cxq/tasks.db" ]; then
    queue_installed="yes"
  else
    queue_installed="no"
  fi
  printf 'repo_queue_installed: %s\n' "$queue_installed"

  if command -v sqlite3 >/dev/null 2>&1; then
    repo_reason=$(repo_update_reason "$root" || true)
    if [ -n "$repo_reason" ]; then
      printf 'repo_update_required: yes\n'
      printf 'repo_update_reason: %s\n' "$repo_reason"
    else
      printf 'repo_update_required: no\n'
    fi
    doctor_report_repo_db "$root/.cxq/tasks.db"
  else
    printf 'repo_update_required: unknown\n'
    printf 'repo_update_reason: sqlite3 missing\n'
    printf 'repo_db: unknown\n'
  fi
}

# Read-only diagnostics for the project queue database.
doctor_report_repo_db() {
  local db=$1
  local schema counts integrity tasks

  if [ ! -f "$db" ]; then
    printf 'repo_db: none\n'
    printf 'repo_schema_version: none\n'
    printf 'repo_task_counts: none\n'
    printf 'repo_db_integrity: none\n'
    return 0
  fi

  printf 'repo_db: %s\n' "$db"

  schema=$(sqlite_value "$db" "SELECT value FROM cxq_meta WHERE key = 'schema_version';" 2>/dev/null || true)
  printf 'repo_schema_version: %s (expected %s)\n' "${schema:-unknown}" "$CXQ_REPO_SCHEMA_VERSION"

  tasks=$(sqlite_value "$db" "SELECT COUNT(*) FROM tasks;" 2>/dev/null || true)
  counts=$(sqlite_query "$db" "SELECT group_concat(status || '=' || n, ' ') FROM (SELECT status, COUNT(*) AS n FROM tasks GROUP BY status ORDER BY status);" 2>/dev/null || true)
  printf 'repo_task_total: %s\n' "${tasks:-unknown}"
  printf 'repo_task_counts: %s\n' "${counts:-none}"

  integrity=$(sqlite_query "$db" "PRAGMA integrity_check;" 2>/dev/null || true)
  if [ "$integrity" = "ok" ]; then
    printf 'repo_db_integrity: ok\n'
  else
    printf 'repo_db_integrity: %s\n' "${integrity:-unknown}"
  fi
}

cmd_update_check() {
  run_remote_update_check || true
  printf '%s\n' "$(state_get "last_update_check_result")"
  if [ "$(state_get "update_required")" = "1" ]; then
    printf 'Update required: %s\n' "$(state_get "update_required_reason")"
  else
    printf 'No update required.\n'
  fi
}

update_confirm_modify() {
  local what=$1
  local yes=$2

  if [ "$yes" -eq 1 ]; then
    return 0
  fi
  if gate_is_interactive; then
    local answer
    printf '%s [Y/n] ' "$what" >&2
    answer=$(gate_read_answer)
    printf '\n' >&2
    case "$answer" in
      ""|y|Y|yes|YES|Yes) return 0 ;;
      *) printf 'Update cancelled.\n' >&2; return 1 ;;
    esac
  fi
  printf '%s\n' "$what" >&2
  printf 'Run: cxq update --yes\n' >&2
  return 1
}

cmd_update_self() {
  local yes=${1:-0}
  local source_dir bin_path prefix latest
  source_dir=$(state_get "install_source_dir")
  bin_path=$(state_get "install_bin_path")
  latest=$(state_get "latest_version")

  if [ -z "$source_dir" ] || [ ! -d "$source_dir/.git" ] || [ ! -f "$source_dir/install.sh" ]; then
    printf 'cxq self-update cannot run automatically from this install.\n' >&2
    printf 'Clone or pull the cxq repository manually, then run ./install.sh.\n' >&2
    return 1
  fi

  update_confirm_modify "Update cxq now?" "$yes" || return 1
  printf 'Updating cxq...\n'
  if [ "${CXQ_TEST_SKIP_SELF_UPDATE_GIT:-}" != "1" ]; then
    GIT_TERMINAL_PROMPT=0 git -C "$source_dir" fetch --tags --quiet
    GIT_TERMINAL_PROMPT=0 git -C "$source_dir" pull --ff-only
  fi

  if [ -n "$bin_path" ]; then
    prefix=$(dirname "$(dirname "$bin_path")")
    PREFIX="$prefix" "$source_dir/install.sh"
  else
    "$source_dir/install.sh"
  fi

  state_set "update_required" "0"
  state_set "update_required_kind" ""
  state_set "update_required_reason" ""
  state_set "update_required_since" ""
  printf 'cxq is now up to date: %s\n' "${latest:-${CXQ_VERSION}}"
}

cmd_update_repo() {
  local yes=${1:-0}
  local root reason
  root=$(project_root_or_die)
  reason=$(repo_update_reason "$root" || true)
  if [ -z "$reason" ]; then
    printf 'Repo setup is up to date.\n'
    clear_update_required_if_kind "repo"
    return 0
  fi
  update_confirm_modify "Update repo setup now?" "$yes" || return 1
  setup_project_queue "$root"
  reason=$(repo_update_reason "$root" || true)
  if [ -n "$reason" ]; then
    mark_update_required "repo" "Project queue update required: $reason"
    printf 'Repo update is still required: %s\n' "$reason" >&2
    return 1
  fi
  clear_update_required_if_kind "repo"
  printf 'Repo setup is up to date.\n'
}

cmd_update_all() {
  local yes=${1:-0}
  local force_check=${2:-1}
  local kind repo_reason ran=0 latest
  detect_repo_update_required
  if [ "$(state_get "update_required_kind")" != "self" ] && { [ "$force_check" -eq 1 ] || remote_check_due; }; then
    run_remote_update_check || true
  fi
  kind=$(state_get "update_required_kind")
  latest=$(state_get "latest_version")
  repo_reason=$(repo_update_reason "$(git_root 2>/dev/null || true)" 2>/dev/null || true)

  if [ "$(state_get "update_required")" = "1" ] && [ "$kind" = "self" ]; then
    printf 'Update available: %s\n' "${latest:-unknown}"
    cmd_update_self "$yes"
    ran=1
  fi

  if [ -n "$repo_reason" ] || { [ "$(state_get "update_required")" = "1" ] && [ "$(state_get "update_required_kind")" = "repo" ]; }; then
    cmd_update_repo "$yes"
    ran=1
  fi

  if [ "$ran" -eq 0 ]; then
    printf 'cxq is up to date: %s\n' "$CXQ_VERSION"
  fi

  if [ "$(state_get "update_required")" = "1" ]; then
    printf 'Update is still required: %s\n' "$(state_get "update_required_reason")" >&2
    return 1
  fi
}

cmd_update() {
  require_sqlite3

  local action="" yes=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --status|--check|--self|--repo|--all)
        [ -z "$action" ] || die "choose only one update action."
        action=$1
        shift
        ;;
      --yes)
        yes=1
        shift
        ;;
      --help|-h)
        cat <<'EOF'
Usage:
  cxq update [--yes]
  cxq update --status
  cxq update --check
  cxq update --self [--yes]
  cxq update --repo [--yes]
  cxq update --all [--yes]
EOF
        exit 0
        ;;
      *)
        die "unknown update option: $1"
        ;;
    esac
  done

  case "${action:-}" in
    --status) print_update_status ;;
    --check) cmd_update_check ;;
    --self) cmd_update_self "$yes" ;;
    --repo) cmd_update_repo "$yes" ;;
    ""|--all) cmd_update_all "$yes" 1 ;;
    *) die "unknown update action: $action" ;;
  esac
}

command_uses_update_gate() {
  case "${1:-}" in
    add|list|ls|next|show|claim|claim-next|block|deps|unblock|note|prompt|review|done|repo|stale) return 0 ;;
    edit|delete|remove|restore|undo|trash|board|stats|activity|export|export-md|watch) return 0 ;;
    reopen|followup|split|finding|review-stale) return 0 ;;
    *) return 1 ;;
  esac
}

gate_is_interactive() {
  if [ -n "${CXQ_TEST_TTY_ANSWER:-}" ]; then
    return 0
  fi
  [ -t 0 ] && [ -t 2 ]
}

gate_read_answer() {
  if [ -n "${CXQ_TEST_TTY_ANSWER:-}" ]; then
    printf '%s' "$CXQ_TEST_TTY_ANSWER"
    return 0
  fi
  local answer
  IFS= read -r answer </dev/tty || answer=""
  printf '%s' "$answer"
}

run_update_and_rerun() {
  if ! CXQ_UPDATE_GATE_RERUN=1 "$0" update --yes; then
    printf 'Update failed. Command not run.\n' >&2
    return 1
  fi

  if [ "$(state_get "update_required")" = "1" ]; then
    printf '[update-required] cxq still needs an update before continuing.\n' >&2
    printf 'Run: cxq update --yes\n' >&2
    return 90
  fi

  CXQ_UPDATE_GATE_RERUN=1 exec "$0" "$@"
}

handle_update_required_gate() {
  local original_command="$*"
  local latest reason
  latest=$(state_get "latest_version")
  reason=$(state_get "update_required_reason")

  if [ "${CXQ_UPDATE_GATE_RERUN:-}" = "1" ]; then
    printf '[update-required] cxq needs an update before continuing.\n' >&2
    printf 'Run: cxq update --yes\n' >&2
    printf 'Then retry the original command.\n' >&2
    return 90
  fi

  if [ "${CXQ_ASSUME_YES:-}" = "1" ]; then
    run_update_and_rerun "$@"
    return $?
  fi

  if gate_is_interactive; then
    local answer
    {
      printf 'cxq update required.\n'
      printf 'Installed version: %s\n' "$CXQ_VERSION"
      [ -n "$latest" ] && printf 'Latest version: %s\n' "$latest"
      printf 'Reason: %s\n' "${reason:-update required}"
      printf 'Command: cxq %s\n' "$original_command"
      printf 'Run update now? [Y/n] '
    } >&2
    answer=$(gate_read_answer)
    printf '\n' >&2
    case "$answer" in
      ""|y|Y|yes|YES|Yes)
        run_update_and_rerun "$@"
        return $?
        ;;
      *)
        printf 'Command not run.\n' >&2
        printf 'Run: cxq update --yes\n' >&2
        return 1
        ;;
    esac
  fi

  printf '[update-required] cxq needs an update before continuing.\n' >&2
  printf 'Run: cxq update --yes\n' >&2
  printf 'Then retry the original command.\n' >&2
  return 90
}

run_update_gate() {
  [ "${CXQ_NO_UPDATE_CHECK:-}" = "1" ] && return 0
  # Remote mode has no local queue to update; the server owns the schema.
  [ -n "${CXQ_REMOTE_URL:-}" ] && return 0

  init_state_db
  detect_repo_update_required

  if [ "$(state_get "update_required")" != "1" ]; then
    if remote_check_due; then
      run_remote_update_check || true
    fi
  fi

  if [ "$(state_get "update_required")" = "1" ]; then
    handle_update_required_gate "$@"
    return $?
  fi
}

main() {
  local command=${1:-help}
  if [ "$command" = "migrate" ]; then
    export CXQ_SKIP_AUTO_MIGRATE=1
  fi
  if command_uses_update_gate "$command"; then
    run_update_gate "$@"
  fi

  # Remote mode: the server owns the queue; route read/write commands over HTTP.
  if [ -n "${CXQ_REMOTE_URL:-}" ]; then
    case "$command" in
      add|list|ls|next|show|claim|claim-next|block|deps|unblock|note|prompt|review|done|reopen|release|edit|delete|remove|restore|undo|trash|board|stats|activity|export|export-md|stale|finding|due|digest)
        shift
        cmd_remote_dispatch "$command" "$@"
        return $?
        ;;
    esac
  fi

  case "$command" in
    -v|--version)
      version
      ;;
    version)
      shift
      cmd_version "$@"
      ;;
    --check)
      shift
      [ "$#" -eq 0 ] || die "--check does not accept arguments."
      cmd_update --check
      ;;
    --status)
      shift
      [ "$#" -eq 0 ] || die "--status does not accept arguments."
      cmd_update --status
      ;;
    help|-h|--help)
      usage
      ;;
    install)
      shift
      [ "$#" -eq 0 ] || die "install does not accept arguments."
      cmd_install
      ;;
    update)
      shift
      cmd_update "$@"
      ;;
    doctor)
      shift
      [ "$#" -eq 0 ] || die "doctor does not accept arguments."
      cmd_doctor
      ;;
    add)
      shift
      cmd_add "$@"
      ;;
    list|ls)
      shift
      cmd_list "$@"
      ;;
    due)
      shift
      cmd_due "$@"
      ;;
    digest)
      shift
      cmd_digest "$@"
      ;;
    next)
      shift
      cmd_next "$@"
      ;;
    show)
      shift
      cmd_show "$@"
      ;;
    claim)
      shift
      cmd_claim "$@"
      ;;
    claim-next)
      shift
      cmd_claim_next "$@"
      ;;
    block)
      shift
      cmd_block "$@"
      ;;
    deps)
      shift
      cmd_deps "$@"
      ;;
    unblock)
      shift
      cmd_unblock "$@"
      ;;
    note)
      shift
      cmd_note "$@"
      ;;
    prompt)
      shift
      cmd_prompt "$@"
      ;;
    review)
      shift
      cmd_review "$@"
      ;;
    done)
      shift
      cmd_done "$@"
      ;;
    repo)
      shift
      cmd_repo "$@"
      ;;
    stale)
      shift
      [ "$#" -eq 0 ] || die "stale does not accept arguments."
      cmd_stale
      ;;
    edit)
      shift
      cmd_edit "$@"
      ;;
    delete|remove)
      shift
      cmd_delete "$@"
      ;;
    restore)
      shift
      cmd_restore "$@"
      ;;
    undo)
      shift
      cmd_undo "$@"
      ;;
    trash)
      shift
      cmd_trash "$@"
      ;;
    board)
      shift
      [ "$#" -eq 0 ] || die "board does not accept arguments."
      cmd_board
      ;;
    stats)
      shift
      [ "$#" -eq 0 ] || die "stats does not accept arguments."
      cmd_stats
      ;;
    activity)
      shift
      cmd_activity "$@"
      ;;
    export-md)
      shift
      [ "$#" -eq 0 ] || die "export-md does not accept arguments."
      cmd_export_md
      ;;
    export)
      shift
      cmd_export "$@"
      ;;
    watch)
      shift
      cmd_watch "$@"
      ;;
    migrate)
      shift
      cmd_migrate "$@"
      ;;
    serve)
      shift
      cmd_serve "$@"
      ;;
    tokens)
      shift
      cmd_tokens "$@"
      ;;
    remote)
      shift
      cmd_remote "$@"
      ;;
    reopen)
      shift
      cmd_reopen "$@"
      ;;
    followup|split)
      shift
      cmd_followup "$@"
      ;;
    finding)
      shift
      cmd_finding "$@"
      ;;
    review-stale)
      shift
      cmd_review_stale "$@"
      ;;
    status-transitions)
      shift
      cmd_status_transitions "$@"
      ;;
    release)
      shift
      cmd_release "$@"
      ;;
    *)
      die "unknown command: $command"
      ;;
  esac
}

main "$@"
